# Disable execution of any script files inside the uploads pipeline
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
Options -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|jsp|asp|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Only permit images and safe documents to be accessed statically
<FilesMatch "\.(html|htm|js|css)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>