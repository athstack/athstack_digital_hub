# =============================================================================
# Athstack Digital Hub - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values

# --- Server ---
PORT=3000
NODE_ENV=development
URLROOT=http://localhost:3000
SITENAME=Athstack Digital Hub

# --- Database (MySQL / TiDB) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=athstack_digital_hub
DB_PORT=3306
# DB_SSL=true   # Required for TiDB Cloud, PlanetScale, and most cloud MySQL providers

# --- Session ---
SESSION_SECRET=change_this_to_a_long_random_string

# --- Cloudinary (file uploads) ---
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# --- Email (optional, for future use) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@athstack.com
