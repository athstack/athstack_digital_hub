<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge"><i class="fa-solid fa-envelope me-2"></i><%= t('contact:index.badge') %></span>
            <h1 class="display-4 text-white fw-bold mt-3"><%= t('contact:index.heading') %></h1>
            <p class="text-white-50 fs-5"><%= t('contact:index.intro') %></p>
        </div>

        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashInfo !== 'undefined' && flashInfo && flashInfo.length > 0) { %>
        <div class="alert alert-info alert-dismissible fade show rounded-pill" role="alert" style="background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.2);color:#7DD3FC;">
            <i class="fa-solid fa-circle-info me-2"></i><%= flashInfo %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
            <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-5">
            <div class="col-lg-7">
                <div class="glass-card p-5">
                    <div class="d-flex align-items-center mb-4">
                        <i class="fa-solid fa-paper-plane text-primary fa-2x me-3"></i>
                        <h4 class="text-white fw-bold mb-0"><%= t('contact:index.form.title') %></h4>
                    </div>
                    <form method="POST" action="/contact/send">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.fullName') %> <span class="text-primary">*</span></label>
                                <input type="text" name="name" class="form-control" required placeholder="<%= t('contact:index.form.namePlaceholder') %>" value="<%= user ? user.name || (user.firstName + ' ' + user.lastName) : '' %>" <%= user ? 'readonly style="opacity:0.7;"' : '' %>>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.emailAddress') %> <span class="text-primary">*</span></label>
                                <input type="email" name="email" class="form-control" required placeholder="<%= t('contact:index.form.emailPlaceholder') %>" value="<%= user ? user.email : '' %>" <%= user ? 'readonly style="opacity:0.7;"' : '' %>>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.countryCode') %></label>
                                <select name="country_code" class="form-select" <%= user ? 'style="opacity:0.7;"' : '' %>>
                                    <option value="+255" <%= userPhoneCode === '+255' ? 'selected' : '' %>><%= t('contact:index.form.countries.TZ') %></option>
                                    <option value="+254" <%= userPhoneCode === '+254' ? 'selected' : '' %>><%= t('contact:index.form.countries.KE') %></option>
                                    <option value="+256" <%= userPhoneCode === '+256' ? 'selected' : '' %>><%= t('contact:index.form.countries.UG') %></option>
                                    <option value="+250" <%= userPhoneCode === '+250' ? 'selected' : '' %>><%= t('contact:index.form.countries.RW') %></option>
                                    <option value="+257" <%= userPhoneCode === '+257' ? 'selected' : '' %>><%= t('contact:index.form.countries.BI') %></option>
                                    <option value="+27" <%= userPhoneCode === '+27' ? 'selected' : '' %>><%= t('contact:index.form.countries.ZA') %></option>
                                    <option value="+1" <%= userPhoneCode === '+1' ? 'selected' : '' %>><%= t('contact:index.form.countries.US') %></option>
                                    <option value="+44" <%= userPhoneCode === '+44' ? 'selected' : '' %>><%= t('contact:index.form.countries.GB') %></option>
                                    <option value="+49" <%= userPhoneCode === '+49' ? 'selected' : '' %>><%= t('contact:index.form.countries.DE') %></option>
                                    <option value="+33" <%= userPhoneCode === '+33' ? 'selected' : '' %>><%= t('contact:index.form.countries.FR') %></option>
                                    <option value="+61" <%= userPhoneCode === '+61' ? 'selected' : '' %>><%= t('contact:index.form.countries.AU') %></option>
                                    <option value="+86" <%= userPhoneCode === '+86' ? 'selected' : '' %>><%= t('contact:index.form.countries.CN') %></option>
                                    <option value="+91" <%= userPhoneCode === '+91' ? 'selected' : '' %>><%= t('contact:index.form.countries.IN') %></option>
                                    <option value="+971" <%= userPhoneCode === '+971' ? 'selected' : '' %>><%= t('contact:index.form.countries.AE') %></option>
                                    <option value="+234" <%= userPhoneCode === '+234' ? 'selected' : '' %>><%= t('contact:index.form.countries.NG') %></option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.phoneNumber') %></label>
                                <input type="tel" name="phone" class="form-control" placeholder="<%= t('contact:index.form.phonePlaceholder') %>" value="<%= userPhoneNumber %>" <%= user ? 'readonly style="opacity:0.7;"' : '' %>>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.subject') %> <span class="text-primary">*</span></label>
                                <input type="text" name="subject" class="form-control" required placeholder="<%= t('contact:index.form.subjectPlaceholder') %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.form.message') %> <span class="text-primary">*</span></label>
                                <textarea name="message" class="form-control" rows="5" required placeholder="<%= t('contact:index.form.messagePlaceholder') %>"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-premium-primary btn-lg rounded-pill px-5"><i class="fa-solid fa-paper-plane me-2"></i><%= t('contact:index.form.submit') %></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card p-4 mb-4">
                    <div class="d-flex align-items-center mb-4">
                        <i class="fa-solid fa-address-card text-primary fa-2x me-3"></i>
                        <h5 class="text-white fw-bold mb-0"><%= t('contact:index.info.title') %></h5>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-location-dot text-primary me-3 fs-5"></i>
                            <span class="text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.info.officeAddress') %></span>
                        </div>
                        <p class="text-white ms-4 ps-1 mb-0 fs-5"><%= t('contact:index.info.address') %></p>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-phone text-primary me-3 fs-5"></i>
                            <span class="text-white-50 small text-uppercase tracking-widest"><%= t('common:words.phone') %></span>
                        </div>
                        <p class="text-white ms-4 ps-1 mb-0 fs-5">+255 782 303 971</p>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-envelope text-primary me-3 fs-5"></i>
                            <span class="text-white-50 small text-uppercase tracking-widest"><%= t('common:words.email') %></span>
                        </div>
                        <p class="text-white ms-4 ps-1 mb-0 fs-5">info@athstack.com</p>
                    </div>
                    <div class="mb-0">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-clock text-primary me-3 fs-5"></i>
                            <span class="text-white-50 small text-uppercase tracking-widest"><%= t('contact:index.info.businessHours') %></span>
                        </div>
                        <p class="text-white ms-4 ps-1 mb-0"><%= t('common:footer.weekdays') %></p>
                        <p class="text-white ms-4 ps-1 mb-0"><%= t('common:footer.saturday') %></p>
                    </div>
                </div>

                <div class="glass-card p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-share-nodes text-primary fa-2x me-3"></i>
                        <h5 class="text-white fw-bold mb-0"><%= t('contact:index.social.title') %></h5>
                    </div>
                    <p class="text-white-50 small mb-3"><%= t('contact:index.social.intro') %></p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-premium-outline rounded-pill" style="width:48px;height:48px;" aria-label="<%= t('contact:index.social.facebook') %>"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill" style="width:48px;height:48px;" aria-label="<%= t('contact:index.social.twitter') %>"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill" style="width:48px;height:48px;" aria-label="<%= t('contact:index.social.instagram') %>"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill" style="width:48px;height:48px;" aria-label="<%= t('contact:index.social.linkedin') %>"><i class="fa-brands fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
