<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-widest small">Get In Touch</span>
            <h1 class="text-white fw-bold mt-2">Contact Us</h1>
            <p class="text-muted">Have a question or need a quote? Reach out and our team will respond promptly.</p>
        </div>

        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-5">
            <div class="col-lg-7">
                <div class="glass-card no-lift p-5">
                    <h4 class="text-white fw-bold mb-4"><i class="fa-solid fa-paper-plane me-2 text-primary"></i>Send a Message</h4>
                    <form method="POST" action="/contact/send">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name *</label>
                                <input type="text" name="name" class="form-control" required placeholder="Your full name">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address *</label>
                                <input type="email" name="email" class="form-control" required placeholder="your@email.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="+255 7XX XXX XXX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <input type="text" name="subject" class="form-control" placeholder="How can we help?">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message *</label>
                                <textarea name="message" class="form-control" rows="5" required placeholder="Write your message here..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-premium-primary btn-lg rounded-pill px-5"><i class="fa-solid fa-paper-plane me-2"></i>Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card no-lift p-4 mb-4">
                    <h5 class="text-white fw-bold mb-4"><i class="fa-solid fa-address-card me-2 text-primary"></i>Contact Information</h5>
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-location-dot text-primary me-3"></i>
                            <span class="text-muted">Office Address</span>
                        </div>
                        <p class="text-white ms-4 mb-0">Arusha, Tanzania</p>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-phone text-primary me-3"></i>
                            <span class="text-muted">Phone</span>
                        </div>
                        <p class="text-white ms-4 mb-0">+255 26 220033</p>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-envelope text-primary me-3"></i>
                            <span class="text-muted">Email</span>
                        </div>
                        <p class="text-white ms-4 mb-0">info@athstack.com</p>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa-solid fa-clock text-primary me-3"></i>
                            <span class="text-muted">Business Hours</span>
                        </div>
                        <p class="text-white ms-4 mb-0">Mon - Fri: 08:00 AM - 06:00 PM</p>
                        <p class="text-white ms-4 mb-0">Sat: 09:00 AM - 02:00 PM</p>
                    </div>
                </div>

                <div class="glass-card no-lift p-4">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-share-nodes me-2 text-primary"></i>Follow Us</h5>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-premium-outline rounded-pill btn-sm"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill btn-sm"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill btn-sm"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="btn btn-premium-outline rounded-pill btn-sm"><i class="fa-brands fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
