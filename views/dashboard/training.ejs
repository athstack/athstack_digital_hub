<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-graduation-cap me-2 text-success"></i>My Enrolled Courses</h2>

                <% if (courses && courses.length > 0) { %>
                <div class="row g-4">
                    <% courses.forEach(course => { %>
                    <div class="col-md-6">
                        <div class="glass-card p-4 h-100">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded bg-dark me-3 d-flex align-items-center justify-content-center" style="width:64px;height:64px;overflow:hidden;flex-shrink:0;">
                                    <img src="/uploads/<%= course.course_image || 'default.jpg' %>" alt="<%= course.course_title || course.title %>" class="img-fluid" style="max-height:60px;object-fit:contain;">
                                </div>
                                <div>
                                    <h6 class="text-white fw-bold mb-0"><%= course.course_title || course.title %></h6>
                                    <small class="text-muted"><%= course.course_level || course.level || 'Beginner' %></small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <% if (course.course_duration || course.duration) { %>
                                        <small class="text-muted"><i class="fa-regular fa-clock me-1"></i><%= course.course_duration || course.duration %></small>
                                    <% } %>
                                    <% if (course.instructor_first_name) { %>
                                        <br><small class="text-muted"><i class="fa-solid fa-user-tie me-1"></i><%= course.instructor_first_name %> <%= course.instructor_last_name %></small>
                                    <% } %>
                                </div>
                                <% if (course.course_slug || course.slug) { %>
                                <a href="/training/<%= course.course_slug || course.slug %>" class="btn btn-premium-outline btn-sm rounded-pill">View</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-graduation-cap fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Enrolled Courses</h4>
                    <p class="text-muted">You haven't enrolled in any courses yet. Explore our training academy to get started.</p>
                    <a href="/training" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-rocket me-2"></i>Explore Courses</a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
