<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>
            <div class="col-lg-9">
                <% function _tStatus(s) { var k = String(s || '').replace(/_([a-z])/g, function(m, c) { return c.toUpperCase(); }); return t('status.' + k, { defaultValue: t('dashboard:words.' + k, { defaultValue: s }) }); } %>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('dashboard:repairs.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-wrench me-2 text-info"></i><%= t('dashboard:repairs.heading') %></h2>
                </div>

                <% if (bookings && bookings.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr>
                                    <th><%= t('dashboard:words.reference') %></th>
                                    <th><%= t('dashboard:words.service') %></th>
                                    <th><%= t('dashboard:words.device') %></th>
                                    <th><%= t('dashboard:words.technician') %></th>
                                    <th><%= t('dashboard:words.appointment') %></th>
                                    <th><%= t('words.status') %></th>
                                    <th><%= t('words.actions') %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bookings.forEach(booking => { %>
                                <tr>
                                    <td class="text-white fw-bold"><%= booking.reference_number || t('dashboard:words.na') %></td>
                                    <td class="text-white-50"><%= booking.service_title || t('dashboard:words.generalRepair') %></td>
                                    <td class="text-white-50"><%= booking.device_type || '' %> <%= booking.device_brand || '' %></td>
                                    <td class="text-white-50"><% if (booking.technician_first_name) { %><%= formatDisplayName(booking.technician_first_name, booking.technician_last_name) %><% } else { %><span class="text-warning"><%= t('dashboard:repairs.unassigned') %></span><% } %></td>
                                    <td class="text-white-50"><%= formatDate(booking.appointment_date) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(booking.status) %>"><%= _tStatus(booking.status) %></span></td>
                                    <td><a href="/dashboard/repairs/<%= booking.id %>" class="btn btn-sm btn-outline-primary rounded-pill"><%= t('words.view') %></a></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-wrench fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('dashboard:repairs.emptyTitle') %></h4>
                    <p class="text-white-50"><%= t('dashboard:repairs.emptyMessage') %></p>
                    <a href="/maintenance" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-calendar-check me-2"></i><%= t('dashboard:repairs.bookRepair') %></a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
