<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>
            <div class="col-lg-9">
                <% function _tStatus(s) { var k = String(s || '').replace(/_([a-z])/g, function(m, c) { return c.toUpperCase(); }); return t('status.' + k, { defaultValue: t('dashboard:words.' + k, { defaultValue: s }) }); } %>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('dashboard:orders.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-receipt me-2 text-primary"></i><%= t('dashboard:orders.heading') %></h2>
                </div>

                <% if (orders && orders.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr>
                                    <th><%= t('dashboard:orders.orderId') %></th>
                                    <th><%= t('words.date') %></th>
                                    <th><%= t('dashboard:words.items') %></th>
                                    <th><%= t('words.total') %></th>
                                    <th><%= t('words.status') %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                <tr style="cursor:pointer;" onclick="window.location='/dashboard/orders/<%= order.id %>'">
                                    <td class="text-white fw-bold">#<%= order.id %><% if (order.order_reference) { %><br><small class="text-white-50"><%= order.order_reference %></small><% } %></td>
                                    <td class="text-white-50"><%= formatDate(order.created_at) %></td>
                                    <td class="text-white-50"><%= t('dashboard:orders.item', { count: order.total_items || 0 }) %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(order.total_amount) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(order.status || order.order_status) %>"><%= _tStatus(order.status || order.order_status) %></span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-receipt fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('dashboard:orders.emptyTitle') %></h4>
                    <p class="text-white-50"><%= t('dashboard:orders.emptyMessage') %></p>
                    <a href="/shop" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-bag-shopping me-2"></i><%= t('dashboard:orders.browseShop') %></a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
