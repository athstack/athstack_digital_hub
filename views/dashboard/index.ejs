<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>

            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-gauge-high me-2 text-primary"></i>Dashboard</h2>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-box-shopping fa-2x text-primary mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= orderCount %></h3>
                            <p class="text-muted small mb-0">Total Orders</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-wrench fa-2x text-info mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= bookingCount %></h3>
                            <p class="text-muted small mb-0">Repair Requests</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-graduation-cap fa-2x text-success mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= courseCount %></h3>
                            <p class="text-muted small mb-0">Enrolled Courses</p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Recent Orders</h5>
                        <a href="/dashboard/orders" class="btn btn-premium-outline btn-sm rounded-pill">View All</a>
                    </div>
                    <% if (orders && orders.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th>Order</th><th>Date</th><th>Amount</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <% orders.slice(0, 5).forEach(order => { %>
                                <tr>
                                    <td class="text-white fw-bold">#<%= order.id %></td>
                                    <td class="text-muted"><%= order.created_at ? new Date(order.created_at).toLocaleDateString() : '' %></td>
                                     <td class="text-primary fw-bold"><%= formatCurrency(order.total_amount || 0) %></td>
                                    <td><span class="badge bg-<%= order.order_status === 'delivered' ? 'success' : (order.order_status === 'pending' ? 'warning' : 'secondary') %>"><%= order.order_status %></span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-muted mb-0"><i class="fa-solid fa-info-circle me-1"></i>No orders yet. <a href="/shop" class="text-primary">Browse our shop</a>.</p>
                    </div>
                    <% } %>
                </div>

                <div class="glass-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-wrench me-2 text-info"></i>Recent Repairs</h5>
                        <a href="/dashboard/repairs" class="btn btn-premium-outline btn-sm rounded-pill">View All</a>
                    </div>
                    <% if (bookings && bookings.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th>Reference</th><th>Service</th><th>Date</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <% bookings.slice(0, 5).forEach(booking => { %>
                                <tr>
                                    <td class="text-white fw-bold"><%= booking.reference_number || 'N/A' %></td>
                                    <td class="text-muted"><%= booking.service_title || 'General Repair' %></td>
                                    <td class="text-muted"><%= booking.appointment_date ? new Date(booking.appointment_date).toLocaleDateString() : '' %></td>
                                    <td><span class="badge <%= booking.status === 'completed' ? 'bg-success' : (booking.status === 'pending' ? 'bg-warning text-dark' : 'bg-primary') %>"><%= booking.status %></span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-muted mb-0"><i class="fa-solid fa-info-circle me-1"></i>No repair requests yet. <a href="/maintenance" class="text-primary">Book a repair</a>.</p>
                    </div>
                    <% } %>
                </div>

                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-graduation-cap me-2 text-success"></i>Enrolled Courses</h5>
                        <a href="/dashboard/training" class="btn btn-premium-outline btn-sm rounded-pill">View All</a>
                    </div>
                    <% if (courses && courses.length > 0) { %>
                    <div class="row g-3">
                        <% courses.slice(0, 3).forEach(course => { %>
                        <div class="col-md-4">
                            <div class="glass-card no-lift p-3">
                                <h6 class="text-white fw-bold mb-1"><%= course.course_title || course.title %></h6>
                                <small class="text-muted"><%= course.course_level || course.level || 'Beginner' %></small>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-muted mb-0"><i class="fa-solid fa-info-circle me-1"></i>No courses enrolled. <a href="/training" class="text-primary">Explore courses</a>.</p>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
