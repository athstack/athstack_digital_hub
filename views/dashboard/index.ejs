<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% function _tStatus(s) { var k = String(s || '').replace(/_([a-z])/g, function(m, c) { return c.toUpperCase(); }); return t('status.' + k, { defaultValue: t('dashboard:words.' + k, { defaultValue: s }) }); } %>
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>

            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('dashboard:index.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-gauge-high me-2 text-primary"></i><%= t('dashboard:index.heading') %></h2>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-receipt fa-2x text-primary mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= orderCount %></h3>
                            <p class="text-white-50 small mb-0"><%= t('dashboard:index.totalOrders') %></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-wrench fa-2x text-info mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= bookingCount %></h3>
                            <p class="text-white-50 small mb-0"><%= t('dashboard:index.repairRequests') %></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-graduation-cap fa-2x text-success mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= courseCount %></h3>
                            <p class="text-white-50 small mb-0"><%= t('dashboard:index.enrolledCourses') %></p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i><%= t('dashboard:index.recentOrders') %></h5>
                        <a href="/dashboard/orders" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('words.viewAll') %></a>
                    </div>
                    <% if (orders && orders.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th><%= t('dashboard:index.ordersTableOrder') %></th><th><%= t('words.date') %></th><th><%= t('dashboard:words.amount') %></th><th><%= t('words.status') %></th></tr>
                            </thead>
                            <tbody>
                                <% orders.slice(0, 5).forEach(order => {
                                    var _oStatus = order.order_status || '';
                                %>
                                <tr>
                                    <td class="text-white fw-bold">#<%= order.id %></td>
                                    <td class="text-white-50"><%= formatDate(order.created_at) %></td>
                                     <td class="text-primary fw-bold"><%= formatCurrency(order.total_amount || 0) %></td>
                                    <td><span class="badge bg-<%= order.order_status === 'delivered' ? 'success' : (order.order_status === 'pending' ? 'warning' : 'secondary') %>"><%= _tStatus(_oStatus) %></span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-white-50 mb-0"><i class="fa-solid fa-info-circle me-1"></i><%= t('dashboard:index.ordersEmpty') %> <a href="/shop" class="text-primary text-link"><%= t('dashboard:index.browseShop') %></a>.</p>
                    </div>
                    <% } %>
                </div>

                <div class="glass-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-wrench me-2 text-info"></i><%= t('dashboard:index.recentRepairs') %></h5>
                        <a href="/dashboard/repairs" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('words.viewAll') %></a>
                    </div>
                    <% if (bookings && bookings.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th><%= t('dashboard:words.reference') %></th><th><%= t('dashboard:words.service') %></th><th><%= t('words.date') %></th><th><%= t('words.status') %></th><th><%= t('words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% bookings.slice(0, 5).forEach(booking => {
                                    var _bStatus = booking.status || '';
                                %>
                                <tr>
                                    <td class="text-white fw-bold"><%= booking.reference_number || t('dashboard:words.na') %></td>
                                    <td class="text-white-50"><%= booking.service_title || t('dashboard:words.generalRepair') %></td>
                                    <td class="text-white-50"><%= formatDate(booking.appointment_date) %></td>
                                    <td><span class="badge <%= booking.status === 'completed' ? 'bg-success' : (booking.status === 'pending' ? 'bg-warning text-dark' : 'bg-primary') %>"><%= _tStatus(_bStatus) %></span></td>
                                    <td><a href="/dashboard/repairs/<%= booking.reference_number %>" class="btn btn-sm btn-outline-primary"><%= t('words.view') %></a></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-white-50 mb-0"><i class="fa-solid fa-info-circle me-1"></i><%= t('dashboard:index.noRepairs') %> <a href="/maintenance" class="text-primary text-link"><%= t('dashboard:index.bookRepair') %></a>.</p>
                    </div>
                    <% } %>
                </div>

                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-graduation-cap me-2 text-success"></i><%= t('dashboard:index.enrolledCourses') %></h5>
                        <a href="/dashboard/training" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('words.viewAll') %></a>
                    </div>
                    <% if (courses && courses.length > 0) { %>
                    <div class="row g-3">
                        <% courses.slice(0, 3).forEach(course => { %>
                        <div class="col-md-4">
                            <div class="glass-card no-lift p-3">
                                <h6 class="text-white fw-bold mb-1"><%= course.course_title || course.title %></h6>
                                <small class="text-white-50"><%= course.course_level || course.level || t('dashboard:words.beginner') %></small>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-white-50 mb-0"><i class="fa-solid fa-info-circle me-1"></i><%= t('dashboard:index.noCourses') %> <a href="/training" class="text-primary text-link"><%= t('dashboard:index.exploreCourses') %></a>.</p>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
