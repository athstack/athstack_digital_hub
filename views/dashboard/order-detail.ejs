<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/sidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center mb-4">
                    <a href="/dashboard/orders" class="text-white-50 text-decoration-none me-3"><i class="fa-solid fa-arrow-left"></i></a>
                    <span class="section-badge me-3">Order</span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-receipt me-2 text-primary"></i>Order #<%= order.id %></h2>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="glass-card p-3">
                            <small class="text-white-50 d-block mb-1">Order Reference</small>
                            <span class="text-white fw-bold"><%= order.order_reference || '#' + order.id %></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-3">
                            <small class="text-white-50 d-block mb-1">Date Placed</small>
                            <span class="text-white fw-bold"><%= formatDate(order.created_at) %></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-3">
                            <small class="text-white-50 d-block mb-1">Status</small>
                            <span class="badge <%= getStatusBadgeClass(order.status || order.order_status) %>"><%= order.status || order.order_status %></span>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 mb-4">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-box-open me-2 text-primary"></i>Items Ordered</h5>
                    <% if (order.items && order.items.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
                            </thead>
                            <tbody>
                                <% order.items.forEach(item => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded bg-dark me-2 d-flex align-items-center justify-content-center" style="width:40px;height:40px;overflow:hidden;flex-shrink:0;">
                                                <%- include('../partials/productImage', { src: item.product_image ? imageUrl(item.product_image, 'products') : '', alt: item.product_name, style: 'max-height:36px;object-fit:contain;' }) %>
                                            </div>
                                            <div>
                                                <span class="text-white fw-bold"><%= item.product_name %></span>
                                                <% if (item.product_slug) { %><br><a href="/shop/<%= item.product_slug %>" class="text-primary small text-link">View product</a><% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-white-50"><%= item.quantity %></td>
                                    <td class="text-white-50"><%= formatCurrency(item.unit_price) %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(item.total_price) %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <p class="text-white-50 mb-0">No item details available.</p>
                    <% } %>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="glass-card p-4">
                            <h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-credit-card me-2 text-primary"></i>Payment</h6>
                            <p class="text-white-50 mb-1">Method: <span class="text-white"><%= order.payment_method ? order.payment_method.toUpperCase() : 'N/A' %></span></p>
                            <p class="text-white-50 mb-0">Status: <span class="badge <%= getStatusBadgeClass(order.payment_status || 'pending') %>"><%= order.payment_status || 'pending' %></span></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="glass-card p-4">
                            <h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-calculator me-2 text-primary"></i>Order Summary</h6>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-white-50">Items (<%= order.items ? order.items.reduce((s, i) => s + i.quantity, 0) : 0 %>)</span>
                                <span class="text-white"><%= formatCurrency(order.total_amount) %></span>
                            </div>
                            <hr class="border-secondary opacity-25 my-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-white fw-bold">Total</span>
                                <span class="text-primary fw-bold fs-5"><%= formatCurrency(order.total_amount) %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
