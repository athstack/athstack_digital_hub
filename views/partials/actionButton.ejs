<%#
actionButton.ejs - reusable 44x44 premium icon action button

Wrap each include in EJS escaped-output tags (escaped output, no newline).
Usage:
  Link button:
    include('actionButton', { abVariant:'edit', abHref:'/admin/users/'+u.id+'/edit', abTitle:t('common:words.edit') })

  POST form button (csrf + optional native confirm):
    include('actionButton', { abVariant:'delete', abFormAction:'/admin/users/'+u.id+'/delete', abFormCsrf:csrfToken, abConfirm:t('admin:users.deleteConfirm',{name:u.first_name+' '+u.last_name}), abTitle:t('common:words.delete') })

  Plain button (custom JS handlers / modal triggers):
    include('actionButton', { abVariant:'view', abButton:true, abIcon:'fa-eye', abTitle:t('common:words.view'), abClassExtra:'view-msg', abAttrs:'data-id="1"' })

Params (all optional except the ones you need):
  abVariant    -> edit | delete | view | publish | approve | reject | hide | info | neutral (default neutral)
  abIcon       -> FontAwesome icon class (e.g. 'fa-pen'); falls back to a sensible default per variant
  abTitle      -> native tooltip (also used as aria-label unless abAria given)
  abAria       -> explicit aria-label
  abHref       -> render as <a href="...">
  abFormAction -> render as a POST <form action="..."> with a submit button
  abFormCsrf   -> csrf token placed in a hidden input (required with abFormAction)
  abFormExtra  -> raw HTML injected inside the form after the csrf input (e.g. extra hidden inputs)
  abConfirm    -> message for the existing [data-confirm] native confirm handling
  abButton     -> render as <button type="button"> (no form, no link)
  abClassExtra -> extra classes appended to the button (e.g. JS hook classes)
  abAttrs      -> extra HTML attributes (must be pre-escaped in the caller via escapeAttr)
  abOn         -> truthy adds the 'is-on' filled state
  abDisabled   -> truthy adds the 'disabled' attribute
%>
<%
var abVariant = typeof abVariant === 'undefined' ? 'neutral' : abVariant;
var abIcon = typeof abIcon === 'undefined' ? '' : abIcon;
var abIconDefaults = { edit:'fa-pen', delete:'fa-trash', view:'fa-eye', publish:'fa-paper-plane', approve:'fa-check', reject:'fa-xmark', hide:'fa-eye-slash', info:'fa-key', neutral:'fa-circle', toggle:'fa-toggle-on' };
if (!abIcon) { abIcon = abIconDefaults[abVariant] || 'fa-circle'; }
var abClass = 'action-btn action-btn--' + abVariant;
if (typeof abClassExtra !== 'undefined' && abClassExtra) { abClass += ' ' + abClassExtra; }
if (typeof abOn !== 'undefined' && abOn) { abClass += ' is-on'; }
var abTitle = typeof abTitle === 'undefined' ? '' : abTitle;
var abAria = (typeof abAria !== 'undefined' && abAria) ? abAria : abTitle;
var abAttrs = typeof abAttrs === 'undefined' ? '' : abAttrs;
var abDisabled = (typeof abDisabled !== 'undefined' && abDisabled) ? ' disabled' : '';
%>
<% if (typeof abButton !== 'undefined' && abButton) { %>
<button type="button" class="<%= abClass %>" title="<%= abTitle %>" aria-label="<%= abAria %>"<%= abDisabled %><% if (abAttrs) { %> <%- abAttrs %><% } %>><i class="fa-solid <%= abIcon %>"></i></button>
<% } else if (typeof abFormAction !== 'undefined' && abFormAction) { %>
<form method="POST" action="<%= abFormAction %>" class="d-inline"<% if (typeof abConfirm !== 'undefined' && abConfirm) { %> data-confirm="<%= abConfirm %>"<% } %>>
    <input type="hidden" name="csrf_token" value="<%= abFormCsrf || '' %>"><% if (typeof abFormExtra !== 'undefined' && abFormExtra) { %><%- abFormExtra %><% } %>
    <button type="submit" class="<%= abClass %>" title="<%= abTitle %>" aria-label="<%= abAria %>"<%= abDisabled %>><i class="fa-solid <%= abIcon %>"></i></button>
</form>
<% } else { %>
<a href="<%= abHref || '#' %>" class="<%= abClass %>" title="<%= abTitle %>" aria-label="<%= abAria %>"<% if (abAttrs) { %> <%- abAttrs %><% } %>><i class="fa-solid <%= abIcon %>"></i></a>
<% } %>
