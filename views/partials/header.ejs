<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || siteName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <span class="text-primary">ATHSTACK</span> DIGITAL
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#athstackNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="athstackNav">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link px-3" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/shop">Shop</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/maintenance">Maintenance</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/training">Training</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/about">About Us</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/contact">Contact</a></li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative d-none d-md-block">
                    <input type="text" id="globalLiveSearch" class="form-control bg-dark border-secondary text-white rounded-pill" placeholder="Search tech elements...">
                    <div id="searchSuggestionsBox" class="search-results-tray"></div>
                </div>
                <a href="/cart" class="text-white position-relative me-2">
                    <i class="fa-solid fa-bag-shopping fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" id="cartIndicatorCount"><%= cartCount %></span>
                </a>
                <% if (user) { %>
                    <a href="<%= user.role === 'admin' || user.role === 'super_admin' ? '/admin' : '/user' %>" class="btn btn-premium-primary btn-sm"><%= user.name %></a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-premium-primary btn-sm">Login</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
