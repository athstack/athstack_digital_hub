<%
  var p = product || {};
  var imgSrc = p.main_image ? imageUrl(p.main_image, 'products') : '/uploads/products/no-image.svg';
  var imgAlt = p.name || 'Product image';
  var discountPct = (p.discount_price && p.price && p.discount_price < p.price) ? Math.round(((p.price - p.discount_price) / p.price) * 100) : 0;
  var hasDiscount = discountPct > 0;
  var stockQty = parseInt(p.stock_quantity, 10) || 0;
  var stockCls = stockQty > 10 ? 'in-stock' : (stockQty > 0 ? 'low-stock' : 'out-of-stock');
  var stockLabel = stockQty > 10 ? 'In Stock' : (stockQty > 0 ? 'Low Stock' : 'Out of Stock');
  var isBestSeller = parseInt(p.total_sales, 10) > 100;
  var isFeatured = p.featured == 1;
  var stars = p.rating ? Math.round(p.rating) : 0;
  var hasRating = p.rating && p.rating > 0;
%>
<div class="product-card-wrapper">
  <a href="/shop/<%= p.slug %>" class="product-card-link" aria-label="View <%= p.name %>">
    <div class="product-card-inner">
      <div class="product-card-image-wrapper">
        <div class="product-card-skeleton"></div>
        <img class="product-card-img" src="<%= imgSrc %>"
             alt="<%= imgAlt %>"
             loading="lazy"
             onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';"
             onload="this.classList.add('loaded')">
        <div class="product-card-labels">
          <% if (hasDiscount) { %><span class="product-label product-label-discount">-<%= discountPct %>%</span><% } %>
          <% if (isFeatured) { %><span class="product-label product-label-featured">Featured</span><% } %>
          <% if (isBestSeller) { %><span class="product-label product-label-bestseller">Best Seller</span><% } %>
        </div>
        <form method="POST" action="/cart/add" class="product-card-add-form">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="product_id" value="<%= p.id %>">
          <button type="submit" class="product-card-add-btn" title="Add to Cart" aria-label="Add <%= p.name %> to cart">
            <i class="fa-solid fa-cart-plus"></i>
            <span>Add to Cart</span>
          </button>
        </form>
      </div>
      <div class="product-card-body">
        <div class="product-card-brand"><%= p.category_name || 'General' %></div>
        <h3 class="product-card-title"><%= p.name %></h3>
        <% if (hasRating) { %>
        <div class="product-card-rating" aria-label="<%= p.rating %> out of 5 stars">
          <div class="stars-row">
            <% for (var i = 1; i <= 5; i++) { %>
              <i class="<%= i <= stars ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= stars ? 'star-filled' : 'star-empty' %>"></i>
            <% } %>
          </div>
        </div>
        <% } %>
        <div class="product-card-pricing">
          <% if (hasDiscount) { %>
            <span class="product-card-price-current"><%= formatCurrency(p.discount_price) %></span>
            <span class="product-card-price-old"><%= formatCurrency(p.price) %></span>
          <% } else { %>
            <span class="product-card-price-current"><%= formatCurrency(p.price) %></span>
          <% } %>
        </div>
        <div class="product-card-stock <%= stockCls %>">
          <span class="stock-dot"></span>
          <span class="stock-label"><%= stockLabel %></span>
        </div>
      </div>
    </div>
  </a>
</div>