<div class="glass-card p-3 mb-4">
    <div class="d-flex align-items-center mb-3 px-2">
        <a href="/" class="gap-1" style="background:transparent;padding:0;border:none;line-height:1;display:flex;align-items:center;text-decoration:none;flex-shrink:0;">
            <img src="/images/techbridge-logo.png" alt="TechBridge" style="height:36px;width:auto;object-fit:contain;">
            <span class="text-white fw-bold d-none d-lg-inline" style="font-size:1.1rem;letter-spacing:-0.02em;line-height:1;">Tech<span class="text-primary">Bridge</span></span>
        </a>
        <div class="ms-auto">
            <div class="rounded-circle d-flex align-items-center justify-content-center<% if (!user || !user.avatar) { %> bg-success<% } %>" style="width:40px;height:40px;overflow:hidden;">
                <% if (user && user.avatar) { %>
                    <img src="<%= imageUrl(user.avatar, 'profiles') %>" alt="" style="width:100%;height:100%;object-fit:cover;">
                <% } else { %>
                    <i class="fa-solid fa-bullhorn text-white"></i>
                <% } %>
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center px-2 mb-2">
        <div>
            <h6 class="mb-0 text-white small"><%= user ? formatDisplayName(user.firstName, user.lastName) : t('marketing:sidebar.marketingOfficer') %></h6>
            <small class="text-white-50" style="font-size:11px;"><%= t('marketing:sidebar.panel') %></small>
        </div>
    </div>
    <hr class="border-secondary opacity-25 my-2">
    <nav class="nav flex-column gap-1">
        <a class="nav-link rounded<%= page.activeSection === 'dashboard' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing">
            <i class="fa-solid fa-gauge-high me-2"></i> <%= t('marketing:sidebar.dashboard') %>
        </a>

        <div class="sidebar-section-label"><%= t('marketing:sidebar.sectionMarketing') %></div>
        <a class="nav-link rounded<%= page.activeSection === 'campaigns' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/campaigns">
            <i class="fa-solid fa-bullhorn me-2"></i> <%= t('marketing:sidebar.campaigns') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'promotions' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/promotions">
            <i class="fa-solid fa-tags me-2"></i> <%= t('marketing:sidebar.promotions') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'coupons' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/coupons">
            <i class="fa-solid fa-ticket me-2"></i> <%= t('marketing:sidebar.coupons') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'featured-products' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/featured-products">
            <i class="fa-solid fa-star me-2"></i> <%= t('marketing:sidebar.featuredProducts') %>
        </a>

        <div class="sidebar-section-label"><%= t('marketing:sidebar.sectionContent') %></div>
        <a class="nav-link rounded<%= page.activeSection === 'banners' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/banners">
            <i class="fa-solid fa-flag me-2"></i> <%= t('marketing:sidebar.banners') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'blog' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/blog">
            <i class="fa-solid fa-newspaper me-2"></i> <%= t('marketing:sidebar.blog') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'testimonials' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/testimonials">
            <i class="fa-solid fa-comment-dots me-2"></i> <%= t('marketing:sidebar.testimonials') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'announcements' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/announcements">
            <i class="fa-solid fa-bullhorn me-2"></i> <%= t('marketing:sidebar.announcements') %>
        </a>

        <div class="sidebar-section-label"><%= t('marketing:sidebar.sectionEngagement') %></div>
        <a class="nav-link rounded<%= page.activeSection === 'reviews' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/reviews">
            <i class="fa-solid fa-star-half-stroke me-2"></i> <%= t('marketing:sidebar.reviews') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'feedback' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/feedback">
            <i class="fa-solid fa-envelope-open-text me-2"></i> <%= t('marketing:sidebar.feedback') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'newsletters' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/newsletters">
            <i class="fa-solid fa-envelope-circle-check me-2"></i> <%= t('marketing:sidebar.newsletters') %>
        </a>

        <div class="sidebar-section-label"><%= t('marketing:sidebar.sectionAnalytics') %></div>
        <a class="nav-link rounded<%= page.activeSection === 'analytics' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/analytics">
            <i class="fa-solid fa-chart-line me-2"></i> <%= t('marketing:sidebar.websiteAnalytics') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'campaign-analytics' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/analytics/campaigns">
            <i class="fa-solid fa-bullseye me-2"></i> <%= t('marketing:sidebar.campaignAnalytics') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'product-performance' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/analytics/products">
            <i class="fa-solid fa-ranking-star me-2"></i> <%= t('marketing:sidebar.productPerformance') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'reports' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/reports">
            <i class="fa-solid fa-file-lines me-2"></i> <%= t('marketing:sidebar.marketingReports') %>
        </a>

        <hr class="border-secondary opacity-25 my-2">
        <a class="nav-link rounded<%= page.activeSection === 'profile' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/profile">
            <i class="fa-solid fa-user me-2"></i> <%= t('marketing:sidebar.profile') %>
        </a>
        <a class="nav-link rounded<%= page.activeSection === 'settings' ? ' text-primary bg-primary bg-opacity-10' : ' text-white-50' %>" href="/marketing/settings">
            <i class="fa-solid fa-gear me-2"></i> <%= t('marketing:sidebar.settings') %>
        </a>
        <form method="POST" action="/auth/logout" class="d-inline w-100">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <button type="submit" class="nav-link rounded text-white-50 w-100 text-start border-0 bg-transparent">
                <i class="fa-solid fa-right-from-bracket me-2"></i> <%= t('marketing:sidebar.logout') %>
            </button>
        </form>
    </nav>
</div>
