<%# Currency selector dropdown. Mirrors languageSelector: accessible via
    Bootstrap dropdown, ARIA labelled. Prices are converted to the chosen
    currency at render time. %>
<div class="dropdown currency-selector" id="currencySelector">
    <button class="btn language-selector-btn" type="button" id="currencySelectorToggle"
            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false"
            aria-haspopup="true" aria-label="<%= t('common:currency.select', { defaultValue: 'Select currency' }) %>">
        <i class="fa-solid fa-coins" aria-hidden="true"></i>
        <span class="currency-selector-current d-none d-md-inline"><%= currency %></span>
        <i class="fa-solid fa-chevron-down language-selector-caret" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end language-selector-menu" aria-labelledby="currencySelectorToggle" role="listbox" aria-label="<%= t('common:currency.select', { defaultValue: 'Select currency' }) %>">
        <% CURRENCIES.forEach((c) => {
            const selected = c.code === currency; %>
        <li role="presentation">
            <button type="button" class="dropdown-item currency-option<%= selected ? ' active' : '' %>"
                    data-currency="<%= c.code %>" role="option" aria-selected="<%= selected ? 'true' : 'false' %>">
                <span class="currency-option-symbol" aria-hidden="true"><%= c.symbol %></span>
                <span class="currency-option-name"><%= c.label %></span>
                <% if (selected) { %>
                <span class="language-option-check ms-auto" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                <% } %>
            </button>
        </li>
        <% }) %>
    </ul>
    <span class="visually-hidden" id="currencyAnnounce" aria-live="polite" aria-atomic="true"><%= t('common:currency.current', { defaultValue: 'Currency: {{name}}', name: currency }) %></span>
</div>
