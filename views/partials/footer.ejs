<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        onerror="this.remove();var f=document.createElement('script');f.src='https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js';document.body.appendChild(f);"></script>
<script src="/assets/js/main.js"></script>
<script src="/assets/js/reviews.js"></script>
<script src="/assets/js/crud.js"></script>
<script>
    window.CRUD_CSRF = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
    window.CRUD_I18N = {
        cancel: '<%= t('common:words.cancel') %>',
        delete: '<%= t('common:words.delete') %>',
        confirmTitle: '<%= t('common:confirm.areYouSure') %>',
        requestFailed: '<%= t('common:notifications.failedToLoad') %>',
        networkError: '<%= t('common:words.networkError', { defaultValue: 'Network error. Please try again.' }) %>',
        loadFailed: '<%= t('common:notifications.failedToLoad') %>'
    };
</script>
<script>
(function() {
    var i18nStrings = {
        justNow: '<%= t('common:notifications.justNow') %>',
        minutesAgo: '<%= t('common:notifications.minutesAgo') %>',
        hoursAgo: '<%= t('common:notifications.hoursAgo') %>',
        noNotifications: '<%= t('common:notifications.noNotifications') %>',
        failedToLoad: '<%= t('common:notifications.failedToLoad') %>',
        noFileSelected: '<%= t('common:words.noFileSelected') %>',
        areYouSure: '<%= t('common:confirm.areYouSure') %>',
        searchLoading: '<%= t('common:nav.loading') %>',
        reviewLoading: '<%= t('shop:reviews.loading') %>',
        reviewLoadingMore: '<%= t('shop:reviews.loadingMore') %>',
        reviewNoMatch: '<%= t('shop:reviews.noMatch') %>',
        reviewEmpty: '<%= t('shop:reviews.empty') %>',
        reviewFound_one: '<%= t('shop:reviews.found_one') %>',
        reviewFound_other: '<%= t('shop:reviews.found_other') %>',
        reviewLoadFailed: '<%= t('shop:reviews.loadFailed') %>',
        reviewRequestFailed: '<%= t('shop:reviews.requestFailed') %>',
        reviewRatingHint: '<%= t('shop:reviews.ratingHint') %>',
        reviewMinLength: '<%= t('shop:reviews.minLength') %>',
        reviewInvalidImageType: '<%= t('shop:reviews.invalidImageType') %>',
        reviewPhotoTooLarge: '<%= t('shop:reviews.photoTooLarge') %>',
        reviewMaxPhotos: '<%= t('shop:reviews.maxPhotos') %>',
        reviewRemovePhoto: '<%= t('shop:reviews.removePhoto') %>',
        reviewReported: '<%= t('shop:reviews.reported') %>',
        reviewSelectReason: '<%= t('shop:reviews.selectReason') %>',
        locale: '<%= currentLang.locale %>',
        currency: '<%= currentLang.currency %>'
    };
    window.i18nStrings = i18nStrings;
    const bell = document.getElementById('notifBell');
    if (!bell) return;
    const badge = document.getElementById('notifBadge');
    const list = document.getElementById('notifList');
    const markAllBtn = document.getElementById('markAllRead');

    var notifsCache = [];

    function esc(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    async function loadNotifications() {
        try {
            const res = await fetch('/api/notifications');
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            if (data.unread > 0) {
                badge.textContent = data.unread;
                badge.classList.remove('d-none');
            } else {
                badge.classList.add('d-none');
            }
            notifsCache = data.notifications || [];
            if (notifsCache.length > 0) {
                list.innerHTML = notifsCache.map(function(n) {
                    var time = '';
                    if (n.created_at) {
                        var d = new Date(n.created_at);
                        var now = new Date();
                        var diff = (now - d) / 1000;
                        if (diff < 60) time = i18nStrings.justNow;
                        else if (diff < 3600) time = i18nStrings.minutesAgo.replace('{{count}}', Math.floor(diff / 60));
                        else if (diff < 86400) time = i18nStrings.hoursAgo.replace('{{count}}', Math.floor(diff / 3600));
                        else time = d.toLocaleDateString();
                    }
                    var unreadStyle = n.is_read ? '' : 'background:rgba(37,99,235,0.12);border-left:3px solid var(--bs-primary);';
                    return '<a href="' + esc(n.link || '#') + '" class="dropdown-item px-3 py-2 text-decoration-none notif-item" style="white-space:normal;word-wrap:break-word;' + unreadStyle + 'background-color:transparent;color:inherit;">' +
                        '<div style="font-weight:600;font-size:0.85rem;color:rgba(255,255,255,0.95);">' + esc(n.title) + '</div>' +
                        '<div style="font-size:0.8rem;line-height:1.45;color:rgba(255,255,255,0.55);">' + esc(n.message) + '</div>' +
                        (time ? '<div style="margin-top:4px;color:rgba(255,255,255,0.3);font-size:0.7rem;">' + time + '</div>' : '') +
                        '</a>';
                }).join('');
            } else {
                list.innerHTML = '<div class="text-center text-muted py-4">' + esc(i18nStrings.noNotifications) + '</div>';
            }
        } catch(e) {
            list.innerHTML = '<div class="text-center text-muted py-4">' + esc(i18nStrings.failedToLoad) + '</div>';
        }
    }

    window.markNotifRead = async function(id) {
        try { await fetch('/api/notifications/read', {method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':window.CRUD_CSRF},body:JSON.stringify({id})}); } catch(e) { console.warn('markNotifRead failed', e); }
    };

    list.addEventListener('click', function(e) {
        var link = e.target.closest('a.notif-item');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href === '#') {
            e.preventDefault();
            return;
        }
        e.preventDefault();
        var idx = Array.prototype.indexOf.call(list.querySelectorAll('a.notif-item'), link);
        if (idx !== -1 && notifsCache[idx] && notifsCache[idx].id) {
            window.markNotifRead(notifsCache[idx].id);
        }
        var dropdown = document.getElementById('notifDropdown');
        if (dropdown) {
            var toggle = dropdown.querySelector('[data-bs-toggle="dropdown"]');
            if (toggle) {
                var inst = bootstrap.Dropdown.getInstance(toggle);
                if (inst) inst.hide();
            }
        }
        window.location.href = href;
    });

    if (markAllBtn) {
        markAllBtn.addEventListener('click', async function() {
            try {
                await fetch('/api/notifications/read', {method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':window.CRUD_CSRF},body:JSON.stringify({})});
                loadNotifications();
            } catch(e) { console.warn('markAllRead failed', e); }
        });
    }

    loadNotifications();
    setInterval(loadNotifications, 60000);
})();
</script>
</body>
</html>
