<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge"><i class="fa-solid fa-bag-shopping me-2"></i>Shopping Cart</span>
            <h1 class="display-4 text-white fw-bold mt-3">Your Cart</h1>
        </div>

        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
            <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <% if (cartItems && cartItems.length > 0) { %>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead class="text-white-50 small text-uppercase tracking-widest">
                                <tr>
                                    <th class="border-0">Product</th>
                                    <th class="border-0">Price</th>
                                    <th class="border-0" style="width:160px;">Quantity</th>
                                    <th class="border-0">Subtotal</th>
                                    <th class="border-0"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cartItems.forEach((item, index) => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-3 bg-dark me-3 d-flex align-items-center justify-content-center flex-shrink-0 overflow-hidden" style="width:72px;height:72px;">
                                             <%- include('../partials/productImage', { src: item.main_image ? imageUrl(item.main_image, 'products') : '', alt: item.name, style: 'max-height:68px;object-fit:contain;' }) %>
                                            </div>
                                            <div>
                                                <a href="/shop/<%= item.slug %>" class="text-white fw-bold text-decoration-none fs-5"><%= item.name %></a>
                                                <% if (item.category_name) { %>
                                                    <br><small class="text-white-50"><%= item.category_name %></small>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                     <td class="text-primary fw-bold fs-5"><%= formatCurrency(item.price) %></td>
                                    <td>
                                        <form method="POST" action="/cart/update" class="d-flex align-items-center">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <input type="hidden" name="product_id" value="<%= item.id %>">
                                            <div class="input-group" style="width:130px;">
                                                <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="btn btn-outline-secondary"><i class="fa-solid fa-minus"></i></button>
                                                <span class="form-control text-center bg-dark text-white border-secondary fw-bold"><%= item.quantity %></span>
                                                <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="btn btn-outline-secondary"><i class="fa-solid fa-plus"></i></button>
                                            </div>
                                        </form>
                                    </td>
                                     <td class="text-primary fw-bold fs-5"><%= formatCurrency(item.subtotal) %></td>
                                    <td>
                                        <form method="POST" action="/cart/remove/<%= index %>">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Remove"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card p-4 sticky-top" style="top:100px;">
                    <h5 class="text-white fw-bold mb-4 pb-3 border-bottom border-secondary border-opacity-25">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-white-50">Subtotal (<%= cartItems.length %> items)</span>
                         <span class="text-white fw-bold fs-5"><%= formatCurrency(cartTotal) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-white-50">Shipping</span>
                        <span class="text-success fw-bold">Calculated at checkout</span>
                    </div>
                    <hr class="border-secondary opacity-25">
                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-white fw-bold fs-4">Total</span>
                         <span class="text-primary fw-bold fs-4"><%= formatCurrency(cartTotal) %></span>
                    </div>
                    <form method="POST" action="/cart/checkout">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-premium-primary w-100 rounded-pill btn-lg mb-3"><i class="fa-solid fa-lock me-2"></i>Proceed to Checkout</button>
                    </form>
                    <a href="/shop" class="btn btn-premium-outline w-100 rounded-pill"><i class="fa-solid fa-arrow-left me-2"></i>Continue Shopping</a>
                </div>
            </div>
        </div>
        <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-cart-shopping fa-4x mb-4"></i>
            <h4 class="text-white fw-bold">Your Cart is Empty</h4>
            <p class="text-white-50">Looks like you haven't added any products yet. Browse our shop to find premium tech hardware.</p>
            <a href="/shop" class="btn btn-premium-primary rounded-pill px-5 btn-lg"><i class="fa-solid fa-bag-shopping me-2"></i>Browse Shop</a>
        </div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>
