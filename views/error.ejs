<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Something went wrong</title>
    <style>
        :root { color-scheme: dark; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            background: radial-gradient(circle at top, #10162c 0%, #060911 70%);
            color: #e8ecf7;
            text-align: center;
        }
        .card {
            max-width: 520px;
            width: 100%;
            padding: 40px 32px;
            border: 1px solid rgba(120, 150, 255, 0.25);
            border-radius: 18px;
            background: rgba(20, 28, 52, 0.6);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
        }
        .code { font-size: 56px; font-weight: 800; color: #6b8cff; margin: 0 0 8px; }
        h1 { font-size: 22px; margin: 0 0 12px; }
        p { color: #a8b2cc; line-height: 1.5; margin: 0 0 24px; }
        a {
            display: inline-block;
            padding: 12px 28px;
            border-radius: 999px;
            background: linear-gradient(135deg, #4f7cff, #7a4fff);
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        a:hover { filter: brightness(1.1); }
    </style>
</head>
<body>
    <div class="card">
        <div class="code"><%= statusCode %></div>
        <h1>Something went wrong</h1>
        <p><%= message %></p>
        <a href="/">Return home</a>
    </div>
</body>
</html>
