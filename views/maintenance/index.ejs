<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-widest small">Device Repair & IT Maintenance</span>
            <h1 class="text-white fw-bold mt-2">Enterprise Maintenance Services</h1>
            <p class="text-muted">Professional diagnostics, repair, and IT maintenance for computers and mobile devices.</p>
        </div>

        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-4 mb-5">
            <div class="col-lg-6">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center me-3" style="width:56px;height:56px;">
                            <i class="fa-solid fa-desktop fa-2x text-primary"></i>
                        </div>
                        <h3 class="text-white fw-bold mb-0">Computer Services</h3>
                    </div>
                    <div class="row g-3">
                        <% if (computerServices && computerServices.length > 0) { %>
                            <% computerServices.forEach(service => { %>
                            <div class="col-sm-6">
                                <div class="glass-card no-lift p-3 h-100">
                                    <i class="<%= service.icon_class || 'fa-solid fa-tools' %> text-primary mb-2"></i>
                                    <h6 class="text-white fw-bold mb-1"><%= service.title %></h6>
                                    <p class="text-muted small mb-2"><%= service.description || 'Professional service' %></p>
                                     <span class="text-primary fw-bold small"><%= formatCurrency(service.base_price || 0) %></span>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                        <div class="col-12 text-center py-3">
                            <p class="text-muted">Computer services are being configured. Check back soon.</p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex align-items-center justify-content-center me-3" style="width:56px;height:56px;">
                            <i class="fa-solid fa-mobile-screen-button fa-2x text-info"></i>
                        </div>
                        <h3 class="text-white fw-bold mb-0">Phone Services</h3>
                    </div>
                    <div class="row g-3">
                        <% if (phoneServices && phoneServices.length > 0) { %>
                            <% phoneServices.forEach(service => { %>
                            <div class="col-sm-6">
                                <div class="glass-card no-lift p-3 h-100">
                                    <i class="<%= service.icon_class || 'fa-solid fa-tools' %> text-info mb-2"></i>
                                    <h6 class="text-white fw-bold mb-1"><%= service.title %></h6>
                                    <p class="text-muted small mb-2"><%= service.description || 'Professional service' %></p>
                                     <span class="text-primary fw-bold small"><%= formatCurrency(service.base_price || 0) %></span>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                        <div class="col-12 text-center py-3">
                            <p class="text-muted">Phone services are being configured. Check back soon.</p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-card no-lift p-5">
                    <h3 class="text-white fw-bold mb-4 text-center"><i class="fa-solid fa-calendar-check me-2 text-primary"></i>Book a Repair</h3>
                    <form method="POST" action="/maintenance/book">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name *</label>
                                <input type="text" name="name" class="form-control" required placeholder="John Doe">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address *</label>
                                <input type="email" name="email" class="form-control" required placeholder="john@example.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number *</label>
                                <input type="tel" name="phone" class="form-control" required placeholder="+255 7XX XXX XXX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Appointment Date *</label>
                                <input type="date" name="appointment_date" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Service Type *</label>
                                <select name="service_id" class="form-select" required>
                                    <option value="">Select a service...</option>
                                    <% if (services && services.length > 0) { %>
                                        <% services.forEach(svc => { %>
                                         <option value="<%= svc.id %>"><%= svc.title %> (<%= formatCurrency(svc.base_price || 0) %>)</option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Device Type</label>
                                <select name="device_type" class="form-select">
                                    <option value="laptop">Laptop</option>
                                    <option value="desktop">Desktop</option>
                                    <option value="smartphone">Smartphone</option>
                                    <option value="tablet">Tablet</option>
                                    <option value="network">Network Equipment</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Device Brand</label>
                                <input type="text" name="device_brand" class="form-control" placeholder="e.g. Apple, Dell, Samsung">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Device Model</label>
                                <input type="text" name="device_model" class="form-control" placeholder="e.g. MacBook Pro 14">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Issue Description</label>
                                <textarea name="issue_description" class="form-control" rows="4" placeholder="Describe the issue you're experiencing..."></textarea>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-premium-primary btn-lg rounded-pill px-5"><i class="fa-solid fa-paper-plane me-2"></i>Submit Repair Request</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
