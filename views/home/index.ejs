<%- include('../partials/header') %>

<section class="hero-section position-relative overflow-hidden" data-aos="fade-up">
    <div class="hero-bg-gradient position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="hero-particles position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="hero-glow hero-glow-1 position-absolute"></div>
    <div class="hero-glow hero-glow-2 position-absolute"></div>
    <div class="hero-glow-center position-absolute"></div>
    <div class="container position-relative z-1">
        <div class="hero-content-wrapper mx-auto text-center">
            <div class="hero-badge d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill mb-4">
                <span class="hero-badge-dot"></span>
                <span class="hero-badge-text fw-semibold small text-uppercase tracking-widest">Welcome to TechBridge Digital Hub</span>
            </div>
            <h1 class="hero-title display-3 fw-bold mb-4">
                <span class="gradient-text">Advanced Engineering & </span><span class="gradient-text-alt">Hardware Solutions</span>
            </h1>
            <p class="hero-subtitle lead mx-auto mb-5">
                Your unified pipeline for premium tech hardware procurement, enterprise device diagnostics, and elite technical systems instruction.
            </p>
            <div class="d-flex gap-3 flex-wrap justify-content-center">
                <a href="/shop" class="btn btn-premium-primary btn-lg rounded-pill px-4 py-3"><i class="fa-solid fa-bag-shopping me-2"></i>Explore Shop</a>
                <a href="/maintenance" class="btn btn-premium-outline btn-lg rounded-pill px-4 py-3"><i class="fa-solid fa-wrench me-2"></i>Book Diagnostic</a>
                <a href="/training" class="btn btn-premium-outline btn-lg rounded-pill px-4 py-3"><i class="fa-solid fa-graduation-cap me-2"></i>Training Academy</a>
            </div>
        </div>
    </div>
    <div class="hero-bottom-shape position-absolute bottom-0 start-0 w-100"></div>
</section>

<section class="stats-section position-relative" data-aos="fade-up">
    <div class="container">
        <div class="row g-3 g-md-4 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="stat-card text-center p-4 h-100">
                    <div class="stat-icon-wrapper mx-auto mb-3 d-flex align-items-center justify-content-center rounded-3" style="width:56px;height:56px;">
                        <i class="fa-solid fa-users fa-xl text-primary"></i>
                    </div>
                    <h3 class="stat-number text-white fw-bold mb-1"><%= stats.customers %>+</h3>
                    <p class="stat-label text-white-50 small mb-0">Active Clients</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card text-center p-4 h-100">
                    <div class="stat-icon-wrapper mx-auto mb-3 d-flex align-items-center justify-content-center rounded-3" style="width:56px;height:56px;">
                        <i class="fa-solid fa-box-open fa-xl" style="color:var(--accent);"></i>
                    </div>
                    <h3 class="stat-number text-white fw-bold mb-1"><%= stats.products %>+</h3>
                    <p class="stat-label text-white-50 small mb-0">Tech Products</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card text-center p-4 h-100">
                    <div class="stat-icon-wrapper mx-auto mb-3 d-flex align-items-center justify-content-center rounded-3" style="width:56px;height:56px;">
                        <i class="fa-solid fa-graduation-cap fa-xl" style="color:var(--success);"></i>
                    </div>
                    <h3 class="stat-number text-white fw-bold mb-1"><%= stats.courses %>+</h3>
                    <p class="stat-label text-white-50 small mb-0">Training Courses</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card text-center p-4 h-100">
                    <div class="stat-icon-wrapper mx-auto mb-3 d-flex align-items-center justify-content-center rounded-3" style="width:56px;height:56px;">
                        <i class="fa-solid fa-check-circle fa-xl" style="color:var(--primary-light);"></i>
                    </div>
                    <h3 class="stat-number text-white fw-bold mb-1"><%= stats.repairs %>+</h3>
                    <p class="stat-label text-white-50 small mb-0">Repairs Completed</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="services-section section-alt position-relative overflow-hidden">
    <div class="section-top-divider"></div>
    <div class="section-glow section-glow-1"></div>
    <div class="section-glow section-glow-2"></div>
    <div class="container position-relative z-1">
        <div class="row justify-content-center text-center mb-5" data-aos="fade-up">
            <div class="col-lg-6">
                <div class="section-icon mx-auto"><i class="fa-solid fa-layer-group"></i></div>
                <span class="section-badge d-inline-block fw-semibold small text-uppercase tracking-widest mb-3">Our Services</span>
                <h2 class="section-title text-white fw-bold display-6 mb-3">End-to-End Tech Solutions</h2>
                <p class="section-desc">Comprehensive technology services engineered for performance, reliability, and growth.</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up-sm" data-aos-delay="100">
                <div class="service-card text-center h-100">
                    <div class="service-icon-wrapper mx-auto mb-4 d-flex align-items-center justify-content-center rounded-4 position-relative">
                        <div class="service-icon-glow position-absolute top-50 start-50 translate-middle"></div>
                        <i class="fa-solid fa-bag-shopping fa-2x position-relative z-1" style="color:var(--primary);"></i>
                    </div>
                    <h5 class="service-title text-white fw-bold mb-3">Tech Shop</h5>
                    <p class="service-desc mb-4">Premium hardware, accessories, and enterprise equipment curated for performance.</p>
                    <a href="/shop" class="btn btn-premium-outline btn-sm rounded-pill px-4 stretched-link">Browse Products <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up-sm" data-aos-delay="200">
                <div class="service-card text-center h-100">
                    <div class="service-icon-wrapper mx-auto mb-4 d-flex align-items-center justify-content-center rounded-4 position-relative">
                        <div class="service-icon-glow position-absolute top-50 start-50 translate-middle"></div>
                        <i class="fa-solid fa-wrench fa-2x position-relative z-1 text-info"></i>
                    </div>
                    <h5 class="service-title text-white fw-bold mb-3">Maintenance & Repair</h5>
                    <p class="service-desc mb-4">Expert device diagnostics, system repair, and enterprise IT maintenance pipelines.</p>
                    <a href="/maintenance" class="btn btn-premium-outline btn-sm rounded-pill px-4 stretched-link">Book Repair <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up-sm" data-aos-delay="300">
                <div class="service-card text-center h-100">
                    <div class="service-icon-wrapper mx-auto mb-4 d-flex align-items-center justify-content-center rounded-4 position-relative">
                        <div class="service-icon-glow position-absolute top-50 start-50 translate-middle"></div>
                        <i class="fa-solid fa-graduation-cap fa-2x position-relative z-1" style="color:var(--success);"></i>
                    </div>
                    <h5 class="service-title text-white fw-bold mb-3">Training Academy</h5>
                    <p class="service-desc mb-4">Professional engineering courses and technical certification programs.</p>
                    <a href="/training" class="btn btn-premium-outline btn-sm rounded-pill px-4 stretched-link">Explore Courses <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (featured && featured.length > 0) { %>
<section class="products-section position-relative overflow-hidden">
    <div class="section-top-divider"></div>
    <div class="section-glow section-glow-1"></div>
    <div class="section-glow section-glow-2"></div>
    <div class="container position-relative z-1">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-5" data-aos="fade-up">
            <div>
                <span class="section-badge d-inline-block fw-semibold small text-uppercase tracking-widest mb-3">Featured Products</span>
                <h2 class="section-title text-white fw-bold display-6 mb-0">Premium Tech Hardware</h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/shop" class="btn btn-premium-outline rounded-pill px-4">View All <i class="fa-solid fa-arrow-right ms-1"></i></a>
            </div>
        </div>
        <div class="row g-4">
            <% featured.forEach((product, i) => { %>
            <div class="col-md-4 col-lg-2" data-aos="fade-up-sm" data-aos-delay="<%= (i % 6) * 100 + 100 %>">
                <a href="/shop/<%= product.slug %>" class="text-decoration-none d-block h-100">
                    <div class="product-card h-100">
                        <div class="product-card-image position-relative overflow-hidden rounded-top-3">
                            <div class="product-img-wrapper" style="height:160px;">
                                <%- include('../partials/productImage', { src: product.main_image ? imageUrl(product.main_image, 'products') : '', alt: product.name, style: 'width:100%;height:100%;object-fit:cover;' }) %>
                            </div>
                            <% if (product.discount_price && product.discount_price < product.price) { %>
                                <span class="product-discount-badge position-absolute top-0 start-0 m-2 badge bg-danger rounded-pill">Sale</span>
                            <% } %>
                        </div>
                        <div class="product-card-body p-3">
                            <p class="product-category text-uppercase tracking-widest mb-1"><%= product.category_name || 'General' %></p>
                            <h6 class="product-title text-white fw-bold text-truncate mb-2"><%= product.name %></h6>
                            <div class="d-flex align-items-center gap-2">
                                <% if (product.discount_price && product.discount_price < product.price) { %>
                                    <span class="product-price text-primary fw-bold"><%= formatCurrency(product.discount_price) %></span>
                                    <span class="product-price-old text-white-50 text-decoration-line-through small"><%= formatCurrency(product.price) %></span>
                                <% } else { %>
                                    <span class="product-price text-primary fw-bold"><%= formatCurrency(product.price) %></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<% if (recentCourses && recentCourses.length > 0) { %>
<section class="courses-section section-alt position-relative overflow-hidden">
    <div class="section-top-divider"></div>
    <div class="section-glow section-glow-1"></div>
    <div class="section-glow section-glow-2"></div>
    <div class="container position-relative z-1">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-5" data-aos="fade-up">
            <div>
                <span class="section-badge d-inline-block fw-semibold small text-uppercase tracking-widest mb-3">Training Academy</span>
                <h2 class="section-title text-white fw-bold display-6 mb-0">Latest Courses</h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/training" class="btn btn-premium-outline rounded-pill px-4">View All <i class="fa-solid fa-arrow-right ms-1"></i></a>
            </div>
        </div>
        <div class="row g-4">
            <% recentCourses.forEach((course, i) => { %>
            <div class="col-md-4" data-aos="fade-up-sm" data-aos-delay="<%= (i % 3) * 100 + 100 %>">
                <a href="/training/<%= course.slug %>" class="text-decoration-none d-block h-100">
                    <div class="course-card h-100">
                        <div class="course-card-header d-flex align-items-center gap-2 px-4 pt-4 pb-3">
                            <% if (course.level) { %>
                                <span class="course-level-badge badge rounded-pill fw-semibold"><%= course.level %></span>
                            <% } %>
                            <% if (course.duration) { %>
                                <span class="course-duration small ms-auto"><i class="fa-regular fa-clock me-1"></i><%= course.duration %></span>
                            <% } %>
                        </div>
                        <div class="course-card-body px-4 pb-4">
                            <h5 class="course-title text-white fw-bold mb-2"><%= course.title %></h5>
                            <p class="course-desc small mb-4"><%= course.description ? course.description.substring(0, 120) + '...' : '' %></p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-10">
                                <% if (course.price > 0) { %>
                                    <span class="course-price text-primary fw-bold"><%= formatCurrency(course.price) %></span>
                                <% } else { %>
                                    <span class="course-price text-success fw-bold"><i class="fa-regular fa-circle-check me-1"></i>Free</span>
                                <% } %>
                                <span class="course-instructor small"><i class="fa-solid fa-user-tie me-1"></i><%= formatDisplayName(course.instructor_first_name || 'TechBridge', course.instructor_last_name) %></span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<section class="cta-section position-relative overflow-hidden">
    <div class="container position-relative z-1">
        <div class="cta-card-wrapper" data-aos="fade-up">
            <h2 class="text-white fw-bold display-6 mb-3">Ready to Get Started?</h2>
            <p class="text-white-50 mb-4 mx-auto" style="max-width:600px;">Join the TechBridge Digital Hub and access premium tech products, expert repairs, and professional training.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/auth/register" class="btn btn-premium-primary btn-lg rounded-pill px-4 py-3"><i class="fa-solid fa-user-plus me-2"></i>Create Account</a>
                <a href="/contact" class="btn btn-premium-outline btn-lg rounded-pill px-4 py-3"><i class="fa-solid fa-phone me-2"></i>Contact Sales</a>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>