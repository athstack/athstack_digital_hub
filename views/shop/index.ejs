<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge"><i class="fa-solid fa-microchip me-2"></i>Tech Hardware Store</span>
            <h1 class="display-4 text-white fw-bold mt-3">Premium Products</h1>
            <p class="text-white-50 fs-5">Explore our curated collection of enterprise-grade hardware and accessories.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3">
                <div class="glass-card p-4 mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-sliders me-2 text-primary"></i>
                        <h6 class="text-white fw-bold mb-0">Filters</h6>
                    </div>
                    <form method="GET" action="/shop">
                        <div class="mb-3">
                            <label class="form-label text-white-50 small text-uppercase tracking-widest">Search</label>
                            <input type="text" name="search" class="form-control sidebar-search" placeholder="Search products..." value="<%= searchQuery || '' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small text-uppercase tracking-widest">Category</label>
                            <select name="category" class="form-select">
                                <option value="">All Categories</option>
                                <% if (typeof categories !== 'undefined' && categories) { categories.forEach(cat => { %>
                                <option value="<%= cat.slug %>" <%= activeCategory === cat.slug ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) } %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small text-uppercase tracking-widest">Price Range</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="min_price" class="form-control" placeholder="$0" value="<%= minPrice || '' %>">
                                </div>
                                <div class="col-6">
                                    <input type="number" name="max_price" class="form-control" placeholder="$9999" value="<%= maxPrice || '' %>">
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100 rounded-pill"><i class="fa-solid fa-search me-2"></i>Apply Filters</button>
                        <% var hasFilters = searchQuery || activeCategory || minPrice || maxPrice; if (hasFilters) { %><a href="/shop" class="btn btn-premium-outline w-100 rounded-pill mt-2">Clear All</a><% } %>
                    </form>
                </div>
            </div>

            <div class="col-lg-9">
                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
                    <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <div class="product-grid">
                    <% products.forEach(product => { %>
                    <div class="product-grid-item">
                        <a href="/shop/<%= product.slug %>" class="d-block text-decoration-none">
                            <div class="glass-card p-0 h-100 product-card shop-product-card d-flex flex-column overflow-hidden">
                                <div class="product-img-wrapper rounded-t-xl h-48 overflow-hidden">
                                    <%- include('../partials/productImage', { src: product.main_image ? imageUrl(product.main_image, 'products') : '', alt: product.name, style: 'width:100%;height:100%;object-fit:cover;', className: '' }) %>
                                </div>
                                <div class="d-flex flex-column p-3" style="flex:1;">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <h6 class="text-white fw-bold mb-0 product-title"><%= product.name %></h6>
                                        <% if (product.discount_price && product.discount_price < product.price) { %>
                                            <span class="badge bg-danger flex-shrink-0">-<%= Math.round(((product.price - product.discount_price) / product.price) * 100) %>%</span>
                                        <% } %>
                                    </div>
                                    <p class="text-white-50 small mt-1 mb-0"><%= product.category_name || 'General' %></p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                        <div>
                                             <% if (product.discount_price && product.discount_price < product.price) { %>
                                                <span class="text-primary fw-bold fs-5"><%= formatCurrency(product.discount_price) %></span>
                                                <small class="text-white-50 text-decoration-line-through ms-1"><%= formatCurrency(product.price) %></small>
                                            <% } else { %>
                                                <span class="text-primary fw-bold fs-5"><%= formatCurrency(product.price) %></span>
                                            <% } %>
                                        </div>
                                        <form method="POST" action="/cart/add" class="d-inline">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <input type="hidden" name="product_id" value="<%= product.id %>">
                                            <button type="submit" class="btn btn-premium-primary btn-sm rounded-pill" title="Add to Cart"><i class="fa-solid fa-cart-plus"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }) %>
                </div>

                <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
                <nav class="mt-5" aria-label="Product pagination">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= pagination.page - 1 %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
                        </li>
                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= i %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><%= i %></a>
                        </li>
                        <% } %>
                        <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= pagination.page + 1 %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open fa-4x mb-4"></i>
                    <h4 class="text-white fw-bold">No Products Found</h4>
                    <p class="text-white-50">No products match your current filters. Try adjusting your search criteria.</p>
                    <a href="/shop" class="btn btn-premium-primary rounded-pill px-5">View All Products</a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
