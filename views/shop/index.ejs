<%- include('../partials/header') %>

<section class="shop-section" data-aos="fade-up">
    <div class="container">
        <div class="text-center mb-4">
            <span class="section-badge"><i class="fa-solid fa-microchip me-2"></i><%= t('shop:index.badge') %></span>
            <h1 class="display-4 text-white fw-bold mt-3"><%= t('shop:index.heading') %></h1>
            <p class="text-white-50 fs-5"><%= t('shop:index.subtitle') %></p>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="glass-card no-lift filter-toolbar p-3 mb-2">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-sliders me-2 text-primary"></i>
                        <h6 class="text-white fw-bold mb-0"><%= t('shop:index.filters') %></h6>
                    </div>
                    <form method="GET" action="/shop" class="filter-toolbar-form">
                        <div class="filter-toolbar-control">
                            <label class="form-label text-white-50 small text-uppercase"><%= t('common:words.category') %></label>
                            <select name="category" class="form-select filter-toolbar-input">
                                <option value=""><%= t('shop:index.allCategories') %></option>
                                <% if (typeof categories !== 'undefined' && categories) { categories.forEach(cat => { %>
                                <option value="<%= cat.slug %>" <%= activeCategory === cat.slug ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) } %>
                            </select>
                        </div>
                        <div class="filter-toolbar-control">
                            <label class="form-label text-white-50 small text-uppercase"><%= t('shop:index.minPrice') %></label>
                            <input type="number" name="min_price" class="form-control filter-toolbar-input" placeholder="<%= formatCurrency(0) %>" value="<%= minPrice || '' %>">
                        </div>
                        <div class="filter-toolbar-control">
                            <label class="form-label text-white-50 small text-uppercase"><%= t('shop:index.maxPrice') %></label>
                            <input type="number" name="max_price" class="form-control filter-toolbar-input" placeholder="<%= formatCurrency(9999) %>" value="<%= maxPrice || '' %>">
                        </div>
                        <div class="filter-toolbar-actions">
                            <button type="submit" class="btn btn-premium-primary filter-toolbar-btn rounded-pill"><i class="fa-solid fa-filter me-2"></i><%= t('shop:index.applyFilters') %></button>
                            <% var hasFilters = searchQuery || activeCategory || minPrice || maxPrice; if (hasFilters) { %><a href="/shop" class="btn btn-premium-outline filter-toolbar-btn rounded-pill"><%= t('shop:index.clearAll') %></a><% } %>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12">
                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
                    <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                <div class="product-grid-enhanced">
                    <% products.forEach(product => { %>
                    <%- include('../partials/productCard', { product, csrfToken, formatCurrency }) %>
                    <% }) %>
                </div>

                <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
                <nav class="mt-5" aria-label="<%= t('shop:index.paginationAria') %>">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= pagination.page - 1 %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
                        </li>
                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= i %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><%= i %></a>
                        </li>
                        <% } %>
                        <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                            <a class="page-link rounded-pill" href="/shop?page=<%= pagination.page + 1 %><%= activeCategory ? '&category=' + activeCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open fa-4x mb-4"></i>
                    <h4 class="text-white fw-bold"><%= t('shop:index.emptyTitle') %></h4>
                    <p class="text-white-50"><%= t('shop:index.emptyMessage') %></p>
                    <a href="/shop" class="btn btn-premium-primary rounded-pill px-5"><%= t('shop:index.viewAllProducts') %></a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
