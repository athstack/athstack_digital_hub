    <div class="lightbox-image-wrapper">
      <img id="reviewLightboxImage" src="" alt="">
    </div>
    <button class="lightbox-nav lightbox-next" id="reviewLightboxNext" aria-label="<%= t('shop:words.nextPhoto') %>"><i class="fa-solid fa-chevron-right"></i></button>
