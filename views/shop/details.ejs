<%- include('../partials/header') %>

<section class="product-detail-section">
  <div class="container">
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
      <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
      <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (product) { %>

    <nav aria-label="breadcrumb" class="product-breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('common:words.home') %></a></li>
        <li class="breadcrumb-item"><a href="/shop"><%= t('common:nav.shop') %></a></li>
        <% if (product.category_slug) { %>
        <li class="breadcrumb-item"><a href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a></li>
        <% } %>
        <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <div class="product-detail-layout">
      <div class="product-detail-gallery" data-aos="fade-up">
        <div class="gallery-main" id="galleryMain">
          <div class="gallery-main-image-wrapper">
            <%
              var mainImg = product.main_image ? imageUrl(product.main_image, 'products') : '/uploads/products/no-image.svg';
            %>
            <img id="galleryMainImg"
                 src="<%= mainImg %>"
                 alt="<%= product.name %>"
                 class="gallery-main-image"
                 data-zoom="<%= mainImg %>"
                 onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
            <div class="gallery-zoom-lens" id="galleryZoomLens"></div>
            <div class="gallery-zoom-result" id="galleryZoomResult"></div>
            <div class="gallery-fullscreen-btn" id="galleryFullscreenBtn" title="<%= t('shop:words.viewFullSize') %>" aria-label="<%= t('shop:words.openFullscreen') %>">
              <i class="fa-solid fa-expand"></i>
            </div>
          </div>
          <div class="gallery-loader-skeleton" id="gallerySkeleton">
            <div class="skeleton-pulse"></div>
          </div>
        </div>

        <div class="gallery-thumbnails" id="galleryThumbnails" role="tablist" aria-label="<%= t('shop:words.imageThumbnails') %>">
          <button class="gallery-thumb active" role="tab" aria-selected="true" aria-label="<%= t('shop:words.mainImage') %>" data-src="<%= mainImg %>">
            <img src="<%= mainImg %>" alt="" onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
          </button>
          <% if (gallery && gallery.length > 0) {
            gallery.forEach(function(img) {
              var imgSrc = img.image_path ? imageUrl(img.image_path, 'products') : '';
              if (!imgSrc) return;
          %>
          <button class="gallery-thumb" role="tab" aria-selected="false" aria-label="<%= t('shop:words.galleryImage') %>" data-src="<%= imgSrc %>">
            <img src="<%= imgSrc %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
          </button>
          <% }); } %>
        </div>
      </div>

      <div class="product-detail-info" data-aos="fade-up" data-aos-delay="100">
        <div class="info-meta">
          <span class="info-category-badge"><%= product.category_name || t('common:words.general') %></span>
          <span class="info-brand">TechBridge</span>
        </div>

        <h1 class="info-title"><%= product.name %></h1>

        <div class="info-sku-row">
          <% if (product.sku) { %>
          <span class="info-sku"><%= t('shop:details.sku') %> <strong><%= product.sku %></strong></span>
          <% } %>
        </div>

        <div class="info-rating-row">
          <% if (avgRating > 0) { %>
          <div class="info-rating-stars" aria-label="<%= t('shop:details.ratingAria', { rating: avgRating.toFixed(1) }) %>">
            <% for (var i = 1; i <= 5; i++) { %>
              <i class="<%= i <= Math.round(avgRating) ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= Math.round(avgRating) ? 'star-filled' : '' %>"></i>
            <% } %>
          </div>
          <span class="info-rating-value"><%= avgRating.toFixed(1) %></span>
          <span class="info-rating-count">(<%= t('shop:reviews.reviewCount', { count: reviewCount }) %>)</span>
          <% } else if (product.rating && Number(product.rating) > 0) { %>
          <div class="info-rating-stars" aria-label="<%= t('shop:details.ratingAria', { rating: Number(product.rating).toFixed(1) }) %>">
            <% for (var i = 1; i <= 5; i++) { %>
              <i class="<%= i <= Math.round(Number(product.rating)) ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= Math.round(Number(product.rating)) ? 'star-filled' : '' %>"></i>
            <% } %>
          </div>
          <span class="info-rating-value"><%= Number(product.rating).toFixed(1) %></span>
          <% } %>
          <% if (product.total_sales && product.total_sales > 10) { %>
          <span class="info-sold"><i class="fa-solid fa-fire"></i> <%= t('shop:details.sold', { count: product.total_sales }) %></span>
          <% } %>
        </div>

        <div class="info-divider"></div>

        <div class="info-price-row">
          <%
            var hasDiscount = product.discount_price && parseFloat(product.discount_price) < parseFloat(product.price);
            var pctSaved = 0;
            if (hasDiscount) {
              pctSaved = calculateDiscount ? calculateDiscount(product.price, product.discount_price) : Math.round(((product.price - product.discount_price) / product.price) * 100);
            }
          %>
          <% if (hasDiscount) { %>
            <span class="info-price-current"><%= formatCurrency(product.discount_price) %></span>
            <span class="info-price-original"><%= formatCurrency(product.price) %></span>
            <span class="info-price-badge">-<%= pctSaved %>%</span>
            <span class="info-price-save"><%= t('shop:details.save', { amount: formatCurrency(parseFloat(product.price) - parseFloat(product.discount_price)) }) %></span>
          <% } else { %>
            <span class="info-price-current"><%= formatCurrency(product.price) %></span>
          <% } %>
        </div>

        <div class="info-stock-row">
          <% if (product.stock_quantity > 10) { %>
          <span class="stock-badge in-stock"><span class="stock-dot"></span> <%= t('common:words.inStock') %></span>
          <% } else if (product.stock_quantity > 0) { %>
          <span class="stock-badge low-stock"><span class="stock-dot"></span> <%= t('shop:details.lowStock', { count: product.stock_quantity }) %></span>
          <% } else { %>
          <span class="stock-badge out-of-stock"><span class="stock-dot"></span> <%= t('common:words.outOfStock') %></span>
          <% } %>
        </div>

        <div class="info-meta-row">
          <div class="info-meta-item">
            <i class="fa-solid fa-truck"></i>
            <span><%= t('shop:words.freeDelivery') %> <strong><%= deliveryDate ? t('shop:words.deliveryBy', { date: formatDate(deliveryDate, { weekday: 'long', month: 'short', day: 'numeric' }) }) : t('shop:words.orderNow') %></strong></span>
          </div>
          <div class="info-meta-item">
            <i class="fa-solid fa-shield-halved"></i>
            <span><strong><%= t('shop:words.warrantyShort') %></strong> <%= t('shop:words.warranty') %></span>
          </div>
          <div class="info-meta-item">
            <i class="fa-solid fa-rotate-left"></i>
            <span><strong><%= t('shop:words.returns30') %></strong> <%= t('shop:words.easyReturns') %></span>
          </div>
        </div>

        <div class="info-divider"></div>

        <div class="info-quantity-actions">
          <div class="info-quantity">
            <label class="quantity-label" for="qtyInput"><%= t('common:words.quantity') %></label>
            <div class="quantity-stepper">
              <button type="button" class="qty-btn qty-minus" id="qtyMinus" aria-label="<%= t('shop:details.decreaseQty') %>" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>>
                <i class="fa-solid fa-minus"></i>
              </button>
              <input type="number" id="qtyInput" class="qty-input" value="1" min="1" max="<%= product.stock_quantity || 1 %>" readonly aria-live="polite">
              <button type="button" class="qty-btn qty-plus" id="qtyPlus" aria-label="<%= t('shop:details.increaseQty') %>" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>>
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </div>

          <div class="info-actions" id="productActions">
            <% if (product.stock_quantity > 0) { %>
            <form method="POST" action="/cart/add" class="info-action-form add-to-cart-form" id="addToCartForm">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
              <input type="hidden" name="product_id" value="<%= product.id %>">
              <input type="hidden" name="quantity" id="cartQtyInput" value="1">
              <button type="submit" class="btn-action btn-add-to-cart" id="addToCartBtn" aria-label="<%= t('shop:words.addToCart') %>">
                <i class="fa-solid fa-cart-plus"></i>
                <span><%= t('shop:words.addToCart') %></span>
              </button>
            </form>
            <form method="POST" action="/cart/add" class="info-action-form buy-now-form" id="buyNowForm">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
              <input type="hidden" name="product_id" value="<%= product.id %>">
              <input type="hidden" name="quantity" id="buyNowQtyInput" value="1">
              <input type="hidden" name="redirect" value="/checkout">
              <button type="submit" class="btn-action btn-buy-now" id="buyNowBtn" aria-label="<%= t('shop:words.buyNow') %>">
                <i class="fa-solid fa-bolt"></i>
                <span><%= t('shop:words.buyNow') %></span>
              </button>
            </form>
            <% } %>
            <div class="info-action-icon-group">
              <% if (user) { %>
              <form method="POST" action="/dashboard/wishlist/<%= isWishlisted ? 'remove' : 'add' %>" class="d-inline">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <button type="submit" class="btn-icon <%= isWishlisted ? 'active' : '' %>" id="wishlistBtn" title="<%= isWishlisted ? t('shop:details.removeWishlist') : t('shop:details.addWishlist') %>" aria-label="<%= isWishlisted ? t('shop:details.removeWishlist') : t('shop:details.addWishlist') %>">
                  <i class="fa-solid fa-heart"></i>
                </button>
              </form>
              <% } %>
              <button type="button" class="btn-icon" id="shareBtn" title="<%= t('shop:details.shareProduct') %>" aria-label="<%= t('shop:details.shareProduct') %>">
                <i class="fa-solid fa-share-nodes"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="info-trust-badges">
          <div class="trust-badge"><i class="fa-solid fa-shield-check"></i> <%= t('shop:words.genuineProduct') %></div>
          <div class="trust-badge"><i class="fa-solid fa-lock"></i> <%= t('shop:words.securePayment') %></div>
          <div class="trust-badge"><i class="fa-solid fa-rocket"></i> <%= t('shop:words.fastDelivery') %></div>
          <div class="trust-badge"><i class="fa-solid fa-arrow-rotate-left"></i> <%= t('shop:words.easyReturnsShort') %></div>
          <div class="trust-badge"><i class="fa-solid fa-award"></i> <%= t('shop:words.warrantySupport') %></div>
          <div class="trust-badge"><i class="fa-solid fa-headset"></i> <%= t('shop:words.support247') %></div>
        </div>

        <div class="info-seller-card">
          <div class="seller-avatar">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="seller-info">
            <div class="seller-name-row">
              <span class="seller-name">TechBridge Digital Hub</span>
              <span class="seller-badge verified"><%= t('shop:words.verified') %></span>
            </div>
            <div class="seller-meta">
              <span class="seller-rating">
                <i class="fa-solid fa-star star-filled"></i>
                <span>4.9</span>
              </span>
              <span class="seller-response">
                <i class="fa-regular fa-clock"></i> <%= t('shop:words.respondsIn') %>
              </span>
              <span class="seller-products">
                <i class="fa-solid fa-cube"></i> <%= t('shop:details.sellerProducts', { count: 12 }) %>
              </span>
            </div>
          </div>
          <a href="/shop" class="seller-visit-btn"><%= t('shop:words.visitStore') %></a>
        </div>
      </div>
    </div>

    <div class="product-detail-sections" data-aos="fade-up" data-aos-delay="50">
      <div class="product-detail-tabs">
        <button class="detail-tab active" data-tab="specs" role="tab" aria-selected="true"><%= t('shop:details.tabs.specs') %></button>
        <button class="detail-tab" data-tab="description" role="tab" aria-selected="false"><%= t('shop:details.tabs.description') %></button>
        <button class="detail-tab" data-tab="reviews" role="tab" aria-selected="false"><%= t('shop:details.tabs.reviews', { count: reviewCount }) %></button>
      </div>

      <div class="detail-tab-content active" id="tab-specs" role="tabpanel">
        <div class="specs-grid">
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.brand') %></span><span class="spec-value">TechBridge</span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.model') %></span><span class="spec-value"><%= product.sku || product.name %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('common:words.category') %></span><span class="spec-value"><%= product.category_name || t('common:words.general') %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.warranty') %></span><span class="spec-value"><%= t('shop:words.warranty1Year') %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.material') %></span><span class="spec-value"><%= t('shop:words.premiumQuality') %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.compatibility') %></span><span class="spec-value"><%= t('shop:words.compatSystems') %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.returns') %></span><span class="spec-value"><%= t('shop:words.returns30Day') %></span></div>
          <div class="spec-item"><span class="spec-label"><%= t('shop:details.specs.shipping') %></span><span class="spec-value"><%= t('shop:words.freeWorldwide') %></span></div>
        </div>
      </div>

      <div class="detail-tab-content" id="tab-description" role="tabpanel">
        <div class="description-content">
          <% if (product.description) {
            var descLines = product.description.split('\n').filter(function(l) { return l.trim(); });
            var intro = descLines.length > 0 ? descLines[0] : '';
            var features = descLines.slice(1);
          %>
          <p class="description-intro"><%= intro %></p>
          <% if (features.length > 0) { %>
          <ul class="description-features">
            <% features.forEach(function(f) { %>
            <li><%= f.replace(/^[•\-\*]\s*/, '') %></li>
            <% }); %>
          </ul>
          <% } else { %>
          <ul class="description-features">
            <% t('shop:details.features.defaults', { returnObjects: true }).forEach(function(f) { %>
            <li><%= f %></li>
            <% }); %>
          </ul>
          <% } %>
          <% } else { %>
          <p class="description-intro"><%= t('shop:details.fallback.intro') %></p>
          <ul class="description-features">
            <% t('shop:details.fallback.defaults', { returnObjects: true }).forEach(function(f) { %>
            <li><%= f %></li>
            <% }); %>
          </ul>
          <% } %>
        </div>
      </div>

      <div class="detail-tab-content" id="tab-reviews" role="tabpanel">
        <% if (reviewGallery && reviewGallery.length > 0) { %>
        <!-- Customer Photo Gallery -->
        <div class="review-gallery-section" data-aos="fade-up">
          <div class="review-gallery-head">
            <h3 class="review-write-title mb-0"><i class="fa-solid fa-images me-2 text-primary"></i><%= t('shop:reviews.customerPhotos') %></h3>
            <span class="review-gallery-meta"><%= t('shop:reviews.photosFromCustomers', { count: reviewStats.photoCount || reviewGallery.length }) %></span>
          </div>
          <div class="review-gallery-carousel" id="reviewGalleryCarousel">
            <% reviewGallery.forEach(function(photo, pi) { %>
            <button type="button" class="review-gallery-thumb" data-gallery-index="<%= pi %>" data-full="<%= photo.url %>" aria-label="<%= t('shop:reviews.openPhoto', { count: pi + 1 }) %>">
              <img src="<%= reviewThumbUrl(photo.url) %>" alt="<%= t('shop:reviews.customerPhotoAlt') %>" loading="lazy">
            </button>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Review Summary -->
        <div class="review-summary-card" data-aos="fade-up">
          <div class="review-summary-left">
            <div class="review-summary-score"><%= reviewStats.average > 0 ? reviewStats.average.toFixed(1) : Number(product.rating || 0).toFixed(1) %></div>
            <div class="review-summary-stars">
              <% var avgR = reviewStats.average > 0 ? reviewStats.average : Number(product.rating || 0); %>
              <% for (let i = 1; i <= 5; i++) { %>
                <i class="<%= i <= Math.round(avgR) ? 'fa-solid' : 'fa-regular' %> fa-star star-filled"></i>
              <% } %>
            </div>
            <div class="review-summary-count"><%= t('shop:reviews.reviewCount', { count: reviewStats.count }) %></div>
            <% if (reviewStats.verifiedCount > 0) { %>
            <div class="review-summary-verified"><i class="fa-solid fa-circle-check"></i> <%= t('shop:reviews.verifiedPurchaseCount', { count: reviewStats.verifiedCount }) %></div>
            <% } %>
          </div>
          <div class="review-summary-bars">
            <% var dist = reviewStats.distribution || {5:0,4:0,3:0,2:0,1:0};
               var maxBar = Math.max.apply(null, [dist[5], dist[4], dist[3], dist[2], dist[1], 1]); %>
            <% [5,4,3,2,1].forEach(function(star) { %>
            <div class="review-bar-row">
              <button type="button" class="review-bar-filter" data-rating="<%= star %>" aria-label="<%= t('shop:reviews.filterStars', { star }) %>">
                <span class="review-bar-label"><%= star %> <i class="fa-solid fa-star" style="font-size:0.6rem;"></i></span>
                <span class="review-bar-track"><span class="review-bar-fill" style="width:<%= Math.round((dist[star] / maxBar) * 100) %>%"></span></span>
                <span class="review-bar-count"><%= dist[star] %></span>
              </button>
            </div>
            <% }); %>
          </div>
        </div>

        <!-- Write Review -->
        <% if (user) { %>
          <% if (reviewEligibility && reviewEligibility.hasPurchased) { %>
            <% if (reviewEligibility.hasReviewed) { %>
            <div class="review-login-card review-written-card">
              <div>
                <p class="mb-0 text-white"><i class="fa-solid fa-circle-check me-2 text-success"></i><%= t('shop:reviews.youReviewed') %></p>
                <small class="text-white-50"><%= t('shop:reviews.statusLabel', { status: t('shop:reviews.reviewStatus.' + (reviewEligibility.review.status === 'approved' ? 'approved' : reviewEligibility.review.status === 'rejected' ? 'rejected' : 'pending')) }) %></small>
              </div>
              <a href="/dashboard/reviews/<%= reviewEligibility.review.id %>/edit" class="btn btn-premium-outline btn-sm rounded-pill flex-shrink-0"><i class="fa-solid fa-pen me-1"></i><%= t('shop:words.editReview') %></a>
            </div>
            <% } else { %>
            <div class="review-write-card">
              <div class="d-flex align-items-center gap-3">
                <h3 class="review-write-title mb-0"><i class="fa-solid fa-pen me-2 text-primary"></i><%= t('shop:reviews.writeTitle') %></h3>
                <span class="verified-badge"><i class="fa-solid fa-circle-check"></i> <%= t('shop:words.verifiedPurchase') %></span>
              </div>
              <p class="text-white-50 mt-2"><%= t('shop:reviews.writePrompt') %></p>
              <button type="button" class="btn-action btn-submit-review" data-bs-toggle="modal" data-bs-target="#reviewModal"><i class="fa-solid fa-paper-plane me-2"></i><%= t('shop:reviews.writeYourReview') %></button>
            </div>
            <% } %>
          <% } else { %>
          <div class="review-login-card">
            <p class="mb-0"><i class="fa-solid fa-lock me-2 text-warning"></i><%= t('shop:reviews.onlyVerified') %> <a href="/shop" class="text-primary fw-bold text-link"><%= t('shop:words.shopNow') %></a><%= t('shop:reviews.getInvite') %></p>
          </div>
          <% } %>
        <% } else { %>
        <div class="review-login-card">
          <p class="mb-0"><a href="/auth/login" class="text-primary fw-bold text-link"><%= t('shop:words.login') %></a> <%= t('shop:reviews.loginPrompt') %></p>
        </div>
        <% } %>

        <!-- Review Filters -->
        <div class="review-filter-bar" data-aos="fade-up">
          <div class="review-filter-chips" role="group" aria-label="<%= t('shop:reviews.sortAria') %>">
            <button type="button" class="review-chip active" data-sort="recent"><%= t('shop:reviews.sortRecent') %></button>
            <button type="button" class="review-chip" data-sort="highest"><%= t('shop:reviews.sortHighest') %></button>
            <button type="button" class="review-chip" data-sort="lowest"><%= t('shop:reviews.sortLowest') %></button>
            <button type="button" class="review-chip" data-sort="helpful"><%= t('shop:reviews.sortHelpful') %></button>
          </div>
          <div class="review-filter-toggles">
            <button type="button" class="review-chip" data-has-photos="1"><i class="fa-solid fa-camera me-1"></i><%= t('shop:reviews.withPhotos') %></button>
            <button type="button" class="review-chip" data-verified="1"><i class="fa-solid fa-circle-check me-1"></i><%= t('shop:words.verified') %></button>
          </div>
          <div class="review-filter-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="reviewSearchInput" class="form-control" placeholder="<%= t('shop:reviews.searchPlaceholder') %>" aria-label="<%= t('shop:reviews.searchAria') %>">
          </div>
        </div>

        <!-- Review List -->
        <div id="reviewListContainer" data-product-id="<%= product.id %>" data-total="<%= reviewStats.count %>">
          <% if (reviews && reviews.length > 0) { %>
          <div class="review-list" id="reviewList">
            <% reviews.forEach(function(review) { %>
            <%- include('../partials/reviewCard', { review: review, currentUserId: user ? user.id : null }) %>
            <% }) %>
          </div>
          <div class="review-load-more text-center mt-4" style="<%= hasMoreReviews ? '' : 'display:none;' %>">
            <button type="button" class="btn btn-premium-outline rounded-pill px-4" id="reviewLoadMoreBtn"><%= t('shop:reviews.loadMore') %></button>
          </div>
          <% } else { %>
          <div class="review-empty" id="reviewEmptyState">
            <i class="fa-regular fa-comments"></i>
            <p><%= t('shop:reviews.empty') %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="related-section" data-aos="fade-up">
      <div class="related-header">
        <h2 class="related-title"><%= t('shop:details.related.title') %></h2>
        <a href="/shop" class="related-view-all"><%= t('common:words.viewAll') %> <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="product-grid-enhanced">
        <% relatedProducts.forEach(function(rp) { %>
          <%- include('../partials/productCard', { product: rp, csrfToken: csrfToken, formatCurrency: formatCurrency }) %>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% } else { %>
    <div class="empty-state">
      <i class="fa-solid fa-exclamation-triangle fa-4x mb-4"></i>
      <h4 class="text-white fw-bold"><%= t('shop:details.notFound.title') %></h4>
      <p class="text-white-50"><%= t('shop:details.notFound.message') %></p>
      <a href="/shop" class="btn btn-premium-primary rounded-pill px-5"><%= t('shop:details.notFound.backToShop') %></a>
    </div>
    <% } %>
  </div>
</section>

