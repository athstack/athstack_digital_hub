<!-- Report Review Modal -->
<div class="modal fade" id="reportReviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white fw-bold"><i class="fa-regular fa-flag me-2 text-warning"></i><%= t('shop:details.report.title') %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('common:words.close') %>"></button>
      </div>
      <div class="modal-body">
        <p class="text-white-50 mb-3"><%= t('shop:details.report.prompt') %></p>
        <div class="report-reasons">
          <% ['spam', 'fake', 'inappropriate', 'conflict', 'offtopic'].forEach(function(key) { %>
          <label class="report-reason-option">
            <input type="radio" name="reportReason" value="<%= t('shop:details.report.reasons.' + key) %>">
            <span><%= t('shop:details.report.reasons.' + key) %></span>
          </label>
          <% }) %>
        </div>
        <div class="form-text text-white-50 mt-2" id="reportFormError"></div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
        <button type="button" class="btn btn-danger rounded-pill" id="reportSubmitBtn"><i class="fa-solid fa-flag me-2"></i><%= t('shop:details.report.title') %></button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  /* ---------- CONFIG ---------- */
  var MAIN_IMG = document.getElementById('galleryMainImg');
  var THUMBS = document.querySelectorAll('.gallery-thumb');
  var ZOOM_LENS = document.getElementById('galleryZoomLens');
  var ZOOM_RESULT = document.getElementById('galleryZoomResult');
  var LIGHTBOX = document.getElementById('lightboxOverlay');
  var LIGHTBOX_IMG = document.getElementById('lightboxImage');
  var LIGHTBOX_CLOSE = document.getElementById('lightboxClose');
  var LIGHTBOX_PREV = document.getElementById('lightboxPrev');
  var LIGHTBOX_NEXT = document.getElementById('lightboxNext');
  var LIGHTBOX_COUNTER = document.getElementById('lightboxCounter');
  var FULLSCREEN_BTN = document.getElementById('galleryFullscreenBtn');
  var SKELETON = document.getElementById('gallerySkeleton');
  var images = [];
  var currentIndex = 0;

  /* Collect all image sources */
  images.push(MAIN_IMG.getAttribute('src'));
  THUMBS.forEach(function(t) {
    var s = t.getAttribute('data-src');
    if (s && images.indexOf(s) === -1) images.push(s);
  });

  /* ---------- SKELETON LOADER ---------- */
  if (SKELETON) {
    var tempImg = new Image();
    tempImg.onload = function() { SKELETON.style.display = 'none'; };
    tempImg.onerror = function() { SKELETON.style.display = 'none'; };
    tempImg.src = MAIN_IMG.getAttribute('src');
    setTimeout(function() { if (SKELETON) SKELETON.style.display = 'none'; }, 3000);
  }

  /* ---------- THUMBNAIL SWITCH ---------- */
  function setActiveImage(index) {
    if (index < 0 || index >= images.length) return;
    currentIndex = index;
    MAIN_IMG.setAttribute('src', images[index]);
    MAIN_IMG.setAttribute('data-zoom', images[index]);
    THUMBS.forEach(function(t, i) {
      t.classList.toggle('active', i === index);
      t.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
  }

  THUMBS.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { setActiveImage(i); });
    thumb.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setActiveImage(i); }
    });
  });

  /* ---------- IMAGE ZOOM ---------- */
  var isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

  if (!isTouchDevice && MAIN_IMG && ZOOM_LENS && ZOOM_RESULT) {
    var wrapper = MAIN_IMG.closest('.gallery-main-image-wrapper');
    var ZOOM = 2.5;

    function showZoom(e) {
      ZOOM_LENS.style.display = 'block';
      ZOOM_RESULT.style.display = 'block';

      var rect = wrapper.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var lensW = ZOOM_LENS.offsetWidth / 2;
      var lensH = ZOOM_LENS.offsetHeight / 2;

      var lx = Math.min(Math.max(x - lensW, 0), rect.width - ZOOM_LENS.offsetWidth);
      var ly = Math.min(Math.max(y - lensH, 0), rect.height - ZOOM_LENS.offsetHeight);

      ZOOM_LENS.style.left = lx + 'px';
      ZOOM_LENS.style.top = ly + 'px';

      var px = (lx / (rect.width - ZOOM_LENS.offsetWidth)) * 100;
      var py = (ly / (rect.height - ZOOM_LENS.offsetHeight)) * 100;

      ZOOM_RESULT.style.backgroundPosition = px + '% ' + py + '%';
      ZOOM_RESULT.style.backgroundImage = 'url(' + MAIN_IMG.getAttribute('data-zoom') + ')';
    }

    function hideZoom() {
      ZOOM_LENS.style.display = 'none';
      ZOOM_RESULT.style.display = 'none';
    }

    wrapper.addEventListener('mouseenter', function() { ZOOM_RESULT.style.backgroundSize = (ZOOM * 100) + '%'; });
    wrapper.addEventListener('mousemove', showZoom);
    wrapper.addEventListener('mouseleave', hideZoom);
  }

  /* ---------- FULLSCREEN LIGHTBOX ---------- */
  function openLightbox(index) {
    currentIndex = index || 0;
    LIGHTBOX_IMG.setAttribute('src', images[currentIndex]);
    LIGHTBOX_COUNTER.textContent = (currentIndex + 1) + ' / ' + images.length;
    LIGHTBOX.classList.add('active');
    document.body.style.overflow = 'hidden';
    updateNavButtons();
  }

  function closeLightbox() {
    try { LIGHTBOX.classList.remove('active'); } catch (e) {}
    document.body.style.overflow = '';
  }

  function resetBodyOverflow() {
    document.body.style.overflow = '';
  }

  window.addEventListener('beforeunload', resetBodyOverflow);

  function goToPrev() {
    if (currentIndex > 0) {
      setActiveImage(currentIndex - 1);
      openLightbox(currentIndex);
    }
  }

  function goToNext() {
    if (currentIndex < images.length - 1) {
      setActiveImage(currentIndex + 1);
      openLightbox(currentIndex);
    }
  }

  function updateNavButtons() {
    if (LIGHTBOX_PREV) LIGHTBOX_PREV.style.display = currentIndex > 0 ? 'flex' : 'none';
    if (LIGHTBOX_NEXT) LIGHTBOX_NEXT.style.display = currentIndex < images.length - 1 ? 'flex' : 'none';
  }

  if (FULLSCREEN_BTN) FULLSCREEN_BTN.addEventListener('click', function() { openLightbox(currentIndex); });
  if (LIGHTBOX_CLOSE) LIGHTBOX_CLOSE.addEventListener('click', closeLightbox);
  if (LIGHTBOX_PREV) LIGHTBOX_PREV.addEventListener('click', goToPrev);
  if (LIGHTBOX_NEXT) LIGHTBOX_NEXT.addEventListener('click', goToNext);

  MAIN_IMG.addEventListener('click', function() { openLightbox(currentIndex); });

  document.addEventListener('keydown', function(e) {
    if (!LIGHTBOX.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') goToPrev();
    if (e.key === 'ArrowRight') goToNext();
  });

  LIGHTBOX.addEventListener('click', function(e) {
    if (e.target === LIGHTBOX) closeLightbox();
  });

  /* ---------- QUANTITY STEPPER ---------- */
  var QTY_INPUT = document.getElementById('qtyInput');
  var QTY_PLUS = document.getElementById('qtyPlus');
  var QTY_MINUS = document.getElementById('qtyMinus');
  var CART_QTY = document.getElementById('cartQtyInput');
  var BUY_NOW_QTY = document.getElementById('buyNowQtyInput');
  var MAX_QTY = parseInt(QTY_INPUT.getAttribute('max'), 10) || 99;

  function updateQty(val) {
    var v = parseInt(val, 10);
    if (isNaN(v) || v < 1) v = 1;
    if (v > MAX_QTY) v = MAX_QTY;
    QTY_INPUT.value = v;
    if (CART_QTY) CART_QTY.value = v;
    if (BUY_NOW_QTY) BUY_NOW_QTY.value = v;
    QTY_MINUS.disabled = v <= 1;
    QTY_PLUS.disabled = v >= MAX_QTY;
  }

  if (QTY_PLUS) QTY_PLUS.addEventListener('click', function() { updateQty(parseInt(QTY_INPUT.value, 10) + 1); });
  if (QTY_MINUS) QTY_MINUS.addEventListener('click', function() { updateQty(parseInt(QTY_INPUT.value, 10) - 1); });

  /* ---------- TABS ---------- */
  var TABS = document.querySelectorAll('.detail-tab');
  var TAB_CONTENTS = document.querySelectorAll('.detail-tab-content');

  TABS.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = this.getAttribute('data-tab');
      TABS.forEach(function(t) { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      TAB_CONTENTS.forEach(function(c) { c.classList.remove('active'); });
      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');
      var content = document.getElementById('tab-' + target);
      if (content) content.classList.add('active');
    });
  });

  /* ---------- REVIEW STAR RATING ---------- */
  var STARS_CONTAINER = document.getElementById('reviewStars');
  if (STARS_CONTAINER) {
    var STAR_BTNS = STARS_CONTAINER.querySelectorAll('.review-star-btn');
    var RATING_INPUT = document.getElementById('ratingValue');
    var HINT = document.getElementById('reviewHint');
    var FORM = document.getElementById('reviewForm');
    var selectedRating = 5;
    var hoveredRating = -1;

    function renderStars() {
      STAR_BTNS.forEach(function(btn, i) {
        var active = hoveredRating >= 0 ? i <= hoveredRating : i < selectedRating;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      if (RATING_INPUT) RATING_INPUT.value = selectedRating;
    }

    STAR_BTNS.forEach(function(btn, i) {
      btn.addEventListener('mouseenter', function() { hoveredRating = i; renderStars(); });
      btn.addEventListener('mouseleave', function() { hoveredRating = -1; renderStars(); });
      btn.addEventListener('click', function() { selectedRating = i + 1; renderStars(); });
      btn.addEventListener('focus', function() { hoveredRating = i; renderStars(); });
      btn.addEventListener('blur', function() { hoveredRating = -1; renderStars(); });
    });

    if (FORM) {
      FORM.addEventListener('submit', function(e) {
        if (selectedRating < 1 || selectedRating > 5) {
          e.preventDefault();
          if (HINT) HINT.textContent = '<%= t('shop:reviews.ratingHint') %>';
          return;
        }
        if (HINT) HINT.textContent = '';
      });
    }

    renderStars();
  }

  /* ---------- SHARE BUTTON ---------- */
  var SHARE_BTN = document.getElementById('shareBtn');
  if (SHARE_BTN) {
    SHARE_BTN.addEventListener('click', function() {
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function() {});
      } else {
        navigator.clipboard.writeText(url).then(function() {
          var original = SHARE_BTN.innerHTML;
          SHARE_BTN.innerHTML = '<i class="fa-solid fa-check"></i>';
          SHARE_BTN.classList.add('active');
          setTimeout(function() { SHARE_BTN.innerHTML = original; SHARE_BTN.classList.remove('active'); }, 2000);
        }).catch(function() {});
      }
    });
  }

  /* ---------- AOS (scroll animations) ---------- */
  var aosEls = document.querySelectorAll('[data-aos]');
  if (aosEls.length > 0) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('aos-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    aosEls.forEach(function(el) { observer.observe(el); });
  }

  /* ---------- SMOOTH SCROLL TO TABS ---------- */
  if (TABS.length > 0) {
    TABS.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.getAttribute('data-tab');
        if (target === 'reviews') {
          var reviewsPanel = document.getElementById('tab-reviews');
          if (reviewsPanel) {
            setTimeout(function() {
              reviewsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }
      });
    });
  }

})();
</script>

