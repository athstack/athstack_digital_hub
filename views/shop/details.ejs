<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="/shop" class="text-muted text-decoration-none">Shop</a></li>
                <li class="breadcrumb-item active text-primary"><%= product.name %></li>
            </ol>
        </nav>

        <% if (product) { %>
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="glass-card no-lift p-3">
                    <div class="rounded bg-dark d-flex align-items-center justify-content-center" style="height:400px;overflow:hidden;">
                        <%- include('../partials/productImage', { src: product.main_image ? '/uploads/products/' + product.main_image : '', alt: product.name, style: 'max-height:380px;object-fit:contain;' }) %>
                    </div>
                </div>
                <% if (gallery && gallery.length > 0) { %>
                <div class="row g-2 mt-2">
                    <% gallery.forEach(img => { %>
                    <div class="col-3">
                        <div class="glass-card no-lift p-1">
                            <%- include('../partials/productImage', { src: img.image_path ? '/uploads/products/' + img.image_path : '', alt: 'Gallery', style: 'height:80px;width:100%;object-fit:cover;', className: 'img-fluid rounded' }) %>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>

            <div class="col-lg-6">
                <span class="text-muted small"><%= product.category_name || 'General' %></span>
                <h1 class="text-white fw-bold mt-2 mb-3"><%= product.name %></h1>

                <div class="d-flex align-items-center mb-3">
                    <% if (product.rating) { %>
                    <div class="text-warning me-2">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <i class="fa-<%= i <= Math.round(product.rating) ? 'solid' : 'regular' %> fa-star"></i>
                        <% } %>
                    </div>
                    <small class="text-muted">(<%= product.rating %> / 5)</small>
                    <% } %>
                    <% if (product.total_sales) { %>
                    <small class="text-muted ms-3"><i class="fa-solid fa-fire me-1"></i><%= product.total_sales %> sold</small>
                    <% } %>
                </div>

                <div class="mb-4">
                    <% if (product.discount_price && product.discount_price < product.price) { %>
                        <span class="display-6 text-primary fw-bold"><%= formatCurrency(product.discount_price) %></span>
                        <span class="text-muted text-decoration-line-through fs-5 ms-2"><%= formatCurrency(product.price) %></span>
                        <span class="badge bg-danger ms-2">Save <%= formatCurrency(product.price - product.discount_price) %></span>
                    <% } else { %>
                        <span class="display-6 text-primary fw-bold"><%= formatCurrency(product.price) %></span>
                    <% } %>
                </div>

                <div class="mb-4">
                    <% if (product.stock_quantity > 0) { %>
                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> In Stock (<%= product.stock_quantity %> available)</span>
                    <% } else { %>
                        <span class="badge bg-danger"><i class="fa-solid fa-times me-1"></i> Out of Stock</span>
                    <% } %>
                </div>

                <div class="mb-4">
                    <h6 class="text-white fw-bold">Description</h6>
                    <p class="text-muted"><%= product.description || 'No description available.' %></p>
                </div>

                <% if (product.sku) { %>
                <div class="mb-3">
                    <small class="text-muted">SKU: <span class="text-secondary"><%= product.sku %></span></small>
                </div>
                <% } %>

                <% if (product.stock_quantity > 0) { %>
                <form method="POST" action="/cart/add" class="d-flex align-items-center gap-3 mb-4">
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <div class="input-group" style="width:140px;">
                        <span class="input-group-text"><i class="fa-solid fa-cubes"></i></span>
                        <input type="number" name="quantity" class="form-control" value="1" min="1" max="<%= product.stock_quantity %>">
                    </div>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-cart-plus me-2"></i>Add to Cart</button>
                </form>
                <% } %>

                <% if (product.technician_first_name) { %>
                <div class="glass-card no-lift p-3 mt-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                            <i class="fa-solid fa-user text-white"></i>
                        </div>
                        <div class="ms-3">
                            <small class="text-muted">Listed by</small>
                            <h6 class="text-white mb-0"><%= product.technician_first_name %> <%= product.technician_last_name %></h6>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
        <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-exclamation-triangle fa-4x mb-3"></i>
            <h4 class="text-white fw-bold">Product Not Found</h4>
            <p class="text-muted">The product you're looking for doesn't exist or has been removed.</p>
            <a href="/shop" class="btn btn-premium-primary rounded-pill">Back to Shop</a>
        </div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>
