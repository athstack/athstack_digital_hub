    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="<%= t('shop:words.nextImage') %>"><i class="fa-solid fa-chevron-right"></i></button>
    <div class="lightbox-counter" id="lightboxCounter"></div>
