<%- include('../partials/header') %>

<section class="product-detail-section">
  <div class="container">
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
      <i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
      <i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (product) { %>

    <nav aria-label="breadcrumb" class="product-breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <% if (product.category_slug) { %>
        <li class="breadcrumb-item"><a href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a></li>
        <% } %>
        <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <div class="product-detail-layout">
      <div class="product-detail-gallery" data-aos="fade-up">
        <div class="gallery-main" id="galleryMain">
          <div class="gallery-main-image-wrapper">
            <%
              var mainImg = product.main_image ? imageUrl(product.main_image, 'products') : '/uploads/products/no-image.svg';
            %>
            <img id="galleryMainImg"
                 src="<%= mainImg %>"
                 alt="<%= product.name %>"
                 class="gallery-main-image"
                 data-zoom="<%= mainImg %>"
                 onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
            <div class="gallery-zoom-lens" id="galleryZoomLens"></div>
            <div class="gallery-zoom-result" id="galleryZoomResult"></div>
            <div class="gallery-fullscreen-btn" id="galleryFullscreenBtn" title="View full size" aria-label="Open image fullscreen">
              <i class="fa-solid fa-expand"></i>
            </div>
          </div>
          <div class="gallery-loader-skeleton" id="gallerySkeleton">
            <div class="skeleton-pulse"></div>
          </div>
        </div>

        <div class="gallery-thumbnails" id="galleryThumbnails" role="tablist" aria-label="Product image thumbnails">
          <button class="gallery-thumb active" role="tab" aria-selected="true" aria-label="Main image" data-src="<%= mainImg %>">
            <img src="<%= mainImg %>" alt="" onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
          </button>
          <% if (gallery && gallery.length > 0) {
            gallery.forEach(function(img) {
              var imgSrc = img.image_path ? imageUrl(img.image_path, 'products') : '';
              if (!imgSrc) return;
          %>
          <button class="gallery-thumb" role="tab" aria-selected="false" aria-label="Gallery image" data-src="<%= imgSrc %>">
            <img src="<%= imgSrc %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/uploads/products/no-image.svg';">
          </button>
          <% }); } %>
        </div>
      </div>

      <div class="product-detail-info" data-aos="fade-up" data-aos-delay="100">
        <div class="info-meta">
          <span class="info-category-badge"><%= product.category_name || 'General' %></span>
          <span class="info-brand">TechBridge</span>
        </div>

        <h1 class="info-title"><%= product.name %></h1>

        <div class="info-sku-row">
          <% if (product.sku) { %>
          <span class="info-sku">SKU: <strong><%= product.sku %></strong></span>
          <% } %>
        </div>

        <div class="info-rating-row">
          <% if (avgRating > 0) { %>
          <div class="info-rating-stars" aria-label="<%= avgRating.toFixed(1) %> out of 5 stars">
            <% for (var i = 1; i <= 5; i++) { %>
              <i class="<%= i <= Math.round(avgRating) ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= Math.round(avgRating) ? 'star-filled' : '' %>"></i>
            <% } %>
          </div>
          <span class="info-rating-value"><%= avgRating.toFixed(1) %></span>
          <span class="info-rating-count">(<%= reviewCount %> Review<%= reviewCount !== 1 ? 's' : '' %>)</span>
          <% } else if (product.rating && product.rating > 0) { %>
          <div class="info-rating-stars" aria-label="<%= product.rating %> out of 5 stars">
            <% for (var i = 1; i <= 5; i++) { %>
              <i class="<%= i <= Math.round(product.rating) ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= Math.round(product.rating) ? 'star-filled' : '' %>"></i>
            <% } %>
          </div>
          <span class="info-rating-value"><%= product.rating.toFixed(1) %></span>
          <% } %>
          <% if (product.total_sales && product.total_sales > 10) { %>
          <span class="info-sold"><i class="fa-solid fa-fire"></i> <%= product.total_sales %> sold</span>
          <% } %>
        </div>

        <div class="info-divider"></div>

        <div class="info-price-row">
          <%
            var hasDiscount = product.discount_price && parseFloat(product.discount_price) < parseFloat(product.price);
            var pctSaved = 0;
            if (hasDiscount) {
              pctSaved = calculateDiscount ? calculateDiscount(product.price, product.discount_price) : Math.round(((product.price - product.discount_price) / product.price) * 100);
            }
          %>
          <% if (hasDiscount) { %>
            <span class="info-price-current"><%= formatCurrency(product.discount_price) %></span>
            <span class="info-price-original"><%= formatCurrency(product.price) %></span>
            <span class="info-price-badge">-<%= pctSaved %>%</span>
            <span class="info-price-save">Save <%= formatCurrency(parseFloat(product.price) - parseFloat(product.discount_price)) %></span>
          <% } else { %>
            <span class="info-price-current"><%= formatCurrency(product.price) %></span>
          <% } %>
        </div>

        <div class="info-stock-row">
          <% if (product.stock_quantity > 10) { %>
          <span class="stock-badge in-stock"><span class="stock-dot"></span> In Stock</span>
          <% } else if (product.stock_quantity > 0) { %>
          <span class="stock-badge low-stock"><span class="stock-dot"></span> Only <%= product.stock_quantity %> left in stock</span>
          <% } else { %>
          <span class="stock-badge out-of-stock"><span class="stock-dot"></span> Out of Stock</span>
          <% } %>
        </div>

        <div class="info-meta-row">
          <div class="info-meta-item">
            <i class="fa-solid fa-truck"></i>
            <span>Free delivery <strong>by <%= deliveryDate ? new Date(deliveryDate).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) : 'order now' %></strong></span>
          </div>
          <div class="info-meta-item">
            <i class="fa-solid fa-shield-halved"></i>
            <span><strong>1-Year</strong> Warranty</span>
          </div>
          <div class="info-meta-item">
            <i class="fa-solid fa-rotate-left"></i>
            <span><strong>30-Day</strong> Easy Returns</span>
          </div>
        </div>

        <div class="info-divider"></div>

        <div class="info-quantity-actions">
          <div class="info-quantity">
            <label class="quantity-label" for="qtyInput">Quantity</label>
            <div class="quantity-stepper">
              <button type="button" class="qty-btn qty-minus" id="qtyMinus" aria-label="Decrease quantity" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>>
                <i class="fa-solid fa-minus"></i>
              </button>
              <input type="number" id="qtyInput" class="qty-input" value="1" min="1" max="<%= product.stock_quantity || 1 %>" readonly aria-live="polite">
              <button type="button" class="qty-btn qty-plus" id="qtyPlus" aria-label="Increase quantity" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>>
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </div>

          <div class="info-actions" id="productActions">
            <% if (product.stock_quantity > 0) { %>
            <form method="POST" action="/cart/add" class="info-action-form add-to-cart-form" id="addToCartForm">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
              <input type="hidden" name="product_id" value="<%= product.id %>">
              <input type="hidden" name="quantity" id="cartQtyInput" value="1">
              <button type="submit" class="btn-action btn-add-to-cart" id="addToCartBtn" aria-label="Add to Cart">
                <i class="fa-solid fa-cart-plus"></i>
                <span>Add to Cart</span>
              </button>
            </form>
            <form method="POST" action="/cart/add" class="info-action-form buy-now-form" id="buyNowForm">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
              <input type="hidden" name="product_id" value="<%= product.id %>">
              <input type="hidden" name="quantity" id="buyNowQtyInput" value="1">
              <input type="hidden" name="redirect" value="/checkout">
              <button type="submit" class="btn-action btn-buy-now" id="buyNowBtn" aria-label="Buy Now">
                <i class="fa-solid fa-bolt"></i>
                <span>Buy Now</span>
              </button>
            </form>
            <% } %>
            <div class="info-action-icon-group">
              <% if (user) { %>
              <form method="POST" action="/dashboard/wishlist/<%= isWishlisted ? 'remove' : 'add' %>" class="d-inline">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <button type="submit" class="btn-icon <%= isWishlisted ? 'active' : '' %>" id="wishlistBtn" title="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>" aria-label="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>">
                  <i class="fa-solid fa-heart"></i>
                </button>
              </form>
              <% } %>
              <button type="button" class="btn-icon" id="shareBtn" title="Share this product" aria-label="Share this product">
                <i class="fa-solid fa-share-nodes"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="info-trust-badges">
          <div class="trust-badge"><i class="fa-solid fa-shield-check"></i> Genuine Product</div>
          <div class="trust-badge"><i class="fa-solid fa-lock"></i> Secure Payment</div>
          <div class="trust-badge"><i class="fa-solid fa-rocket"></i> Fast Delivery</div>
          <div class="trust-badge"><i class="fa-solid fa-arrow-rotate-left"></i> Easy Returns</div>
          <div class="trust-badge"><i class="fa-solid fa-award"></i> Warranty</div>
          <div class="trust-badge"><i class="fa-solid fa-headset"></i> 24/7 Support</div>
        </div>

        <div class="info-seller-card">
          <div class="seller-avatar">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="seller-info">
            <div class="seller-name-row">
              <span class="seller-name">TechBridge Digital Hub</span>
              <span class="seller-badge verified">Verified</span>
            </div>
            <div class="seller-meta">
              <span class="seller-rating">
                <i class="fa-solid fa-star star-filled"></i>
                <span>4.9</span>
              </span>
              <span class="seller-response">
                <i class="fa-regular fa-clock"></i> Responds in &lt; 1hr
              </span>
              <span class="seller-products">
                <i class="fa-solid fa-cube"></i> 12 Products
              </span>
            </div>
          </div>
          <a href="/shop" class="seller-visit-btn">Visit Store</a>
        </div>
      </div>
    </div>

    <div class="product-detail-sections" data-aos="fade-up" data-aos-delay="50">
      <div class="product-detail-tabs">
        <button class="detail-tab active" data-tab="specs" role="tab" aria-selected="true">Specifications</button>
        <button class="detail-tab" data-tab="description" role="tab" aria-selected="false">Description</button>
        <button class="detail-tab" data-tab="reviews" role="tab" aria-selected="false">Reviews (<%= reviewCount %>)</button>
      </div>

      <div class="detail-tab-content active" id="tab-specs" role="tabpanel">
        <div class="specs-grid">
          <div class="spec-item"><span class="spec-label">Brand</span><span class="spec-value">TechBridge</span></div>
          <div class="spec-item"><span class="spec-label">Model</span><span class="spec-value"><%= product.sku || product.name %></span></div>
          <div class="spec-item"><span class="spec-label">Category</span><span class="spec-value"><%= product.category_name || 'General' %></span></div>
          <div class="spec-item"><span class="spec-label">Warranty</span><span class="spec-value">1 Year</span></div>
          <div class="spec-item"><span class="spec-label">Material</span><span class="spec-value">Premium Quality</span></div>
          <div class="spec-item"><span class="spec-label">Compatibility</span><span class="spec-value">Windows, macOS, Linux</span></div>
          <div class="spec-item"><span class="spec-label">Returns</span><span class="spec-value">30-Day Easy Returns</span></div>
          <div class="spec-item"><span class="spec-label">Shipping</span><span class="spec-value">Free Worldwide</span></div>
        </div>
      </div>

      <div class="detail-tab-content" id="tab-description" role="tabpanel">
        <div class="description-content">
          <% if (product.description) {
            var descLines = product.description.split('\n').filter(function(l) { return l.trim(); });
            var intro = descLines.length > 0 ? descLines[0] : '';
            var features = descLines.slice(1);
          %>
          <p class="description-intro"><%= intro %></p>
          <% if (features.length > 0) { %>
          <ul class="description-features">
            <% features.forEach(function(f) { %>
            <li><%= f.replace(/^[•\-\*]\s*/, '') %></li>
            <% }); %>
          </ul>
          <% } else { %>
          <ul class="description-features">
            <li>Premium quality product from TechBridge Digital Hub</li>
            <li>Rigorously tested for performance and reliability</li>
            <li>Comes with full manufacturer warranty</li>
            <li>Free shipping and easy returns</li>
            <li>24/7 customer support</li>
          </ul>
          <% } %>
          <% } else { %>
          <p class="description-intro">Premium product from TechBridge Digital Hub.</p>
          <ul class="description-features">
            <li>Highest quality standards</li>
            <li>Tested for performance and durability</li>
            <li>Full manufacturer warranty included</li>
            <li>Free shipping worldwide</li>
            <li>24/7 dedicated customer support</li>
          </ul>
          <% } %>
        </div>
      </div>

      <div class="detail-tab-content" id="tab-reviews" role="tabpanel">
        <!-- Review Summary -->
        <% if (reviewCount > 0) { %>
        <div class="review-summary-card">
          <div class="review-summary-left">
            <div class="review-summary-score"><%= avgRating > 0 ? avgRating.toFixed(1) : (product.rating || 0).toFixed(1) %></div>
            <div class="review-summary-stars">
              <% var avgR = avgRating > 0 ? avgRating : (product.rating || 0); %>
              <% for (var i = 1; i <= 5; i++) { %>
                <i class="<%= i <= Math.round(avgR) ? 'fa-solid' : 'fa-regular' %> fa-star star-filled"></i>
              <% } %>
            </div>
            <div class="review-summary-count"><%= reviewCount %> Review<%= reviewCount !== 1 ? 's' : '' %></div>
          </div>
          <div class="review-summary-bars">
            <% var bars = [5,4,3,2,1];
               var maxBarCount = 0;
               if (reviews && reviews.length > 0) {
                 var ratingCounts = {5:0,4:0,3:0,2:0,1:0};
                 reviews.forEach(function(r) { if (ratingCounts[r.rating] !== undefined) ratingCounts[r.rating]++; });
                 maxBarCount = Math.max.apply(null, Object.values(ratingCounts));
               }
               bars.forEach(function(star) {
                 var pct = maxBarCount > 0 && ratingCounts ? Math.round((ratingCounts[star] / maxBarCount) * 100) : 0;
            %>
            <div class="review-bar-row">
              <span class="review-bar-label"><%= star %> <i class="fa-solid fa-star" style="font-size:0.6rem;"></i></span>
              <div class="review-bar-track">
                <div class="review-bar-fill" style="width:<%= pct %>%"></div>
              </div>
              <span class="review-bar-count"><%= ratingCounts ? ratingCounts[star] : 0 %></span>
            </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Write Review -->
        <% if (user) { %>
        <div class="review-write-card">
          <h3 class="review-write-title"><i class="fa-solid fa-pen me-2 text-primary"></i>Write a Review</h3>
          <form method="POST" action="/reviews/product/<%= product.id %>" id="reviewForm">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <div class="review-write-rating">
              <label class="review-write-label">Your Rating</label>
              <div class="review-stars-input" id="reviewStars" role="radiogroup" aria-label="Rating">
                <% for (var i = 1; i <= 5; i++) { %>
                <button type="button" class="review-star-btn" data-rating="<%= i %>" role="radio" aria-checked="<%= i === 5 ? 'true' : 'false' %>" aria-label="<%= i %> star<%= i > 1 ? 's' : '' %>">
                  <i class="fa-solid fa-star"></i>
                </button>
                <% } %>
              </div>
              <small class="review-hint" id="reviewHint"></small>
              <input type="hidden" name="rating" id="ratingValue" value="5">
            </div>
            <div class="review-write-comment">
              <label class="review-write-label">Comment <span class="text-muted">(optional)</span></label>
              <textarea name="comment" class="review-textarea" rows="3" placeholder="Share your experience with this product..."></textarea>
            </div>
            <div class="review-write-submit">
              <button type="submit" class="btn-action btn-submit-review"><i class="fa-solid fa-paper-plane me-2"></i>Submit Review</button>
            </div>
          </form>
        </div>
        <% } else { %>
        <div class="review-login-card">
          <p class="mb-0"><a href="/auth/login" class="text-primary fw-bold">Login</a> to write a review and share your experience.</p>
        </div>
        <% } %>

        <!-- Review List -->
        <% if (reviews && reviews.length > 0) { %>
        <div class="review-list">
          <% reviews.forEach(function(review) { %>
          <div class="review-item">
            <div class="review-item-header">
              <div class="review-item-avatar">
                <% if (review.avatar) { %>
                <img src="<%= imageUrl(review.avatar, 'profiles') %>" alt="">
                <% } else { %>
                <i class="fa-solid fa-user"></i>
                <% } %>
              </div>
              <div class="review-item-user">
                <span class="review-item-name"><%= formatDisplayName ? formatDisplayName(review.first_name, review.last_name) : (review.first_name + ' ' + review.last_name) %></span>
                <span class="review-item-date"><%= review.created_at ? new Date(review.created_at).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : '' %></span>
              </div>
              <div class="review-item-stars">
                <% for (var i = 1; i <= 5; i++) { %>
                <i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star star-filled"></i>
                <% } %>
              </div>
            </div>
            <% if (review.comment) { %>
            <p class="review-item-comment"><%= review.comment %></p>
            <% } %>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="review-empty">
          <i class="fa-regular fa-comments"></i>
          <p>No reviews yet. Be the first to review this product!</p>
        </div>
        <% } %>
      </div>
    </div>

    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="related-section" data-aos="fade-up">
      <div class="related-header">
        <h2 class="related-title">Related Products</h2>
        <a href="/shop" class="related-view-all">View All <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="product-grid-enhanced">
        <% relatedProducts.forEach(function(rp) { %>
          <%- include('../partials/productCard', { product: rp, csrfToken: csrfToken, formatCurrency: formatCurrency }) %>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% } else { %>
    <div class="empty-state">
      <i class="fa-solid fa-exclamation-triangle fa-4x mb-4"></i>
      <h4 class="text-white fw-bold">Product Not Found</h4>
      <p class="text-white-50">The product you're looking for doesn't exist or has been removed.</p>
      <a href="/shop" class="btn btn-premium-primary rounded-pill px-5">Back to Shop</a>
    </div>
    <% } %>
  </div>
</section>

<!-- Fullscreen Lightbox -->
<div class="lightbox-overlay" id="lightboxOverlay" role="dialog" aria-modal="true" aria-label="Image fullscreen viewer">
  <div class="lightbox-content">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close fullscreen viewer">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous image"><i class="fa-solid fa-chevron-left"></i></button>
    <div class="lightbox-image-wrapper">
      <img id="lightboxImage" src="" alt="">
    </div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next image"><i class="fa-solid fa-chevron-right"></i></button>
    <div class="lightbox-counter" id="lightboxCounter"></div>
  </div>
</div>

<script>
(function() {
  /* ---------- CONFIG ---------- */
  var MAIN_IMG = document.getElementById('galleryMainImg');
  var THUMBS = document.querySelectorAll('.gallery-thumb');
  var ZOOM_LENS = document.getElementById('galleryZoomLens');
  var ZOOM_RESULT = document.getElementById('galleryZoomResult');
  var LIGHTBOX = document.getElementById('lightboxOverlay');
  var LIGHTBOX_IMG = document.getElementById('lightboxImage');
  var LIGHTBOX_CLOSE = document.getElementById('lightboxClose');
  var LIGHTBOX_PREV = document.getElementById('lightboxPrev');
  var LIGHTBOX_NEXT = document.getElementById('lightboxNext');
  var LIGHTBOX_COUNTER = document.getElementById('lightboxCounter');
  var FULLSCREEN_BTN = document.getElementById('galleryFullscreenBtn');
  var SKELETON = document.getElementById('gallerySkeleton');
  var images = [];
  var currentIndex = 0;

  /* Collect all image sources */
  images.push(MAIN_IMG.getAttribute('src'));
  THUMBS.forEach(function(t) {
    var s = t.getAttribute('data-src');
    if (s && images.indexOf(s) === -1) images.push(s);
  });

  /* ---------- SKELETON LOADER ---------- */
  if (SKELETON) {
    var tempImg = new Image();
    tempImg.onload = function() { SKELETON.style.display = 'none'; };
    tempImg.onerror = function() { SKELETON.style.display = 'none'; };
    tempImg.src = MAIN_IMG.getAttribute('src');
    setTimeout(function() { if (SKELETON) SKELETON.style.display = 'none'; }, 3000);
  }

  /* ---------- THUMBNAIL SWITCH ---------- */
  function setActiveImage(index) {
    if (index < 0 || index >= images.length) return;
    currentIndex = index;
    MAIN_IMG.setAttribute('src', images[index]);
    MAIN_IMG.setAttribute('data-zoom', images[index]);
    THUMBS.forEach(function(t, i) {
      t.classList.toggle('active', i === index);
      t.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
  }

  THUMBS.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { setActiveImage(i); });
    thumb.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setActiveImage(i); }
    });
  });

  /* ---------- IMAGE ZOOM ---------- */
  var isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

  if (!isTouchDevice && MAIN_IMG && ZOOM_LENS && ZOOM_RESULT) {
    var wrapper = MAIN_IMG.closest('.gallery-main-image-wrapper');
    var ZOOM = 2.5;

    function showZoom(e) {
      ZOOM_LENS.style.display = 'block';
      ZOOM_RESULT.style.display = 'block';

      var rect = wrapper.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var lensW = ZOOM_LENS.offsetWidth / 2;
      var lensH = ZOOM_LENS.offsetHeight / 2;

      var lx = Math.min(Math.max(x - lensW, 0), rect.width - ZOOM_LENS.offsetWidth);
      var ly = Math.min(Math.max(y - lensH, 0), rect.height - ZOOM_LENS.offsetHeight);

      ZOOM_LENS.style.left = lx + 'px';
      ZOOM_LENS.style.top = ly + 'px';

      var px = (lx / (rect.width - ZOOM_LENS.offsetWidth)) * 100;
      var py = (ly / (rect.height - ZOOM_LENS.offsetHeight)) * 100;

      ZOOM_RESULT.style.backgroundPosition = px + '% ' + py + '%';
      ZOOM_RESULT.style.backgroundImage = 'url(' + MAIN_IMG.getAttribute('data-zoom') + ')';
    }

    function hideZoom() {
      ZOOM_LENS.style.display = 'none';
      ZOOM_RESULT.style.display = 'none';
    }

    wrapper.addEventListener('mouseenter', function() { ZOOM_RESULT.style.backgroundSize = (ZOOM * 100) + '%'; });
    wrapper.addEventListener('mousemove', showZoom);
    wrapper.addEventListener('mouseleave', hideZoom);
  }

  /* ---------- FULLSCREEN LIGHTBOX ---------- */
  function openLightbox(index) {
    currentIndex = index || 0;
    LIGHTBOX_IMG.setAttribute('src', images[currentIndex]);
    LIGHTBOX_COUNTER.textContent = (currentIndex + 1) + ' / ' + images.length;
    LIGHTBOX.classList.add('active');
    document.body.style.overflow = 'hidden';
    updateNavButtons();
  }

  function closeLightbox() {
    try { LIGHTBOX.classList.remove('active'); } catch (e) {}
    document.body.style.overflow = '';
  }

  function resetBodyOverflow() {
    document.body.style.overflow = '';
  }

  if (LIGHTBOX) {
    LIGHTBOX.addEventListener('beforeunload', resetBodyOverflow);
  }

  function goToPrev() {
    if (currentIndex > 0) {
      setActiveImage(currentIndex - 1);
      openLightbox(currentIndex);
    }
  }

  function goToNext() {
    if (currentIndex < images.length - 1) {
      setActiveImage(currentIndex + 1);
      openLightbox(currentIndex);
    }
  }

  function updateNavButtons() {
    if (LIGHTBOX_PREV) LIGHTBOX_PREV.style.display = currentIndex > 0 ? 'flex' : 'none';
    if (LIGHTBOX_NEXT) LIGHTBOX_NEXT.style.display = currentIndex < images.length - 1 ? 'flex' : 'none';
  }

  if (FULLSCREEN_BTN) FULLSCREEN_BTN.addEventListener('click', function() { openLightbox(currentIndex); });
  if (LIGHTBOX_CLOSE) LIGHTBOX_CLOSE.addEventListener('click', closeLightbox);
  if (LIGHTBOX_PREV) LIGHTBOX_PREV.addEventListener('click', goToPrev);
  if (LIGHTBOX_NEXT) LIGHTBOX_NEXT.addEventListener('click', goToNext);

  MAIN_IMG.addEventListener('click', function() { openLightbox(currentIndex); });

  document.addEventListener('keydown', function(e) {
    if (!LIGHTBOX.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') goToPrev();
    if (e.key === 'ArrowRight') goToNext();
  });

  LIGHTBOX.addEventListener('click', function(e) {
    if (e.target === LIGHTBOX) closeLightbox();
  });

  /* ---------- QUANTITY STEPPER ---------- */
  var QTY_INPUT = document.getElementById('qtyInput');
  var QTY_PLUS = document.getElementById('qtyPlus');
  var QTY_MINUS = document.getElementById('qtyMinus');
  var CART_QTY = document.getElementById('cartQtyInput');
  var BUY_NOW_QTY = document.getElementById('buyNowQtyInput');
  var MAX_QTY = parseInt(QTY_INPUT.getAttribute('max'), 10) || 99;

  function updateQty(val) {
    var v = parseInt(val, 10);
    if (isNaN(v) || v < 1) v = 1;
    if (v > MAX_QTY) v = MAX_QTY;
    QTY_INPUT.value = v;
    if (CART_QTY) CART_QTY.value = v;
    if (BUY_NOW_QTY) BUY_NOW_QTY.value = v;
    QTY_MINUS.disabled = v <= 1;
    QTY_PLUS.disabled = v >= MAX_QTY;
  }

  if (QTY_PLUS) QTY_PLUS.addEventListener('click', function() { updateQty(parseInt(QTY_INPUT.value, 10) + 1); });
  if (QTY_MINUS) QTY_MINUS.addEventListener('click', function() { updateQty(parseInt(QTY_INPUT.value, 10) - 1); });

  /* ---------- TABS ---------- */
  var TABS = document.querySelectorAll('.detail-tab');
  var TAB_CONTENTS = document.querySelectorAll('.detail-tab-content');

  TABS.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = this.getAttribute('data-tab');
      TABS.forEach(function(t) { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      TAB_CONTENTS.forEach(function(c) { c.classList.remove('active'); });
      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');
      var content = document.getElementById('tab-' + target);
      if (content) content.classList.add('active');
    });
  });

  /* ---------- REVIEW STAR RATING ---------- */
  var STARS_CONTAINER = document.getElementById('reviewStars');
  if (STARS_CONTAINER) {
    var STAR_BTNS = STARS_CONTAINER.querySelectorAll('.review-star-btn');
    var RATING_INPUT = document.getElementById('ratingValue');
    var HINT = document.getElementById('reviewHint');
    var FORM = document.getElementById('reviewForm');
    var selectedRating = 5;
    var hoveredRating = -1;

    function renderStars() {
      STAR_BTNS.forEach(function(btn, i) {
        var active = hoveredRating >= 0 ? i <= hoveredRating : i < selectedRating;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      if (RATING_INPUT) RATING_INPUT.value = selectedRating;
    }

    STAR_BTNS.forEach(function(btn, i) {
      btn.addEventListener('mouseenter', function() { hoveredRating = i; renderStars(); });
      btn.addEventListener('mouseleave', function() { hoveredRating = -1; renderStars(); });
      btn.addEventListener('click', function() { selectedRating = i + 1; renderStars(); });
      btn.addEventListener('focus', function() { hoveredRating = i; renderStars(); });
      btn.addEventListener('blur', function() { hoveredRating = -1; renderStars(); });
    });

    if (FORM) {
      FORM.addEventListener('submit', function(e) {
        if (selectedRating < 1 || selectedRating > 5) {
          e.preventDefault();
          if (HINT) HINT.textContent = 'Please select a rating between 1 and 5.';
          return;
        }
        if (HINT) HINT.textContent = '';
      });
    }

    renderStars();
  }

  /* ---------- SHARE BUTTON ---------- */
  var SHARE_BTN = document.getElementById('shareBtn');
  if (SHARE_BTN) {
    SHARE_BTN.addEventListener('click', function() {
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function() {});
      } else {
        navigator.clipboard.writeText(url).then(function() {
          var original = SHARE_BTN.innerHTML;
          SHARE_BTN.innerHTML = '<i class="fa-solid fa-check"></i>';
          SHARE_BTN.classList.add('active');
          setTimeout(function() { SHARE_BTN.innerHTML = original; SHARE_BTN.classList.remove('active'); }, 2000);
        }).catch(function() {});
      }
    });
  }

  /* ---------- AOS (scroll animations) ---------- */
  var aosEls = document.querySelectorAll('[data-aos]');
  if (aosEls.length > 0) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('aos-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    aosEls.forEach(function(el) { observer.observe(el); });
  }

  /* ---------- SMOOTH SCROLL TO TABS ---------- */
  if (TABS.length > 0) {
    TABS.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.getAttribute('data-tab');
        if (target === 'reviews') {
          var reviewsPanel = document.getElementById('tab-reviews');
          if (reviewsPanel) {
            setTimeout(function() {
              reviewsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }
      });
    });
  }

})();
</script>

