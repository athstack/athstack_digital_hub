<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/training" class="text-muted text-decoration-none small">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Academy Tracks
            </a>
            <h1 class="fw-bold text-white mt-3"><%= course.title || 'Course Details' %></h1>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4 border border-secondary mb-4">
                <h3 class="text-white h5 fw-bold mb-3">Syllabus Overview</h3>
                <p class="text-muted"><%= course.description || '' %></p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card p-4 border border-secondary">
                <h3 class="text-white h5 fw-bold mb-3">Program Metrics</h3>
                <ul class="list-unstyled text-muted small">
                    <li class="mb-2"><i class="fa-solid fa-calendar me-2 text-primary"></i>Duration: <%= course.duration || '0' %></li>
                    <li class="mb-3"><i class="fa-solid fa-credit-card me-2 text-primary"></i>Tuition: $<%= parseFloat(course.price || 0).toFixed(2) %></li>
                </ul>
                <button class="btn btn-premium-primary w-100 rounded-pill">Enroll in Node</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
