<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-widest small">Professional Engineering Academy</span>
            <h1 class="text-white fw-bold mt-2">Training & Certification</h1>
            <p class="text-muted">Advance your career with expert-led technical courses and professional certification programs.</p>
        </div>

        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <% if (courses && courses.length > 0) { %>
        <div class="row g-4">
            <% courses.forEach(course => { %>
            <div class="col-md-4">
                <a href="/training/<%= course.slug %>" class="text-decoration-none">
                    <div class="glass-card p-4 h-100">
                        <div class="rounded bg-dark mb-3 d-flex align-items-center justify-content-center" style="height:180px;overflow:hidden;">
                             <%- include('../partials/productImage', { src: course.image_path ? '/uploads/courses/' + course.image_path : '', alt: course.title, style: 'max-height:170px;object-fit:contain;' }) %>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary me-2"><%= course.level || 'Beginner' %></span>
                            <% if (course.duration) { %>
                                <small class="text-muted"><i class="fa-regular fa-clock me-1"></i><%= course.duration %></small>
                            <% } %>
                        </div>
                        <h5 class="text-white fw-bold mb-2"><%= course.title %></h5>
                        <p class="text-muted small mb-3"><%= course.description ? course.description.substring(0, 140) + '...' : '' %></p>
                        <div class="d-flex justify-content-between align-items-center">
                                 <% if (course.price > 0) { %>
                                <span class="text-primary fw-bold fs-5"><%= formatCurrency(course.price) %></span>
                            <% } else { %>
                                <span class="text-success fw-bold fs-5">Free</span>
                            <% } %>
                            <span class="text-muted small"><i class="fa-solid fa-user-tie me-1"></i><%= course.instructor_first_name || 'Athstack' %> <%= course.instructor_last_name || '' %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-graduation-cap fa-4x mb-3"></i>
            <h4 class="text-white fw-bold">Courses Coming Soon</h4>
            <p class="text-muted">We're preparing exciting new training programs. Check back shortly.</p>
        </div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>
