<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>

            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('admin:words.users') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-key me-2 text-primary"></i><%= t('admin:title.permissionManagement') %></h2>
                    <button type="button" class="btn btn-premium-primary btn-sm rounded-pill ms-auto" id="addPermissionBtn"><i class="fa-solid fa-plus me-1"></i><%= t('admin:permissionManagement.addPermission') %></button>
                </div>

                <div data-crud-table data-crud-url="/admin/permissions">
                    <%- include('./partials/permissionsList') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Permission modal -->
<div class="modal fade crud-modal" id="addPermissionModal" tabindex="-1" aria-labelledby="addPermissionModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="addPermissionForm" method="POST" action="/admin/permissions/add" novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title" id="addPermissionModalTitle"><i class="fa-solid fa-plus me-2 text-primary"></i><%= t('admin:permissionManagement.addPermission') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="ap-permission"><%= t('admin:permissionManagement.permissionName') %></label>
                        <input type="text" name="permission" id="ap-permission" class="form-control" placeholder="manage_coupons" pattern="[a-z][a-z0-9_]{1,99}" required>
                        <div class="invalid-feedback"><%= t('admin:flash.invalidPermissionName') %></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ap-module"><%= t('admin:permissionManagement.module') %></label>
                        <select name="module" id="ap-module" class="form-select bg-dark text-white border-secondary">
                            <% const modules = [...new Set(permissions.map(p => p.module || 'general'))]; %>
                            <% modules.forEach(m => { %>
                            <option value="<%= m %>"><%= m %></option>
                            <% }) %>
                            <option value="general">general</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="ap-description"><%= t('admin:permissionManagement.description') %></label>
                        <input type="text" name="description" id="ap-description" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i><%= t('admin:permissionManagement.addPermission') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var tableWrap = document.querySelector('[data-crud-table]');
    var addBtn = document.getElementById('addPermissionBtn');
    var addModalEl = document.getElementById('addPermissionModal');
    var addForm = document.getElementById('addPermissionForm');

    var i18n = {
        permissionAdded: '<%= t('admin:flash.permissionAdded') %>',
        updateFailed: '<%= t('admin:permissionManagement.updateFailed') %>',
        cancel: '<%= t('common:words.cancel') %>',
        add: '<%= t('admin:permissionManagement.addPermission') %>'
    };

    addBtn.addEventListener('click', function () {
        addForm.reset();
        Crud.clearErrors(addForm);
        Crud.openModal(addModalEl);
    });

    addForm.addEventListener('submit', function (e) {
        e.preventDefault();
        Crud.submitForm(addForm, {
            onSuccess: function (data) {
                Crud.closeModal(addModalEl);
                Crud.toast(data.message || i18n.permissionAdded, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/admin/permissions' });
            }
        });
    });

    Crud.initTable(tableWrap);
});
</script>

<%- include('../partials/footer') %>
