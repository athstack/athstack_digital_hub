<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>

            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.admin') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-gauge-high me-2 text-primary"></i><%= t('admin:dashboard.heading') %></h2>
                </div>

                <% if (typeof metrics === 'undefined' || !metrics) { metrics = { revenue: 0, total_clients: 0, total_products: 0, pending_bookings: 0, total_orders: 0, pending_orders: 0, unread_messages: 0, pending_reviews: 0, recent_orders: [], recent_bookings: [] }; } %>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-dollar-sign fa-2x text-success mb-2"></i>
                            <h4 class="text-white fw-bold mb-0"><%= formatCurrency(metrics.revenue) %></h4>
                            <p class="text-white-50 small mb-0"><%= t('admin:words.revenue') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-users fa-2x text-primary mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.total_clients %></h3>
                            <p class="text-white-50 small mb-0"><%= t('admin:words.customers') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-box-open fa-2x text-info mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.total_products %></h3>
                            <p class="text-white-50 small mb-0"><%= t('admin:words.products') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-wrench fa-2x text-warning mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.pending_bookings %></h3>
                            <p class="text-white-50 small mb-0"><%= t('admin:words.pendingRepairs') %></p>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:words.totalOrders') %></small>
                            <h5 class="text-white fw-bold mb-0"><%= metrics.total_orders %></h5>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:words.pendingOrders') %></small>
                            <h5 class="text-white fw-bold mb-0"><%= metrics.pending_orders %></h5>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:words.unreadMessages') %></small>
                            <h5 class="text-white fw-bold mb-0"><%= metrics.unread_messages %></h5>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:words.pendingReviews') %></small>
                            <h5 class="text-warning fw-bold mb-0"><%= metrics.pending_reviews %></h5>
                        </div>
                    </div>
                </div>

                <% if (can('view_system_reports')) { %>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:dashboard.activeCampaigns') %></small>
                            <h5 class="text-primary fw-bold mb-0"><%= metrics.active_campaigns %></h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:dashboard.websiteVisitors') %></small>
                            <h5 class="text-primary fw-bold mb-0"><%= metrics.website_visitors %></h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:dashboard.pendingApprovals') %></small>
                            <h5 class="text-warning fw-bold mb-0"><%= metrics.pending_approvals %></h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <small class="text-white-50"><%= t('admin:dashboard.totalUsers') %></small>
                            <h5 class="text-primary fw-bold mb-0"><%= metrics.total_users %></h5>
                        </div>
                    </div>
                </div>
                <% if (systemHealth) { %>
                <div class="glass-card p-4 mb-4">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-heart-pulse me-2 text-success"></i><%= t('admin:dashboard.systemHealth') %></h5>
                    <div class="row g-3 text-center">
                        <div class="col-md-3">
                            <small class="text-white-50 d-block"><%= t('admin:dashboard.database') %></small>
                            <span class="badge <%= systemHealth.database ? 'bg-success' : 'bg-danger' %>"><%= systemHealth.database ? t('admin:dashboard.online') : t('admin:dashboard.offline') %></span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50 d-block"><%= t('admin:dashboard.uptime') %></small>
                            <span class="text-white fw-bold"><%= Math.floor(systemHealth.uptimeSeconds / 3600) %>h <%= Math.floor((systemHealth.uptimeSeconds % 3600) / 60) %>m</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50 d-block"><%= t('admin:dashboard.memory') %></small>
                            <span class="text-white fw-bold"><%= systemHealth.memoryMB %> MB</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-white-50 d-block"><%= t('admin:dashboard.nodeVersion') %></small>
                            <span class="text-white fw-bold"><%= systemHealth.nodeVersion %></span>
                        </div>
                    </div>
                </div>
                <% } %>
                <% } %>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="glass-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-wrench me-2 text-primary"></i><%= t('admin:dashboard.recentRepairs') %></h5>
                                <a href="/admin/repairs" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('common:words.viewAll') %></a>
                            </div>
                            <% if (recentBookings && recentBookings.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-dark table-sm align-middle mb-0 premium-table">
                                    <thead><tr><th><%= t('admin:dashboard.colRef') %></th><th><%= t('admin:words.customer') %></th><th><%= t('common:words.status') %></th></tr></thead>
                                    <tbody>
                                        <% recentBookings.forEach(b => { %>
                                        <tr>
                                            <td class="text-white"><%= b.reference_number || 'N/A' %></td>
                                            <td class="text-white-50"><%= b.customer_name %></td>
                                            <td><span class="badge <%= b.status === 'completed' ? 'bg-success' : (b.status === 'pending' ? 'bg-warning text-dark' : 'bg-primary') %>"><%= t('admin:status.' + (b.status||'').toLowerCase(), {defaultValue: b.status}) %></span></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                            <p class="text-white-50 text-center mb-0"><%= t('admin:dashboard.noRecentRepairs') %></p>
                            <% } %>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="glass-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-receipt me-2 text-info"></i><%= t('admin:dashboard.recentOrders') %></h5>
                                <a href="/admin/orders" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('common:words.viewAll') %></a>
                            </div>
                            <% if (recentOrders && recentOrders.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-dark table-sm align-middle mb-0 premium-table">
                                    <thead><tr><th><%= t('admin:words.order') %></th><th><%= t('admin:words.customer') %></th><th><%= t('admin:words.amount') %></th></tr></thead>
                                    <tbody>
                                        <% recentOrders.forEach(o => { %>
                                        <tr>
                                            <td class="text-white">#<%= o.id %></td>
                                            <td class="text-white-50"><%= formatDisplayName(o.first_name, o.last_name) %></td>
                                            <td class="text-primary fw-bold"><%= formatCurrency(o.total_amount) %></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                            <p class="text-white-50 text-center mb-0"><%= t('admin:dashboard.noRecentOrders') %></p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
