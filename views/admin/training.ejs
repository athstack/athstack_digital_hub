<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge">Training</span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-graduation-cap me-2 text-primary"></i>Training Academy</h2>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-premium-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addCourseModal"><i class="fa-solid fa-plus me-2"></i>Add Course</button>
                    </div>
                </div>

                <div class="modal fade" id="addCourseModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                            <form method="POST" action="/admin/training/add" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                <div class="modal-header border-secondary">
                                    <h5 class="text-white fw-bold">Create New Course</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label">Course Title *</label>
                                            <input type="text" name="title" class="form-control" required placeholder="e.g. Advanced Network Engineering">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Description</label>
                                            <textarea name="description" class="form-control" rows="3" placeholder="Course description..."></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Duration</label>
                                            <input type="text" name="duration" class="form-control" placeholder="e.g. 8 weeks">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Level</label>
                                            <select name="level" class="form-select">
                                                <option value="Beginner">Beginner</option>
                                                <option value="Intermediate">Intermediate</option>
                                                <option value="Advanced">Advanced</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Price ($)</label>
                                            <input type="number" name="price" class="form-control" min="0" step="0.01" value="0">
                                        </div>
                                        <div class="col-12">
                                            <%- include('../partials/fileUpload', {
                                                name: 'course_image',
                                                label: 'Course Image',
                                                hint: 'PNG, JPG, WEBP up to 5MB',
                                                accept: 'image/*'
                                            }) %>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-premium-primary rounded-pill">Create Course</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <% if (modules && modules.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr><th>Course</th><th>Level</th><th>Duration</th><th>Price</th><th>Enrollments</th><th>Status</th><th>Actions</th></tr>
                            </thead>
                            <tbody>
                                <% modules.forEach(mod => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded bg-dark me-2 d-flex align-items-center justify-content-center" style="width:42px;height:42px;overflow:hidden;flex-shrink:0;">
                                                 <%- include('../partials/productImage', { src: mod.image_path ? imageUrl(mod.image_path, 'courses') : '', alt: mod.title, style: 'max-height:38px;object-fit:contain;' }) %>
                                            </div>
                                            <div>
                                                <span class="text-white fw-bold"><%= mod.title %></span>
                                                <% if (mod.instructor_first_name) { %><br><small class="text-white-50"><%= formatDisplayName(mod.instructor_first_name, mod.instructor_last_name) %></small><% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary rounded-pill"><%= mod.level || 'Beginner' %></span></td>
                                    <td class="text-white-50"><%= mod.duration || 'N/A' %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(mod.price) %></td>
                                    <td class="text-white-50"><%= mod.enrollment_count || 0 %></td>
                                    <td><span class="badge <%= mod.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= mod.status %></span></td>
                                    <td>
                                        <form method="POST" action="/admin/training/delete/<%= mod.id %>" class="d-inline" data-confirm="Delete this course?">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-graduation-cap fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Courses Yet</h4>
                    <p class="text-white-50">Create your first training course to get started.</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
