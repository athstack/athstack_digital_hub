<%- include('../partials/header') %>

<div class="container mt-5">
    <div class="mb-4">
        <a href="/admin" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>
        <a href="/admin/addModule" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus"></i> Add New Module
        </a>
    </div>

    <h1 class="text-white mb-4">Training Academy Modules</h1>

    <div class="glass-card shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-muted">
                        <th class="px-4">ID</th>
                        <th>Course Title</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!modules || modules.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No academy modules registered.</td>
                        </tr>
                    <% } else { %>
                        <% modules.forEach(function(module) { %>
                            <tr>
                                <td class="px-4 text-secondary">#<%= module.id %></td>
                                <td class="fw-medium"><%= module.title %></td>
                                <td class="text-white"><%= module.duration %></td>
                                <td>
                                    <span class="badge <%= module.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                                        <%= module.status ? module.status.charAt(0).toUpperCase() + module.status.slice(1) : 'Draft' %>
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    <a href="/admin/editModule/<%= module.id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form action="/admin/deleteModule/<%= module.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this module?');">
                                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
