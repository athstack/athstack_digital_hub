<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.training') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-graduation-cap me-2 text-primary"></i><%= t('admin:training.heading') %></h2>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-premium-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addCourseModal"><i class="fa-solid fa-plus me-2"></i><%= t('admin:training.addCourse') %></button>
                    </div>
                </div>

                <div class="modal fade" id="addCourseModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                            <form method="POST" action="/admin/training/add" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                <div class="modal-header border-secondary">
                                    <h5 class="text-white fw-bold"><%= t('admin:training.createCourseModal') %></h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label"><%= t('admin:training.courseTitle') %> *</label>
                                            <input type="text" name="title" class="form-control" required placeholder="<%= t('admin:training.courseTitlePlaceholder') %>">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label"><%= t('common:words.description') %></label>
                                            <textarea name="description" class="form-control" rows="3" placeholder="<%= t('admin:training.descriptionPlaceholder') %>"></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.duration') %></label>
                                            <input type="text" name="duration" class="form-control" placeholder="<%= t('admin:training.durationPlaceholder') %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.level') %></label>
                                            <select name="level" class="form-select">
                                                <option value="Beginner"><%= t('admin:training.levelBeginner') %></option>
                                                <option value="Intermediate"><%= t('admin:training.levelIntermediate') %></option>
                                                <option value="Advanced"><%= t('admin:training.levelAdvanced') %></option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.price') %></label>
                                            <input type="number" name="price" class="form-control" min="0" step="0.01" value="0">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.status') %></label>
                                            <select name="status" class="form-select">
                                                <option value="active" selected><%= t('admin:status.active') %></option>
                                                <option value="draft"><%= t('admin:status.draft') %></option>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <%- include('../partials/fileUpload', {
                                                name: 'course_image',
                                                label: t('admin:training.courseImage'),
                                                hint: t('admin:fileUpload.hint'),
                                                accept: 'image/*'
                                            }) %>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                                    <button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('admin:training.createCourse') %></button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <% if (modules && modules.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr><th><%= t('admin:words.course') %></th><th><%= t('admin:training.level') %></th><th><%= t('admin:training.duration') %></th><th><%= t('common:words.price') %></th><th><%= t('admin:words.enrollments') %></th><th><%= t('common:words.status') %></th><th><%= t('common:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% modules.forEach(mod => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded bg-dark me-2 d-flex align-items-center justify-content-center" style="width:42px;height:42px;overflow:hidden;flex-shrink:0;">
                                                 <%- include('../partials/productImage', { src: mod.image_path ? imageUrl(mod.image_path, 'courses') : '', alt: mod.title, style: 'max-height:38px;object-fit:contain;' }) %>
                                            </div>
                                            <div>
                                                <span class="text-white fw-bold"><%= mod.title %></span>
                                                <% if (mod.instructor_first_name) { %><br><small class="text-white-50"><%= formatDisplayName(mod.instructor_first_name, mod.instructor_last_name) %></small><% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary rounded-pill"><%= mod.level === 'Intermediate' ? t('admin:training.levelIntermediate') : mod.level === 'Advanced' ? t('admin:training.levelAdvanced') : t('admin:training.levelBeginner') %></span></td>
                                    <td class="text-white-50"><%= mod.duration || 'N/A' %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(mod.price) %></td>
                                    <td class="text-white-50"><%= mod.enrollment_count || 0 %></td>
                                    <td><span class="badge <%= mod.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= t('admin:status.' + (mod.status||'').toLowerCase(), {defaultValue: mod.status}) %></span></td>
                                    <td>
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abButton:true, abIcon:'fa-pen', abTitle:t('admin:training.editCourse'), abAttrs:'data-bs-toggle="modal" data-bs-target="#editCourseModal' + mod.id + '"' }) %>
                                            <%- include('../partials/actionButton', { abVariant:'delete', abFormAction:'/admin/training/delete/' + mod.id, abFormCsrf:csrfToken, abConfirm:t('admin:training.deleteConfirm'), abTitle:t('common:words.delete') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <% modules.forEach(mod => { %>
                <div class="modal fade" id="editCourseModal<%= mod.id %>" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                            <form method="POST" action="/admin/training/edit/<%= mod.id %>" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                <div class="modal-header border-secondary">
                                    <h5 class="text-white fw-bold"><%= t('admin:training.editCourseModal') %></h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label"><%= t('admin:training.courseTitle') %> *</label>
                                            <input type="text" name="title" class="form-control" required value="<%= mod.title %>">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label"><%= t('common:words.description') %></label>
                                            <textarea name="description" class="form-control" rows="3"><%= mod.description || '' %></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.duration') %></label>
                                            <input type="text" name="duration" class="form-control" value="<%= mod.duration || '' %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.level') %></label>
                                            <select name="level" class="form-select">
                                                <option value="Beginner" <%= mod.level === 'Beginner' ? 'selected' : '' %>><%= t('admin:training.levelBeginner') %></option>
                                                <option value="Intermediate" <%= mod.level === 'Intermediate' ? 'selected' : '' %>><%= t('admin:training.levelIntermediate') %></option>
                                                <option value="Advanced" <%= mod.level === 'Advanced' ? 'selected' : '' %>><%= t('admin:training.levelAdvanced') %></option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.price') %></label>
                                            <input type="number" name="price" class="form-control" min="0" step="0.01" value="<%= mod.price %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><%= t('admin:training.status') %></label>
                                            <select name="status" class="form-select">
                                                <option value="active" <%= mod.status === 'active' ? 'selected' : '' %>><%= t('admin:status.active') %></option>
                                                <option value="draft" <%= mod.status === 'draft' ? 'selected' : '' %>><%= t('admin:status.draft') %></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                                    <button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('admin:training.updateCourse') %></button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <% }) %>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-graduation-cap fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('admin:training.noCourses') %></h4>
                    <p class="text-white-50"><%= t('admin:training.noCoursesHint') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
