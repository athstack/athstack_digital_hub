<div class="crud-toolbar">
    <div class="crud-toolbar__grow">
        <div class="position-relative">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input type="search"
                   class="form-control ps-5"
                   placeholder="<%= t('admin:marketingOfficers.searchPlaceholder') %>"
                   value="<%= currentSearch %>"
                   data-crud-search
                   data-crud-param="search"
                   aria-label="<%= t('admin:marketingOfficers.searchPlaceholder') %>">
        </div>
    </div>
    <button type="button" class="btn btn-premium-outline rounded-pill" data-crud-refresh title="<%= t('admin:marketingOfficers.refresh') %>">
        <i class="fa-solid fa-rotate"></i>
    </button>
</div>

<% if (officers && officers.length > 0) { %>
<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark align-middle mb-0 premium-table">
            <thead>
                <tr>
                    <th><%= t('admin:words.user') %></th>
                    <th><%= t('common:words.email') %></th>
                    <th><%= t('admin:marketingOfficers.status') %></th>
                    <th><%= t('admin:marketingOfficers.joined') %></th>
                    <th class="col-actions"><%= t('common:words.actions') %></th>
                </tr>
            </thead>
            <tbody>
                <% officers.forEach(o => { %>
                <% var statusColors = { active: 'bg-success', inactive: 'bg-secondary', suspended: 'bg-danger' }; %>
                <tr data-officer-row="<%= o.id %>">
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;flex-shrink:0;">
                                <% if (o.avatar) { %>
                                <img src="<%= imageUrl(o.avatar, 'profiles') %>" alt="" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';">
                                <i class="fa-solid fa-bullhorn text-white small" style="display:none;"></i>
                                <% } else { %>
                                <i class="fa-solid fa-bullhorn text-white small"></i>
                                <% } %>
                            </div>
                            <span class="text-white fw-bold"><%= formatDisplayName(o.first_name, o.last_name) %></span>
                        </div>
                    </td>
                    <td class="text-white-50"><%= o.email %></td>
                    <td>
                        <span class="badge officer-status-badge <%= statusColors[o.status] || 'bg-secondary' %>" data-officer="<%= o.id %>"><%= t('admin:status.' + o.status, { defaultValue: o.status }) %></span>
                    </td>
                    <td><small class="text-white-50"><%= o.created_at ? new Date(o.created_at).toLocaleDateString() : '' %></small></td>
                    <td class="col-actions">
                        <div class="action-cell">
                            <%- include('../../partials/actionButton', { abVariant:'edit', abButton:true, abIcon:'fa-pencil', abAttrs:'data-edit-officer data-id="' + o.id + '"', abTitle:t('admin:marketingOfficers.editOfficer') }) %>
                            <%- include('../../partials/actionButton', { abVariant:'info', abButton:true, abIcon:'fa-key', abAttrs:'data-manage-officer-permissions data-id="' + o.id + '" data-name="' + escapeAttr(formatDisplayName(o.first_name, o.last_name)) + '"', abTitle:t('admin:marketingOfficers.managePermissions') }) %>
                            <%- include('../../partials/actionButton', { abVariant:'publish', abButton:true, abIcon: o.status === 'active' ? 'fa-toggle-on' : 'fa-toggle-off', abOn: o.status === 'active', abAttrs:'data-toggle-officer-status data-id="' + o.id + '" data-status="' + (o.status === 'active' ? 'inactive' : 'active') + '"', abTitle: o.status === 'active' ? t('admin:status.inactive') : t('admin:status.active') }) %>
                            <%- include('../../partials/actionButton', { abVariant:'delete', abButton:true, abIcon:'fa-rotate', abAttrs:'data-reset-officer-password data-id="' + o.id + '"', abTitle:t('admin:marketingOfficers.resetPassword') }) %>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<% if (pagination && pagination.totalPages > 1) { %>
<div class="crud-pagination">
    <span class="crud-pagination__info"><%= t('admin:marketingOfficers.paginationInfo', { from: (pagination.page - 1) * pagination.limit + 1, to: Math.min(pagination.page * pagination.limit, pagination.total), total: pagination.total }, { defaultValue: pagination.page + ' / ' + pagination.totalPages }) %></span>
    <button type="button" data-crud-page="1" <%= pagination.hasPrev ? '' : 'disabled' %> title="<%= t('admin:marketingOfficers.first') %>"><i class="fa-solid fa-angles-left"></i></button>
    <button type="button" data-crud-page="<%= pagination.page - 1 %>" <%= pagination.hasPrev ? '' : 'disabled' %> title="<%= t('admin:marketingOfficers.prev') %>"><i class="fa-solid fa-chevron-left"></i></button>
    <button type="button" class="is-active"><%= pagination.page %></button>
    <button type="button" data-crud-page="<%= pagination.page + 1 %>" <%= pagination.hasNext ? '' : 'disabled' %> title="<%= t('admin:marketingOfficers.next') %>"><i class="fa-solid fa-chevron-right"></i></button>
    <button type="button" data-crud-page="<%= pagination.totalPages %>" <%= pagination.hasNext ? '' : 'disabled' %> title="<%= t('admin:marketingOfficers.last') %>"><i class="fa-solid fa-angles-right"></i></button>
</div>
<% } %>
<% } else { %>
<div class="empty-state glass-card p-5">
    <i class="fa-solid fa-bullhorn fa-4x mb-3"></i>
    <% if (currentSearch) { %>
    <h4 class="text-white fw-bold"><%= t('admin:marketingOfficers.noOfficers') %></h4>
    <p class="text-white-50"><%= t('admin:marketingOfficers.noOfficersMatch') %></p>
    <% } else { %>
    <h4 class="text-white fw-bold"><%= t('admin:marketingOfficers.noOfficers') %></h4>
    <p class="text-white-50"><%= t('admin:marketingOfficers.noOfficersMatch') %></p>
    <% } %>
</div>
<% } %>
