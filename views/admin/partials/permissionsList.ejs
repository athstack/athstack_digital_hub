<div class="crud-toolbar">
    <div class="crud-toolbar__grow">
        <span class="text-white-50 small"><%= t('admin:permissionManagement.module') %></span>
    </div>
    <button type="button" class="btn btn-premium-outline rounded-pill" data-crud-refresh title="<%= t('admin:permissionManagement.refresh') %>">
        <i class="fa-solid fa-rotate"></i>
    </button>
</div>

<% if (permissions && permissions.length > 0) { %>
<% const grouped = {}; %>
<% permissions.forEach(p => { const key = p.module || 'general'; if (!grouped[key]) grouped[key] = []; grouped[key].push(p); }); %>
<% Object.keys(grouped).forEach(mod => { %>
<div class="glass-card no-lift p-4 mb-4">
    <h5 class="text-primary fw-bold mb-3 text-uppercase"><%= mod %></h5>
    <div class="table-responsive">
        <table class="table table-dark align-middle mb-0 premium-table">
            <thead>
                <tr>
                    <th><%= t('admin:permissionManagement.permissionName') %></th>
                    <th><%= t('admin:permissionManagement.description') %></th>
                </tr>
            </thead>
            <tbody>
                <% grouped[mod].forEach(p => { %>
                <tr>
                    <td><code class="text-info"><%= p.permission %></code></td>
                    <td class="text-white-50"><%= p.description || '' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% }) %>
<% } else { %>
<div class="empty-state glass-card p-5">
    <i class="fa-solid fa-key fa-4x mb-3"></i>
    <h4 class="text-white fw-bold"><%= t('admin:permissionManagement.permissionName') %></h4>
    <p class="text-white-50">—</p>
</div>
<% } %>
