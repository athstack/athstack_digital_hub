<%- include('../partials/header') %>

<style>
#messageModal .modal-content {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    overflow: hidden;
}
#messageModal .modal-header {
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 1.25rem 1.5rem;
}
#messageModal .modal-body {
    padding: 1.5rem;
}
#messageModal .modal-footer {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 1rem 1.5rem;
}
#messageModal .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    background: rgba(11,17,40,0.6);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
}
#messageModal .contact-item {}
#messageModal .contact-item .label {
    font-size: var(--font-xs);
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.2rem;
}
#messageModal .contact-item .value {
    font-size: var(--font-sm);
    color: var(--text-main);
    font-weight: 500;
    word-break: break-all;
}
#messageModal .subject-line {
    font-size: var(--font-lg);
    font-weight: var(--weight-bold);
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
#messageModal .message-box {
    background: rgba(11,17,40,0.6);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 1.25rem;
    min-height: 120px;
    max-height: 320px;
    overflow-y: auto;
    color: var(--text-secondary);
    font-size: var(--font-base);
    line-height: var(--leading-body);
    white-space: pre-wrap;
}
#messageModal .modal-title {
    font-size: var(--font-lg);
    font-weight: var(--weight-bold);
    color: var(--text-main);
    letter-spacing: -0.02em;
}
#messageModal .reply-form {
    border-top: 1px solid rgba(255,255,255,0.06);
    margin-top: 1rem;
    padding-top: 1rem;
}
#messageModal .reply-form.hidden { display: none; }
#messageModal .reply-form label {
    font-size: var(--font-xs);
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.3rem;
}
#messageModal .reply-form .form-control,
#messageModal .reply-form .form-control-plaintext {
    background: rgba(11,17,40,0.6);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    color: var(--text-main);
    font-size: var(--font-sm);
    padding: 0.6rem 0.9rem;
}
#messageModal .reply-form .form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
    outline: none;
}
#messageModal .reply-form textarea.form-control {
    min-height: 120px;
    resize: vertical;
}
#messageModal .reply-form .form-control-plaintext {
    opacity: 0.6;
    cursor: default;
}
</style>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('admin:words.inbox') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-envelope me-2 text-primary"></i><%= t('admin:inbox.heading') %></h2>
                    <% if (unreadCount > 0) { %>
                    <span class="badge bg-primary rounded-pill px-3 py-2"><i class="fa-solid fa-envelope-open me-1"></i><%= unreadCount %> <%= t('admin:status.unread') %></span>
                    <% } %>
                </div>

                <div data-crud-table data-crud-url="/admin/inbox">
                    <%- include('./partials/inboxTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Message detail modal -->
<div class="modal fade crud-modal" id="messageModal" tabindex="-1" aria-labelledby="msgModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h5 class="modal-title" id="msgModalTitle"><%= t('admin:inbox.detailTitle') %></h5>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="action-btn action-btn--delete" id="msgDeleteHeaderBtn" title="<%= t('common:words.delete') %>" aria-label="<%= t('common:words.delete') %>">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('common:words.close') %>"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary" id="msgStatusBadge"><%= t('admin:inbox.new') %></span>
                    <span class="text-muted small" id="msgMeta"></span>
                </div>
                <div class="contact-grid" id="msgContactGrid">
                    <div class="contact-item">
                        <div class="label"><%= t('common:words.email') %></div>
                        <div class="value" id="msgEmail">—</div>
                    </div>
                    <div class="contact-item">
                        <div class="label"><%= t('common:words.phone') %></div>
                        <div class="value" id="msgPhone">—</div>
                    </div>
                </div>
                <div class="subject-line" id="msgSubject">—</div>
                <div class="label" style="font-size:var(--font-xs);color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;"><%= t('admin:inbox.messageContent') %></div>
                <div class="message-box" id="msgBody">—</div>
                <div id="replyDisplay" class="hidden" style="margin-top:1rem;padding:1rem 1.25rem;background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.2);border-radius:10px;">
                    <div style="font-size:var(--font-xs);color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.3rem;"><%= t('admin:inbox.yourReply') %></div>
                    <div id="replyBody" style="color:var(--text-secondary);font-size:var(--font-base);line-height:var(--leading-body);white-space:pre-wrap;"></div>
                    <div id="replyMeta" style="color:rgba(255,255,255,0.3);font-size:0.7rem;margin-top:0.5rem;"></div>
                </div>

                <form class="reply-form hidden" id="replyForm" method="POST" action="/admin/inbox/0/reply" novalidate>
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <input type="hidden" name="to" id="replyToInput">
                    <div class="mb-2">
                        <label><%= t('admin:inbox.to') %></label>
                        <input type="text" class="form-control-plaintext" id="replyTo" readonly>
                    </div>
                    <div class="mb-2">
                        <label><%= t('common:words.subject') %></label>
                        <input type="text" class="form-control" name="subject" id="replySubject">
                    </div>
                    <div class="mb-2">
                        <label><%= t('admin:inbox.yourReply') %></label>
                        <textarea class="form-control" name="reply_text" id="replyText" maxlength="2000" placeholder="<%= t('admin:inbox.replyPlaceholder') %>"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-premium-outline rounded-pill" id="replyCancelBtn"><%= t('common:words.cancel') %></button>
                        <button type="submit" class="btn btn-sm btn-premium-primary rounded-pill" id="replySendBtn"><i class="fa-solid fa-paper-plane me-1"></i><%= t('admin:inbox.sendReply') %></button>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small"><%= t('admin:inbox.messageFrom') %></span>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-premium-primary rounded-pill btn-sm" id="msgReplyBtn" style="display:none;">
                        <i class="fa-solid fa-reply me-1"></i><%= t('admin:inbox.reply') %>
                    </button>
                    <button type="button" class="btn btn-premium-outline rounded-pill btn-sm" data-bs-dismiss="modal"><%= t('common:words.close') %></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var tableWrap = document.querySelector('[data-crud-table]');
    var modalEl = document.getElementById('messageModal');
    var replyForm = document.getElementById('replyForm');
    var currentId = null;
    var currentStatus = null;

    var i18n = {
        new: '<%= t('admin:inbox.new') %>',
        read: '<%= t('admin:status.read') %>',
        replied: '<%= t('admin:status.replied') %>',
        messageFrom: '<%= t('admin:inbox.messageFrom') %>',
        noSubject: '<%= t('admin:inbox.noSubject') %>',
        generalInquiry: '<%= t('admin:inbox.generalInquiry') %>',
        by: '<%= t('admin:inbox.by') %>',
        sendReply: '<%= t('admin:inbox.sendReply') %>',
        sent: '<%= t('admin:inbox.sent') %>',
        sending: '<%= t('admin:inbox.sending') %>',
        replySent: '<%= t('admin:inbox.replySent') %>',
        messageMarkedRead: '<%= t('admin:flash.messageMarkedRead') %>',
        messageDeleted: '<%= t('admin:flash.messageDeleted') %>',
        deleteTitle: '<%= t('common:words.delete') %>',
        deleteConfirm: '<%= t('admin:inbox.deleteConfirm') %>',
        deleteFailed: '<%= t('admin:inbox.deleteFailed') %>',
        updateFailed: '<%= t('admin:inbox.updateFailed') %>',
        networkError: '<%= t('admin:inbox.networkError') %>',
        cancel: '<%= t('common:words.cancel') %>',
        delete: '<%= t('common:words.delete') %>'
    };

    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function statusBadge(status) {
        if (status === 'replied') return '<span class="badge bg-success">' + esc(i18n.replied) + '</span>';
        if (status === 'read') return '<span class="badge bg-secondary">' + esc(i18n.read) + '</span>';
        return '<span class="badge bg-primary">' + esc(i18n.new) + '</span>';
    }

    function updateRowBadge(id, status) {
        var row = document.querySelector('tr[data-msg-id="' + id + '"]');
        if (!row) return;
        var badge = row.querySelector('.inbox-status-badge');
        if (!badge) return;
        var cls = { unread: 'bg-primary', read: 'bg-secondary', replied: 'bg-success' };
        badge.className = 'badge inbox-status-badge ' + (cls[status] || 'bg-secondary');
        badge.textContent = status === 'unread' ? i18n.new : (status === 'replied' ? i18n.replied : i18n.read);
    }

    function openDetail(id) {
        Crud.get('/admin/inbox/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.message) return;
                var m = data.message;
                currentId = m.id;
                currentStatus = m.status;
                document.getElementById('msgModalTitle').textContent = i18n.messageFrom + ' ' + m.name;
                document.getElementById('msgEmail').textContent = m.email;
                document.getElementById('msgPhone').textContent = m.phone || '—';
                document.getElementById('msgSubject').textContent = m.subject || i18n.noSubject;
                document.getElementById('msgBody').textContent = m.message;
                document.getElementById('msgStatusBadge').innerHTML = statusBadge(m.status);
                document.getElementById('msgMeta').textContent = m.created_at_formatted ? (i18n.by + ' ' + m.created_at_formatted) : '';

                var replyDisplay = document.getElementById('replyDisplay');
                var replyBtn = document.getElementById('msgReplyBtn');
                if (m.reply_text) {
                    document.getElementById('replyBody').textContent = m.reply_text;
                    var metaParts = [];
                    if (m.replied_by_name) metaParts.push(m.replied_by_name);
                    if (m.replied_at_formatted) metaParts.push(m.replied_at_formatted);
                    document.getElementById('replyMeta').textContent = metaParts.join(' — ');
                    replyDisplay.classList.remove('hidden');
                    replyBtn.style.display = 'none';
                } else {
                    replyDisplay.classList.add('hidden');
                    replyBtn.style.display = 'inline-flex';
                }

                replyForm.classList.add('hidden');
                replyForm.setAttribute('action', '/admin/inbox/' + m.id + '/reply');
                Crud.clearErrors(replyForm);
                Crud.openModal(modalEl);

                if (m.status === 'unread') {
                    Crud.post('/admin/inbox/' + m.id + '/read')
                        .then(function () {
                            updateRowBadge(m.id, 'read');
                        })
                        .catch(function () {});
                }
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    tableWrap.addEventListener('click', function (e) {
        var viewBtn = e.target.closest('[data-view-message]');
        if (viewBtn) {
            e.preventDefault();
            openDetail(viewBtn.getAttribute('data-id'));
            return;
        }

        var delBtn = e.target.closest('[data-delete-message]');
        if (delBtn) {
            e.preventDefault();
            var id = delBtn.getAttribute('data-id');
            Crud.confirm({
                title: i18n.deleteTitle,
                message: i18n.deleteConfirm,
                confirmText: i18n.delete
            }).then(function (ok) {
                if (!ok) return;
                Crud.post('/admin/inbox/' + id + '/delete')
                    .then(function (data) {
                        Crud.toast(data.message || i18n.messageDeleted, 'success');
                        Crud.refreshTable({ wrap: tableWrap, url: '/admin/inbox' });
                    })
                    .catch(function (err) {
                        Crud.toast((err.data && err.data.message) || i18n.deleteFailed, 'error');
                    });
            });
            return;
        }
    });

    document.getElementById('msgReplyBtn').addEventListener('click', function () {
        var to = document.getElementById('msgEmail').textContent;
        if (to === '—') to = '';
        document.getElementById('replyTo').value = to;
        document.getElementById('replyToInput').value = to;
        var subj = document.getElementById('msgSubject').textContent;
        if (!subj || subj === i18n.noSubject || subj.toLowerCase() === 'product') {
            subj = i18n.generalInquiry;
        }
        document.getElementById('replySubject').value = 'Re: ' + subj;
        document.getElementById('replyText').value = '';
        document.getElementById('replySendBtn').disabled = false;
        document.getElementById('replySendBtn').innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i>' + esc(i18n.sendReply);
        replyForm.classList.remove('hidden');
    });

    document.getElementById('replyCancelBtn').addEventListener('click', function () {
        replyForm.classList.add('hidden');
    });

    document.getElementById('msgDeleteHeaderBtn').addEventListener('click', function () {
        if (!currentId) return;
        Crud.confirm({
            title: i18n.deleteTitle,
            message: i18n.deleteConfirm,
            confirmText: i18n.delete
        }).then(function (ok) {
            if (!ok) return;
            Crud.post('/admin/inbox/' + currentId + '/delete')
                .then(function (data) {
                    Crud.closeModal(modalEl);
                    Crud.toast(data.message || i18n.messageDeleted, 'success');
                    Crud.refreshTable({ wrap: tableWrap, url: '/admin/inbox' });
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.deleteFailed, 'error');
                });
        });
    });

    replyForm.addEventListener('submit', function (e) {
        e.preventDefault();
        Crud.submitForm(replyForm, {
            onSuccess: function (data) {
                Crud.closeModal(modalEl);
                Crud.toast(data.message || i18n.replySent, 'success');
                if (currentId) updateRowBadge(currentId, 'replied');
                Crud.refreshTable({ wrap: tableWrap, url: '/admin/inbox' });
            }
        });
    });

    Crud.initTable(tableWrap);
});
</script>

<%- include('../partials/footer') %>
