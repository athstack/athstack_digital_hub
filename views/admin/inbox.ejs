<%- include('../partials/header') %>

<div class="container-fluid py-5 px-md-5">
    <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-white fw-bold m-0">
                <i class="fa-solid fa-envelope text-primary me-3"></i><%= title %>
            </h2>
            <a href="/admin" class="btn btn-sm btn-outline-primary">Back to Dashboard</a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th>Received</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(function(msg) { %>
                        <tr>
                            <td class="text-white fw-bold"><%= msg.name %></td>
                            <td><%= msg.email %></td>
                            <td class="text-info fw-medium text-wrap" style="max-width: 400px; word-wrap: break-word;">
                                <%= msg.message %>
                            </td>
                            <td class="small text-muted"><%= new Date(msg.created_at).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="4" class="text-center py-4">No messages found.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
