<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>

            <div class="col-lg-9">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-badge"><i class="fa-solid fa-chart-bar me-1"></i>Analytics</span>
                        <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-magnifying-glass-chart me-2 text-primary"></i>Data Analysis</h2>
                    </div>
                </div>

                <!-- Metric Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-dollar-sign fa-xl text-success mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= formatCurrency(repairRevenue) %></h4>
                            <p class="text-white-50 small mb-0">Service Earnings</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-wrench fa-xl text-primary mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= totalRepairs %></h4>
                            <p class="text-white-50 small mb-0">Total Repairs</p>
                            <div class="mt-1" style="font-size:0.6rem;line-height:1.4;">
                                <span class="text-warning"><%= pendingRepairs %> pending</span>
                                <span class="text-white-50 mx-1">|</span>
                                <span class="text-info"><%= inProgress %> active</span>
                                <span class="text-white-50 mx-1">|</span>
                                <span class="text-success"><%= completedRepairs %> done</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-clock fa-xl text-info mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;">
                                <% if (avgTurnaround !== null) { %>
                                    <%= avgTurnaround %> <small style="font-size:0.65rem;">hrs</small>
                                <% } else { %>
                                    <small style="font-size:0.8rem;">N/A</small>
                                <% } %>
                            </h4>
                            <p class="text-white-50 small mb-0">Avg Turnaround</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-trophy fa-xl text-warning mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:0.95rem;line-height:1.3;">
                                <%= topService ? topService.title : 'N/A' %>
                            </h4>
                            <p class="text-white-50 small mb-0">Top Service</p>
                            <% if (topService) { %>
                            <div style="font-size:0.6rem;color:rgba(255,255,255,0.35);"><%= topService.total_bookings %> bookings</div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="glass-card p-3 mb-4">
                    <form method="GET" action="/admin/analytics" class="row g-2 align-items-end" id="filterForm">
                        <input type="hidden" name="search" id="searchHidden" value="<%= search %>">
                        <div class="col-md-2">
                            <label class="text-white-50 small text-uppercase tracking-widest mb-1" style="font-size:0.6rem;">Date Range</label>
                            <select name="range" class="form-select form-select-sm" onchange="toggleCustomDates();this.form.submit();">
                                <option value="7days" <%= range === '7days' ? 'selected' : '' %>>Last 7 Days</option>
                                <option value="30days" <%= range === '30days' ? 'selected' : '' %>>This Month</option>
                                <option value="90days" <%= range === '90days' ? 'selected' : '' %>>Last 90 Days</option>
                                <option value="year" <%= range === 'year' ? 'selected' : '' %>>This Year</option>
                                <option value="custom" <%= range === 'custom' ? 'selected' : '' %>>Custom Range</option>
                            </select>
                        </div>
                        <div class="col-md-2" id="customStartWrap" style="<%= range === 'custom' ? '' : 'display:none;' %>">
                            <label class="text-white-50 small text-uppercase tracking-widest mb-1" style="font-size:0.6rem;">From</label>
                            <input type="date" name="start_date" class="form-control form-control-sm" value="<%= start_date %>">
                        </div>
                        <div class="col-md-2" id="customEndWrap" style="<%= range === 'custom' ? '' : 'display:none;' %>">
                            <label class="text-white-50 small text-uppercase tracking-widest mb-1" style="font-size:0.6rem;">To</label>
                            <input type="date" name="end_date" class="form-control form-control-sm" value="<%= end_date %>">
                        </div>
                        <div class="col-md-2">
                            <label class="text-white-50 small text-uppercase tracking-widest mb-1" style="font-size:0.6rem;">Category</label>
                            <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="all" <%= category === 'all' ? 'selected' : '' %>>All Categories</option>
                                <option value="computer" <%= category === 'computer' ? 'selected' : '' %>>Computer Services</option>
                                <option value="phone" <%= category === 'phone' ? 'selected' : '' %>>Phone Services</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-premium-primary rounded-pill flex-grow-1"><i class="fa-solid fa-filter me-1"></i>Filter</button>
                            <a href="/admin/analytics" class="btn btn-sm btn-premium-outline rounded-pill"><i class="fa-solid fa-rotate"></i></a>
                        </div>
                    </form>
                </div>

                <!-- Search + Export Bar -->
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                    <div style="flex:1;max-width:320px;">
                        <input type="text" class="form-control form-control-sm" placeholder="Search services..." value="<%= search %>" id="searchInput" style="background:var(--bg-input);border-color:var(--border-glass);color:var(--text-main);">
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <button class="btn btn-sm btn-premium-outline rounded-pill" onclick="exportCSV()"><i class="fa-solid fa-file-csv me-1"></i>CSV</button>
                        <button class="btn btn-sm btn-premium-outline rounded-pill" onclick="exportPDF()"><i class="fa-solid fa-file-pdf me-1"></i>PDF</button>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0" id="analyticsTable" style="min-width:700px;">
                            <thead>
                                <tr>
                                    <th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;letter-spacing:0.06em;cursor:pointer;" onclick="sortTable(0)">Service <i class="fa-solid fa-sort ms-1"></i></th>
                                    <th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;letter-spacing:0.06em;cursor:pointer;" onclick="sortTable(1)">Category <i class="fa-solid fa-sort ms-1"></i></th>
                                    <th class="py-3 px-4 text-white-50 text-uppercase text-center" style="font-size:0.65rem;letter-spacing:0.06em;cursor:pointer;" onclick="sortTable(2)">Bookings <i class="fa-solid fa-sort ms-1"></i></th>
                                    <th class="py-3 px-4 text-white-50 text-uppercase text-center" style="font-size:0.65rem;letter-spacing:0.06em;">Rate</th>
                                    <th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;letter-spacing:0.06em;cursor:pointer;" onclick="sortTable(4)">Revenue <i class="fa-solid fa-sort ms-1"></i></th>
                                    <th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;letter-spacing:0.06em;">Avg Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (serviceStats && serviceStats.length > 0) { %>
                                    <% serviceStats.forEach(function(svc) { %>
                                    <% var completionRate = svc.total_bookings > 0 ? Math.round(svc.completed_count / svc.total_bookings * 100) : 0; %>
                                    <tr style="transition:background 0.15s;cursor:default;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                                        <td class="py-3 px-4 text-white fw-medium"><%= svc.title %></td>
                                        <td class="py-3 px-4">
                                            <span class="badge <%= svc.category === 'computer' ? 'bg-primary' : 'bg-info' %>" style="font-size:0.6rem;"><%= svc.category === 'computer' ? 'Computer' : 'Phone' %></span>
                                        </td>
                                        <td class="py-3 px-4 text-white text-center fw-medium"><%= svc.total_bookings %></td>
                                        <td class="py-3 px-4 text-center">
                                            <% if (svc.total_bookings > 0) { %>
                                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                                <span class="badge bg-success" style="font-size:0.6rem;"><%= svc.completed_count %> done</span>
                                                <% if (svc.pending_count > 0) { %>
                                                <span class="badge bg-warning text-dark" style="font-size:0.6rem;"><%= svc.pending_count %> pending</span>
                                                <% } %>
                                            </div>
                                            <div class="mt-1" style="width:80px;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin:0 auto;overflow:hidden;">
                                                <div style="width:<%= Math.min(100, Math.max(0, completionRate)) %>% ;max-width:100%;height:100%;background:var(--bs-success);border-radius:2px;transition:width 0.3s;"></div>
                                            </div>
                                            <% } else { %>
                                            <span style="color:rgba(255,255,255,0.2);font-size:0.85rem;">—</span>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 text-end"><span style="color:#10B981;font-weight:500;"><%= formatCurrency(svc.total_revenue) %></span></td>
                                        <td class="py-3 px-4 text-end" style="color:rgba(255,255,255,0.6);">
                                            <% if (svc.avg_completion_hours) { %>
                                                <%= Math.round(svc.avg_completion_hours) %> hrs
                                            <% } else { %>
                                                <span style="color:rgba(255,255,255,0.25);">—</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-chart-simple fa-2x mb-2"></i><br>
                                        No data found for the selected filters.
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
function toggleCustomDates() {
    var r = document.querySelector('select[name="range"]').value;
    document.getElementById('customStartWrap').style.display = r === 'custom' ? '' : 'none';
    document.getElementById('customEndWrap').style.display = r === 'custom' ? '' : 'none';
}

var sortDir = {};
function sortTable(col) {
    var tbody = document.querySelector('#analyticsTable tbody');
    var rows = Array.from(tbody.querySelectorAll('tr'));
    if (rows.length === 1 && rows[0].querySelector('td[colspan]')) return;
    sortDir[col] = !(sortDir[col]);
    var dir = sortDir[col] ? 1 : -1;
    rows.sort(function(a, b) {
        var va = a.cells[col].textContent.trim();
        var vb = b.cells[col].textContent.trim();
        var na = parseFloat(va.replace(/[$,]/g, ''));
        var nb = parseFloat(vb.replace(/[$,]/g, ''));
        if (!isNaN(na) && !isNaN(nb)) return (na - nb) * dir;
        return va.localeCompare(vb) * dir;
    });
    rows.forEach(function(r) { tbody.appendChild(r); });
}

function exportCSV() {
    var tbody = document.querySelector('#analyticsTable tbody');
    if (!tbody) return;
    var rows = tbody.querySelectorAll('tr');
    if (rows.length === 0 || (rows.length === 1 && rows[0].querySelector('td[colspan]'))) return;
    var csv = '\uFEFFService,Category,Bookings,Completed,Pending,Revenue,Avg Time\n';
    rows.forEach(function(row) {
        if (row.querySelector('td[colspan]')) return;
        var cells = row.querySelectorAll('td');
        if (cells.length < 6) return;
        var vals = [];
        vals.push('"' + cells[0].textContent.trim().replace(/"/g, '""') + '"');
        vals.push('"' + cells[1].textContent.trim().replace(/"/g, '""') + '"');
        vals.push(cells[2].textContent.trim());
        var rateCell = cells[3];
        var doneBadge = rateCell.querySelector('.badge.bg-success');
        var pendBadge = rateCell.querySelector('.badge.bg-warning');
        vals.push(doneBadge ? doneBadge.textContent.trim().replace(/\s*done$/, '') : '0');
        vals.push(pendBadge ? pendBadge.textContent.trim().replace(/\s*pending$/, '') : '0');
        vals.push(cells[4].textContent.trim().replace(/[^\d.,$]/g, ''));
        vals.push(cells[5].textContent.trim().replace(/\s*hrs$/, ''));
        csv += vals.join(',') + '\n';
    });
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'analytics_' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a);
    a.click();
    setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
}

function exportPDF() {
    var el = document.querySelector('.glass-card.p-0');
    if (!el) { alert('No data table found.'); return; }
    if (typeof html2pdf === 'undefined') { alert('PDF library not loaded. Please try again.'); return; }
    el.querySelectorAll('.fa-sort').forEach(function(i) { i.remove(); });
    var opt = {
        margin: [0.4, 0.4, 0.4, 0.4],
        filename: 'analytics_' + new Date().toISOString().slice(0,10) + '.pdf',
        image: { type: 'jpeg', quality: 0.95 },
        html2canvas: { scale: 2, backgroundColor: '#0f172a', logging: false, useCORS: true },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' }
    };
    html2pdf().set(opt).from(el).save();
}

(function() {
    var searchInput = document.getElementById('searchInput');
    var searchHidden = document.getElementById('searchHidden');
    if (searchInput && searchHidden) {
        var timer;
        searchInput.addEventListener('input', function() {
            searchHidden.value = this.value;
            clearTimeout(timer);
            timer = setTimeout(function() { document.getElementById('filterForm').submit(); }, 400);
        });
    }
})();
</script>

<%- include('../partials/footer') %>