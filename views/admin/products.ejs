<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:products.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-box-open me-2 text-primary"></i><%= t('admin:products.heading') %></h2>
                    <div class="ms-auto">
                        <a href="/admin/products/new" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i><%= t('admin:products.addProduct') %></a>
                    </div>
                </div>

                <% if (products && products.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table products-table">
                            <thead>
                                <tr><th class="col-product"><%= t('admin:products.colProduct') %></th><th><%= t('admin:words.listedBy') %></th><th class="col-category"><%= t('common:words.category') %></th><th class="col-price"><%= t('common:words.price') %></th><th class="col-stock"><%= t('admin:words.stock') %></th><th><%= t('common:words.status') %></th><th class="col-actions"><%= t('common:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% products.forEach(product => { %>
                                <tr data-product-id="<%= product.id %>">
                                    <td class="col-product">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="col-thumb">
                                                 <%- include('../partials/productImage', { src: product.main_image ? imageUrl(product.main_image, 'products') : '', alt: product.name, style: 'max-height:44px;max-width:44px;object-fit:contain;' }) %>
                                            </div>
                                            <span class="text-white fw-bold col-product-name"><%= product.name %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (product.technician_first_name) { %>
                                            <span class="text-white"><%= formatDisplayName(product.technician_first_name, product.technician_last_name) %></span>
                                        <% } else { %>
                                            <span class="text-white-50"><%= t('admin:words.admin') %></span>
                                        <% } %>
                                    </td>
                                    <td class="col-category text-white-50"><%= product.category_name || 'N/A' %></td>
                                    <td class="col-price text-primary"><%= formatCurrency(product.price) %></td>
                                    <td class="col-stock text-white-50"><%= product.stock_quantity %></td>
                                    <td class="col-status">
                                        <button type="button"
                                            class="action-btn action-btn--publish status-toggle <%= product.status === 'active' ? 'is-on' : '' %>"
                                            data-id="<%= product.id %>"
                                            data-status="<%= product.status %>"
                                            title="<%= product.status === 'active' ? t('admin:products.clickDeactivate') : t('admin:products.clickActivate') %>"
                                            aria-label="<%= product.status === 'active' ? t('admin:products.clickDeactivate') : t('admin:products.clickActivate') %>">
                                            <i class="fa-solid fa-<%= product.status === 'active' ? 'toggle-on' : 'toggle-off' %>"></i>
                                        </button>
                                    </td>
                                    <td class="col-actions">
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abHref:'/admin/products/edit/' + product.id, abTitle:t('common:words.edit') }) %>
                                            <%- include('../partials/actionButton', { abVariant:'delete', abButton:true, abClassExtra:'btn-delete-product', abAttrs:'data-id="' + product.id + '" data-name="' + product.name + '"', abTitle:t('common:words.delete') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('admin:products.noProducts') %></h4>
                    <p class="text-white-50"><%= t('admin:products.noProductsListed') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i><%= t('admin:products.deleteTitle') %></h5>
                <button type="button" class="modal-close" id="deleteModalClose">&times;</button>
            </div>
            <div class="modal-body">
                <p class="mb-0"><%= t('admin:products.deleteConfirm') %> <strong class="text-white" id="deleteProductName"></strong>?</p>
                <p class="text-muted small mt-2 mb-0"><%= t('admin:products.cannotUndo') %></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-premium-outline" id="deleteModalCancel"><%= t('common:words.cancel') %></button>
                <button type="button" class="btn btn-danger" id="deleteModalConfirm"><i class="fa-solid fa-trash me-1"></i><%= t('common:words.delete') %></button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var modal = document.getElementById('deleteModal');
    var productNameEl = document.getElementById('deleteProductName');
    var confirmBtn = document.getElementById('deleteModalConfirm');
    var cancelBtn = document.getElementById('deleteModalCancel');
    var closeBtn = document.getElementById('deleteModalClose');
    var currentId = null;

    function showModal(name, id) {
        productNameEl.textContent = name;
        currentId = id;
        modal.style.display = 'flex';
    }

    function hideModal() {
        modal.style.display = 'none';
        currentId = null;
    }

    cancelBtn.addEventListener('click', hideModal);
    closeBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
        if (e.target === modal) hideModal();
    });

    document.querySelectorAll('.btn-delete-product').forEach(function(btn) {
        btn.addEventListener('click', function() {
            showModal(this.dataset.name, this.dataset.id);
        });
    });

    confirmBtn.addEventListener('click', function() {
        if (!currentId) return;
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i><%= t('admin:products.deleting') %>';

        fetch('/admin/products/delete/' + currentId, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': <%- JSON.stringify(csrfToken) %>
            }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var row = document.querySelector('tr[data-product-id="' + currentId + '"]');
                if (row) {
                    row.style.transition = 'opacity 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(function() { row.remove(); }, 300);
                }
                hideModal();
            } else {
                alert(data.message || '<%= t('admin:products.deleteFailed') %>');
            }
        })
        .catch(function() { alert('<%= t('admin:products.networkError') %>'); })
        .finally(function() {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="fa-solid fa-trash me-1"></i><%= t('common:words.delete') %>';
        });
    });

    document.querySelectorAll('.status-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.dataset.id;
            var el = this;
            el.disabled = true;

            fetch('/admin/products/' + id + '/status', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                'X-CSRF-Token': <%- JSON.stringify(csrfToken) %>
                }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    el.dataset.status = data.status;
                    el.title = data.status === 'active' ? '<%= t('admin:products.clickDeactivate') %>' : '<%= t('admin:products.clickActivate') %>';
                    el.setAttribute('aria-label', el.title);
                    el.className = 'action-btn action-btn--publish status-toggle ' + (data.status === 'active' ? 'is-on' : '');
                    el.querySelector('i').className = 'fa-solid fa-' + (data.status === 'active' ? 'toggle-on' : 'toggle-off');
                } else {
                    alert(data.message || '<%= t('admin:products.updateStatusFailed') %>');
                }
            })
            .catch(function() { alert('<%= t('admin:products.networkError') %>'); })
            .finally(function() { el.disabled = false; });
        });
    });
})();
</script>

<%- include('../partials/footer') %>
