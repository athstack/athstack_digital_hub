<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:products.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-box-open me-2 text-primary"></i><%= t('admin:products.heading') %></h2>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-premium-primary rounded-pill" id="addProductBtn"><i class="fa-solid fa-plus me-2"></i><%= t('admin:products.addProduct') %></button>
                    </div>
                </div>

                <div data-crud-table data-crud-url="/admin/products">
                    <%- include('./partials/productsTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product add / edit modal -->
<div class="modal fade crud-modal" id="productModal" tabindex="-1" aria-labelledby="productModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="productForm" method="POST" action="/admin/products/new" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="existing_image" id="existingImage" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalTitle"><%= t('admin:productForm.headingAdd') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="pf-name"><%= t('admin:productForm.name') %></label>
                            <input type="text" class="form-control" id="pf-name" name="name" placeholder="<%= t('admin:productForm.namePlaceholder') %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-sku"><%= t('admin:productForm.sku') %></label>
                            <input type="text" class="form-control" id="pf-sku" name="sku" placeholder="<%= t('admin:productForm.skuPlaceholder') %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-category"><%= t('common:words.category') %></label>
                            <select class="form-select" id="pf-category" name="category_id" required>
                                <option value=""><%= t('admin:productForm.selectCategory') %></option>
                                <% (categories || []).forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="pf-price"><%= t('admin:productForm.price') %></label>
                            <input type="number" class="form-control" id="pf-price" name="price" min="0" step="0.01" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="pf-discount"><%= t('admin:productForm.discountPrice') %></label>
                            <input type="number" class="form-control" id="pf-discount" name="discount_price" min="0" step="0.01">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="pf-stock"><%= t('admin:productForm.stockQuantity') %></label>
                            <input type="number" class="form-control" id="pf-stock" name="stock_quantity" min="0" step="1" value="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-status"><%= t('common:words.status') %></label>
                            <select class="form-select" id="pf-status" name="status">
                                <option value="active"><%= t('admin:status.active') %></option>
                                <option value="inactive"><%= t('admin:status.inactive') %></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="pf-description"><%= t('common:words.description') %></label>
                            <textarea class="form-control" id="pf-description" name="description" rows="3" placeholder="<%= t('admin:productForm.descriptionPlaceholder') %>"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-main-image"><%= t('admin:productForm.newImageOptional') %></label>
                            <input type="file" class="form-control" id="pf-main-image" name="product_image" accept="image/*">
                            <div class="crud-uploader" id="mainImagePreview"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-gallery"><%= t('admin:productForm.galleryImages') %></label>
                            <input type="file" class="form-control" id="pf-gallery" name="gallery_images" accept="image/*" multiple>
                            <div class="crud-uploader" id="galleryPreview"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill" id="productSubmitBtn"><i class="fa-solid fa-plus me-1"></i><%= t('admin:productForm.createProduct') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    var modalEl = document.getElementById('productModal');
    var form = document.getElementById('productForm');
    var titleEl = document.getElementById('productModalTitle');
    var submitBtn = document.getElementById('productSubmitBtn');
    var addBtn = document.getElementById('addProductBtn');
    var tableWrap = document.querySelector('[data-crud-table]');
    var mainPreview = document.getElementById('mainImagePreview');
    var galleryPreview = document.getElementById('galleryPreview');

    var i18n = {
        headingAdd: '<%= t('admin:productForm.headingAdd') %>',
        headingEdit: '<%= t('admin:productForm.headingEdit') %>',
        createProduct: '<%= t('admin:productForm.createProduct') %>',
        updateProduct: '<%= t('admin:productForm.updateProduct') %>',
        productCreated: '<%= t('admin:flash.productCreated') %>',
        productUpdated: '<%= t('admin:flash.productUpdated') %>',
        productDeleted: '<%= t('admin:flash.productDeleted') %>',
        deleteTitle: '<%= t('admin:products.deleteTitle') %>',
        deleteConfirm: '<%= t('admin:products.deleteConfirm') %>',
        deleteFailed: '<%= t('admin:products.deleteFailed') %>',
        updateStatusFailed: '<%= t('admin:products.updateStatusFailed') %>',
        networkError: '<%= t('admin:products.networkError') %>',
        activate: '<%= t('admin:products.clickActivate') %>',
        deactivate: '<%= t('admin:products.clickDeactivate') %>',
        cancel: '<%= t('common:words.cancel') %>',
        delete: '<%= t('common:words.delete') %>'
    };

    Crud.initImageUploader(form.elements['product_image'], mainPreview);
    Crud.initImageUploader(form.elements['gallery_images'], galleryPreview);

    function resetForm() {
        form.reset();
        Crud.clearErrors(form);
        form.action = '/admin/products/new';
        titleEl.textContent = i18n.headingAdd;
        submitBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i>' + i18n.createProduct;
        document.getElementById('existingImage').value = '';
        mainPreview.innerHTML = '';
        galleryPreview.innerHTML = '';
    }

    function previewWrap(url, existing) {
        var wrap = document.createElement('div');
        wrap.className = 'crud-uploader__preview' + (existing ? ' crud-uploader__preview--existing' : '');
        var img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.loading = 'lazy';
        wrap.appendChild(img);
        return wrap;
    }

    function openAdd() {
        resetForm();
        Crud.openModal(modalEl);
    }

    function openEdit(id) {
        Crud.get('/admin/products/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.product) return;
                resetForm();
                var p = data.product;
                form.action = '/admin/products/edit/' + id;
                titleEl.textContent = i18n.headingEdit;
                submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>' + i18n.updateProduct;

                form.elements['name'].value = p.name || '';
                form.elements['sku'].value = p.sku || '';
                form.elements['category_id'].value = p.category_id != null ? p.category_id : '';
                form.elements['price'].value = p.price != null ? p.price : '';
                form.elements['discount_price'].value = p.discount_price != null ? p.discount_price : '';
                form.elements['stock_quantity'].value = p.stock_quantity != null ? p.stock_quantity : 0;
                form.elements['status'].value = p.status || 'active';
                form.elements['description'].value = p.description || '';
                document.getElementById('existingImage').value = p.main_image || '';

                if (p.main_image_url) mainPreview.appendChild(previewWrap(p.main_image_url, true));
                (p.gallery || []).forEach(function (g) {
                    if (g.url) galleryPreview.appendChild(previewWrap(g.url, true));
                });

                Crud.openModal(modalEl);
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    addBtn.addEventListener('click', openAdd);

    tableWrap.addEventListener('click', function (e) {
        var editBtn = e.target.closest('[data-edit-product]');
        if (editBtn) {
            e.preventDefault();
            openEdit(editBtn.getAttribute('data-id'));
            return;
        }

        var delBtn = e.target.closest('[data-delete-product]');
        if (delBtn) {
            e.preventDefault();
            var id = delBtn.getAttribute('data-id');
            var name = delBtn.getAttribute('data-name');
            Crud.confirm({
                title: i18n.deleteTitle,
                messageHtml: i18n.deleteConfirm + ' <strong class="text-white">' + (name || '') + '</strong>?',
                confirmText: i18n.delete
            }).then(function (ok) {
                if (!ok) return;
                Crud.post('/admin/products/delete/' + id)
                    .then(function (data) {
                        Crud.toast(data.message || i18n.productDeleted, 'success');
                        Crud.refreshTable({ wrap: tableWrap, url: '/admin/products' });
                    })
                    .catch(function (err) {
                        Crud.toast((err.data && err.data.message) || i18n.deleteFailed, 'error');
                    });
            });
            return;
        }

        var toggle = e.target.closest('.status-toggle');
        if (toggle) {
            e.preventDefault();
            var tid = toggle.getAttribute('data-id');
            toggle.disabled = true;
            Crud.post('/admin/products/' + tid + '/status')
                .then(function (data) {
                    Crud.toast(data.message || '', 'success');
                    toggle.dataset.status = data.status;
                    toggle.title = data.status === 'active' ? i18n.deactivate : i18n.activate;
                    toggle.setAttribute('aria-label', toggle.title);
                    toggle.className = 'action-btn action-btn--publish status-toggle ' + (data.status === 'active' ? 'is-on' : '');
                    toggle.querySelector('i').className = 'fa-solid fa-' + (data.status === 'active' ? 'toggle-on' : 'toggle-off');
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.updateStatusFailed, 'error');
                })
                .then(function () { toggle.disabled = false; });
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        Crud.submitForm(form, {
            onSuccess: function (data) {
                Crud.closeModal(modalEl);
                Crud.toast(data.message || i18n.productCreated, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/admin/products' });
            }
        });
    });

    Crud.initTable(tableWrap);
})();
</script>

<%- include('../partials/footer') %>
