<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <a href="/admin/reviews" class="btn btn-premium-outline btn-sm rounded-pill"><i class="fa-solid fa-arrow-left me-1"></i><%= t('common:words.back') %></a>
                    <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-star me-2 text-warning"></i><%= t('admin:reviewForm.heading') %></h2>
                </div>

                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="glass-card no-lift p-4">
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width:40px;height:40px;">
                                <i class="fa-solid fa-user text-white"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-0"><%= formatDisplayName(review.first_name, review.last_name) %></h6>
                                <small class="text-muted"><%= review.email %></small>
                            </div>
                        </div>
                        <div class="text-warning mb-3">
                            <% for (let i = 1; i <= 5; i++) { %>
                            <i class="fa-<%= i <= review.rating ? 'solid' : 'regular' %> fa-star"></i>
                            <% } %>
                        </div>
                        <% if (review.comment) { %>
                        <p class="text-muted mb-0"><%= review.comment %></p>
                        <% } %>
                    </div>

                    <hr class="border-secondary opacity-25">

                    <form method="POST" action="/admin/reviews/<%= review.id %>/edit">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"><%= t('admin:reviews.userId') %></label>
                                <input type="number" name="user_id" class="form-control" value="<%= review.user_id %>" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('admin:words.product') %></label>
                                <select name="product_id" class="form-select">
                                    <% if (products && products.length > 0) { %>
                                    <% products.forEach(p => { %>
                                    <option value="<%= p.id %>"<%= p.id === review.product_id ? ' selected' : '' %>><%= p.name %></option>
                                    <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('admin:words.rating') %></label>
                                <select name="rating" class="form-select">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                    <option value="<%= i %>"<%= i === review.rating ? ' selected' : '' %>><%= t('admin:reviews.stars', {count: i}) %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('admin:words.type') %></label>
                                <select name="type" class="form-select">
                                    <option value="product"<%= review.type === 'product' ? ' selected' : '' %>><%= t('admin:reviews.typeProduct') %></option>
                                    <option value="technician"<%= review.type === 'technician' ? ' selected' : '' %>><%= t('admin:reviews.typeTechnician') %></option>
                                    <option value="service"<%= review.type === 'service' ? ' selected' : '' %>><%= t('admin:reviews.typeService') %></option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('common:words.status') %></label>
                                <select name="status" class="form-select">
                                    <option value="pending"<%= review.status === 'pending' ? ' selected' : '' %>><%= t('admin:status.pending') %></option>
                                    <option value="approved"<%= review.status === 'approved' ? ' selected' : '' %>><%= t('admin:status.approved') %></option>
                                    <option value="rejected"<%= review.status === 'rejected' ? ' selected' : '' %>><%= t('admin:status.rejected') %></option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label"><%= t('admin:words.title') %></label>
                                <input type="text" name="title" class="form-control" maxlength="120" value="<%= review.title || '' %>" placeholder="<%= t('admin:reviews.titleOptional') %>">
                            </div>

                            <div class="col-12">
                                <label class="form-label"><%= t('admin:words.comment') %></label>
                                <textarea name="comment" class="form-control" rows="4"><%= review.comment || '' %></textarea>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="is_verified" id="isVerifiedToggle" value="1"<%= review.is_verified ? ' checked' : '' %>>
                                    <label class="form-check-label text-white-50" for="isVerifiedToggle"><i class="fa-solid fa-circle-check me-1 text-success"></i><%= t('admin:reviewForm.verifiedPurchase') %></label>
                                </div>
                            </div>

                            <div class="col-12 d-flex gap-2 justify-content-end">
                                <a href="/admin/reviews" class="btn btn-premium-outline rounded-pill"><%= t('common:words.cancel') %></a>
                                <button type="submit" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-save me-2"></i><%= t('common:words.saveChanges') %></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
