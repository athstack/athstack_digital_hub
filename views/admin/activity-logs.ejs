<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>

            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('admin:words.users') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i><%= t('admin:activityLogs.heading') %></h2>
                </div>

                <div class="glass-card p-4 mb-4">
                    <form method="GET" action="/admin/activity-logs" class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label"><%= t('common:words.search') %></label>
                            <input type="text" name="search" class="form-control" placeholder="<%= t('admin:activityLogs.searchPlaceholder') %>" value="<%= searchQuery || '' %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><%= t('admin:activityLogs.role') %></label>
                            <select name="role" class="form-select">
                                <option value=""><%= t('admin:activityLogs.allRoles') %></option>
                                <% roles.forEach(r => { %>
                                <option value="<%= r %>" <%= currentRole === r ? 'selected' : '' %>><%= t('admin:roles.' + r, { defaultValue: r }) %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><%= t('admin:activityLogs.action') %></label>
                            <select name="action" class="form-select">
                                <option value=""><%= t('admin:activityLogs.allActions') %></option>
                                <% actions.forEach(a => { %>
                                <option value="<%= a %>" <%= currentAction === a ? 'selected' : '' %>><%= a %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-premium-primary w-100 rounded-pill"><i class="fa-solid fa-search me-1"></i> <%= t('admin:words.filter') %></button>
                        </div>
                    </form>
                </div>

                <% if (logs && logs.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <small class="text-white-50"><%= t('admin:activityLogs.showingTotal', { total: pagination.total }) %></small>
                        <% if (pagination.totalPages > 1) { %>
                        <small class="text-white-50"><%= t('admin:activityLogs.pageOf', { page: pagination.page, totalPages: pagination.totalPages }) %></small>
                        <% } %>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr>
                                    <th><%= t('admin:activityLogs.username') %></th>
                                    <th><%= t('admin:activityLogs.role') %></th>
                                    <th><%= t('admin:activityLogs.action') %></th>
                                    <th><%= t('admin:activityLogs.resource') %></th>
                                    <th><%= t('admin:activityLogs.resourceId') %></th>
                                    <th><%= t('admin:activityLogs.date') %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% logs.forEach(log => { %>
                                <tr>
                                    <td class="text-white fw-semibold"><%= log.username || '—' %></td>
                                    <td><span class="badge bg-primary bg-opacity-25 text-primary text-capitalize"><%= log.role || '—' %></span></td>
                                    <td><span class="badge bg-success bg-opacity-25 text-success"><%= log.action %></span></td>
                                    <td class="text-white-50 text-capitalize"><%= log.resource || '—' %></td>
                                    <td class="text-white-50"><%= log.resource_id || '—' %></td>
                                    <td class="text-white-50"><%= log.created_at ? new Date(log.created_at).toLocaleString() : '' %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if (pagination.totalPages > 1) { %>
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                                <a class="page-link bg-dark border-secondary text-white-50" href="/admin/activity-logs?page=<%= pagination.page - 1 %><%= currentRole ? '&role=' + currentRole : '' %><%= currentAction ? '&action=' + currentAction : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>">&laquo;</a>
                            </li>
                            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                            <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                <a class="page-link <%= i === pagination.page ? 'bg-primary border-primary' : 'bg-dark border-secondary' %>" href="/admin/activity-logs?page=<%= i %><%= currentRole ? '&role=' + currentRole : '' %><%= currentAction ? '&action=' + currentAction : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>"><%= i %></a>
                            </li>
                            <% } %>
                            <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                                <a class="page-link bg-dark border-secondary text-white-50" href="/admin/activity-logs?page=<%= pagination.page + 1 %><%= currentRole ? '&role=' + currentRole : '' %><%= currentAction ? '&action=' + currentAction : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                    <% } %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-clock-rotate-left fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('admin:activityLogs.noLogs') %></h4>
                    <p class="text-white-50"><%= t('admin:activityLogs.noLogsMatch') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
