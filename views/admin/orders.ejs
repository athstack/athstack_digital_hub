<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.orders') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-receipt me-2 text-primary"></i><%= t('admin:orders.heading') %></h2>
                </div>

                <% if (orders && orders.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr><th><%= t('admin:words.order') %></th><th><%= t('admin:words.customer') %></th><th><%= t('common:words.email') %></th><th><%= t('common:words.date') %></th><th><%= t('common:words.total') %></th><th><%= t('common:words.status') %></th><th><%= t('admin:words.action') %></th></tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                <tr>
                                    <td class="text-white fw-bold">#<%= order.id %><% if (order.order_reference) { %><br><small class="text-white-50"><%= order.order_reference %></small><% } %></td>
                                    <td class="text-white-50"><%= formatDisplayName(order.first_name, order.last_name) %></td>
                                    <td class="text-white-50 small"><%= order.email %></td>
                                    <td class="text-white-50"><%= formatDate(order.created_at) %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(order.total_amount) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(order.status || order.order_status) %>"><%= t('admin:status.' + ((order.status || order.order_status)||'').toLowerCase(), {defaultValue: order.status || order.order_status}) %></span></td>
                                    <td>
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abButton:true, abIcon:'fa-pen', abTitle:t('admin:orders.updateOrder', {id: order.id}), abAttrs:'data-bs-toggle="modal" data-bs-target="#orderModal' + order.id + '"' }) %>
                                        </div>
                                        <div class="modal fade" id="orderModal<%= order.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                                                    <form method="POST" action="/admin/orders/<%= order.id %>/status">
                                                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                        <div class="modal-header border-secondary">
                                                            <h5 class="text-white fw-bold"><%= t('admin:orders.updateOrder', {id: order.id}) %></h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <label class="form-label"><%= t('admin:orders.orderStatusLabel') %></label>
                                                            <select name="status" class="form-select" required>
                                                                <option value="pending" <%= (order.status || order.order_status) === 'pending' ? 'selected' : '' %>><%= t('admin:status.pending') %></option>
                                                                <option value="processing" <%= (order.status || order.order_status) === 'processing' ? 'selected' : '' %>><%= t('admin:status.processing') %></option>
                                                                <option value="shipped" <%= (order.status || order.order_status) === 'shipped' ? 'selected' : '' %>><%= t('admin:status.shipped') %></option>
                                                                <option value="delivered" <%= (order.status || order.order_status) === 'delivered' ? 'selected' : '' %>><%= t('admin:status.delivered') %></option>
                                                                <option value="cancelled" <%= (order.status || order.order_status) === 'cancelled' ? 'selected' : '' %>><%= t('admin:status.cancelled') %></option>
                                                            </select>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                                                            <button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('common:words.update') %></button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-receipt fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('admin:orders.noOrders') %></h4>
                    <p class="text-white-50"><%= t('admin:orders.noOrdersPlaced') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
