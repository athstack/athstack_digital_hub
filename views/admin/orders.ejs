<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.orders') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-receipt me-2 text-primary"></i><%= t('admin:orders.heading') %></h2>
                </div>

                <div data-crud-table data-crud-url="/admin/orders">
                    <%- include('./partials/ordersTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Order detail modal -->
<div class="modal fade crud-modal" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orderDetailTitle"><%= t('admin:orders.detailTitle') %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="orderDetailBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.close') %></button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    var modalEl = document.getElementById('orderDetailModal');
    var bodyEl = document.getElementById('orderDetailBody');
    var titleEl = document.getElementById('orderDetailTitle');
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        detailTitle: '<%= t('admin:orders.detailTitle') %>',
        orderReference: '<%= t('admin:orders.orderReference') %>',
        customer: '<%= t('admin:orders.customer') %>',
        placedAt: '<%= t('admin:orders.placedAt') %>',
        paymentMethod: '<%= t('admin:orders.paymentMethod') %>',
        paymentStatus: '<%= t('admin:orders.paymentStatus') %>',
        shippingAddress: '<%= t('admin:orders.shippingAddress') %>',
        noAddress: '<%= t('admin:orders.noAddress') %>',
        orderStatus: '<%= t('admin:orders.orderStatusLabel') %>',
        updateFailed: '<%= t('admin:orders.updateFailed') %>',
        networkError: '<%= t('admin:orders.networkError') %>',
        statusUpdated: '<%= t('admin:flash.orderStatusUpdated') %>',
        product: '<%= t('dashboard:words.product') %>',
        qty: '<%= t('dashboard:words.qty') %>',
        unitPrice: '<%= t('dashboard:words.unitPrice') %>',
        subtotal: '<%= t('dashboard:words.subtotal') %>',
        total: '<%= t('common:words.total') %>',
        email: '<%= t('common:words.email') %>',
        phone: '<%= t('common:words.phone') %>',
        noItems: '<%= t('dashboard:orderDetail.noItems') %>'
    };

    var paymentColors = { paid: 'bg-success', unpaid: 'bg-warning text-dark', failed: 'bg-danger', pending: 'bg-warning text-dark', refunded: 'bg-secondary' };

    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function statusBadge(status, colorMap) {
        var key = String(status || '').toLowerCase();
        var color = (colorMap && colorMap[key]) || 'bg-secondary';
        var label = esc(status || '');
        return '<span class="badge text-capitalize ' + color + '">' + label + '</span>';
    }

    function renderDetail(o) {
        var itemsHtml = '';
        var itemCount = 0;
        if (o.items && o.items.length > 0) {
            itemsHtml = '<div class="table-responsive"><table class="table table-dark align-middle mb-0 premium-table">' +
                '<thead><tr><th>' + i18n.product + '</th><th>' + i18n.qty + '</th><th>' + i18n.unitPrice + '</th><th>' + i18n.subtotal + '</th></tr></thead><tbody>';
            o.items.forEach(function (it) {
                itemCount += it.quantity || 0;
                itemsHtml += '<tr>' +
                    '<td class="text-white fw-bold">' + esc(it.product_name) + '</td>' +
                    '<td class="text-white-50">' + esc(it.quantity) + '</td>' +
                    '<td class="text-white-50">' + esc(it.unit_price_formatted) + '</td>' +
                    '<td class="text-primary fw-bold">' + esc(it.total_price_formatted) + '</td>' +
                    '</tr>';
            });
            itemsHtml += '</tbody></table></div>';
        } else {
            itemsHtml = '<p class="text-white-50 mb-0">' + i18n.noItems + '</p>';
        }

        var customerHtml = o.first_name || o.last_name ? esc([o.first_name, o.last_name].filter(Boolean).join(' ')) : '—';
        var emailHtml = o.email ? '<div class="small text-white-50"><i class="fa-solid fa-envelope me-1"></i>' + esc(o.email) + '</div>' : '';
        var phoneHtml = o.phone ? '<div class="small text-white-50"><i class="fa-solid fa-phone me-1"></i>' + esc(o.phone) + '</div>' : '';
        var addressHtml = o.shipping_address ? esc(o.shipping_address) : '<span class="text-white-50 fst-italic">' + i18n.noAddress + '</span>';

        var html =
            '<div class="row g-4">' +
            '<div class="col-md-6">' +
            '<div class="glass-card p-4 h-100">' +
            '<h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-box me-2 text-primary"></i>' + i18n.orderReference + '</h6>' +
            '<p class="text-white mb-1 fw-bold">#' + esc(o.id) + '</p>' +
            (o.order_reference ? '<p class="text-white-50 small mb-1">' + esc(o.order_reference) + '</p>' : '') +
            '<p class="text-white-50 mb-0 small"><i class="fa-solid fa-calendar me-1"></i>' + esc(o.created_at_formatted) + '</p>' +
            '</div>' +
            '</div>' +
            '<div class="col-md-6">' +
            '<div class="glass-card p-4 h-100">' +
            '<h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-user me-2 text-primary"></i>' + i18n.customer + '</h6>' +
            '<p class="text-white mb-1">' + customerHtml + '</p>' +
            emailHtml + phoneHtml +
            '</div>' +
            '</div>' +
            '<div class="col-md-6">' +
            '<div class="glass-card p-4 h-100">' +
            '<h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-truck me-2 text-primary"></i>' + i18n.shippingAddress + '</h6>' +
            '<p class="text-white-50 mb-0">' + addressHtml + '</p>' +
            '</div>' +
            '</div>' +
            '<div class="col-md-6">' +
            '<div class="glass-card p-4 h-100">' +
            '<h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-credit-card me-2 text-primary"></i>' + i18n.paymentMethod + '</h6>' +
            '<p class="text-white mb-1">' + esc((o.payment_method || '—').toUpperCase()) + '</p>' +
            '<p class="text-white-50 mb-0 small">' + i18n.paymentStatus + ': ' + statusBadge(o.payment_status, paymentColors) + '</p>' +
            '</div>' +
            '</div>' +
            '</div>' +
            '<div class="glass-card p-4 mt-4">' +
            '<h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-boxes-stacked me-2 text-primary"></i>' + i18n.product + ' (' + itemCount + ')</h6>' +
            itemsHtml +
            '<div class="d-flex justify-content-end align-items-center gap-3 mt-3">' +
            '<span class="text-white-50">' + i18n.total + '</span>' +
            '<span class="text-primary fw-bold fs-5">' + esc(o.total_formatted) + '</span>' +
            '</div>' +
            '</div>';

        return html;
    }

    function openDetail(id) {
        Crud.get('/admin/orders/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.order) return;
                var o = data.order;
                titleEl.textContent = i18n.detailTitle + ' #' + o.id;
                bodyEl.innerHTML = renderDetail(o);
                Crud.openModal(modalEl);
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    tableWrap.addEventListener('click', function (e) {
        var viewBtn = e.target.closest('[data-view-order]');
        if (viewBtn) {
            e.preventDefault();
            openDetail(viewBtn.getAttribute('data-id'));
        }
    });

    tableWrap.addEventListener('change', function (e) {
        var statusSel = e.target.closest('.order-status-select');
        if (!statusSel) return;
        var orig = statusSel.getAttribute('data-original');
        var oid = statusSel.getAttribute('data-order-id');
        Crud.post('/admin/orders/' + oid + '/status', { status: statusSel.value })
            .then(function (data) {
                statusSel.setAttribute('data-original', statusSel.value);
                Crud.toast(data.message || i18n.statusUpdated, 'success');
            })
            .catch(function (err) {
                statusSel.value = orig;
                Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
            });
    });

    Crud.initTable(tableWrap);
})();
</script>

<%- include('../partials/footer') %>
