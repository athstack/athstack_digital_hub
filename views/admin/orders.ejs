<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-receipt me-2 text-primary"></i>All Orders</h2>

                <% if (orders && orders.length > 0) { %>
                <div class="glass-card no-lift p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th>Order</th><th>Customer</th><th>Email</th><th>Date</th><th>Total</th><th>Status</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                <tr>
                                    <td class="text-white fw-bold">#<%= order.id %><% if (order.order_reference) { %><br><small class="text-muted"><%= order.order_reference %></small><% } %></td>
                                    <td class="text-muted"><%= order.first_name %> <%= order.last_name %></td>
                                    <td class="text-muted small"><%= order.email %></td>
                                    <td class="text-muted"><%= formatDate(order.created_at) %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(order.total_amount) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(order.status || order.order_status) %>"><%= order.status || order.order_status %></span></td>
                                    <td>
                                        <button type="button" class="btn btn-premium-outline btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#orderModal<%= order.id %>">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <div class="modal fade" id="orderModal<%= order.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                                                    <form method="POST" action="/admin/orders/<%= order.id %>/status">
                                                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                        <div class="modal-header border-secondary">
                                                            <h5 class="text-white fw-bold">Update Order #<%= order.id %></h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <label class="form-label">Order Status</label>
                                                            <select name="status" class="form-select" required>
                                                                <option value="pending" <%= (order.status || order.order_status) === 'pending' ? 'selected' : '' %>>Pending</option>
                                                                <option value="processing" <%= (order.status || order.order_status) === 'processing' ? 'selected' : '' %>>Processing</option>
                                                                <option value="shipped" <%= (order.status || order.order_status) === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                                                <option value="delivered" <%= (order.status || order.order_status) === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                                                <option value="cancelled" <%= (order.status || order.order_status) === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                                            </select>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-premium-primary rounded-pill">Update</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-receipt fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Orders</h4>
                    <p class="text-muted">No orders have been placed yet.</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
