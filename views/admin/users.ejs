<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.users') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-users me-2 text-primary"></i><%= t('admin:users.heading') %></h2>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-premium-primary rounded-pill" id="addUserBtn"><i class="fa-solid fa-user-plus me-2"></i><%= t('admin:users.addUser') %></button>
                    </div>
                </div>

                <div data-crud-table data-crud-url="/admin/users">
                    <%- include('./partials/usersTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- User add / edit modal -->
<div class="modal fade crud-modal" id="userModal" tabindex="-1" aria-labelledby="userModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="userForm" method="POST" action="/admin/users" novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title" id="userModalTitle"><%= t('admin:userForm.headingCreate') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="pf-first-name"><%= t('admin:userForm.firstName') %></label>
                            <input type="text" class="form-control" id="pf-first-name" name="first_name" placeholder="<%= t('admin:userForm.firstNamePlaceholder') %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-last-name"><%= t('admin:userForm.lastName') %></label>
                            <input type="text" class="form-control" id="pf-last-name" name="last_name" placeholder="<%= t('admin:userForm.lastNamePlaceholder') %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-email"><%= t('common:words.email') %></label>
                            <input type="email" class="form-control" id="pf-email" name="email" placeholder="user@example.com" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-phone"><%= t('common:words.phone') %></label>
                            <input type="text" class="form-control" id="pf-phone" name="phone" placeholder="+255 7XX XXX XXX">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-role"><%= t('admin:users.roleLabel') %></label>
                            <select class="form-select" id="pf-role" name="role" required>
                                <option value="customer"><%= t('admin:roles.customer') %></option>
                                <option value="technician"><%= t('admin:roles.technician') %></option>
                                <option value="marketing_officer"><%= t('admin:roles.marketingOfficer') %></option>
                                <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                                <option value="admin"><%= t('admin:roles.admin') %></option>
                                <option value="super_admin"><%= t('admin:roles.superAdmin') %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pf-status"><%= t('common:words.status') %></label>
                            <select class="form-select" id="pf-status" name="status" required>
                                <option value="active"><%= t('admin:status.active') %></option>
                                <option value="inactive"><%= t('admin:status.inactive') %></option>
                                <option value="suspended"><%= t('admin:status.suspended') %></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="pf-password"><%= t('admin:userForm.password') %> <span class="text-white-50" id="pf-password-hint" style="display:none;"><%= t('admin:userForm.leaveBlank') %></span></label>
                            <input type="password" class="form-control" id="pf-password" name="password" placeholder="<%= t('admin:userForm.enterPassword') %>" minlength="6" autocomplete="new-password">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill" id="userSubmitBtn"><i class="fa-solid fa-user-plus me-1"></i><%= t('admin:userForm.createUser') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    var modalEl = document.getElementById('userModal');
    var form = document.getElementById('userForm');
    var titleEl = document.getElementById('userModalTitle');
    var submitBtn = document.getElementById('userSubmitBtn');
    var addBtn = document.getElementById('addUserBtn');
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        headingCreate: '<%= t('admin:userForm.headingCreate') %>',
        headingEdit: '<%= t('admin:userForm.headingEdit') %>',
        createUser: '<%= t('admin:userForm.createUser') %>',
        updateUser: '<%= t('admin:userForm.updateUser') %>',
        userCreated: '<%= t('admin:flash.userCreated', { name: '' }) %>',
        userUpdated: '<%= t('admin:flash.userUpdated') %>',
        userDeleted: '<%= t('admin:flash.userDeleted', { name: '' }) %>',
        deleteTitle: '<%= t('admin:users.deleteTitle') %>',
        deleteConfirm: '<%= t('admin:users.deleteConfirm') %>',
        deleteFailed: '<%= t('admin:users.deleteFailed') %>',
        updateFailed: '<%= t('admin:users.updateFailed') %>',
        networkError: '<%= t('admin:users.networkError') %>',
        roleUpdated: '<%= t('admin:flash.roleUpdated') %>',
        statusUpdated: '<%= t('admin:flash.statusUpdated') %>',
        cancel: '<%= t('common:words.cancel') %>',
        delete: '<%= t('common:words.delete') %>',
        enterPassword: '<%= t('admin:userForm.enterPassword') %>',
        leaveBlank: '<%= t('admin:userForm.leaveBlankPlaceholder') %>'
    };

    var currentUserId = <%- JSON.stringify(user ? user.id : null) %>;
    var isSuperAdmin = <%- JSON.stringify(typeof isSuperAdmin !== 'undefined' && isSuperAdmin) %>;

    function resetForm() {
        form.reset();
        Crud.clearErrors(form);
        form.action = '/admin/users';
        titleEl.textContent = i18n.headingCreate;
        submitBtn.innerHTML = '<i class="fa-solid fa-user-plus me-1"></i>' + i18n.createUser;
        form.elements['password'].required = true;
        form.elements['password'].placeholder = i18n.enterPassword;
        document.getElementById('pf-password-hint').style.display = 'none';
        form.elements['role'].disabled = false;
        form.elements['status'].disabled = false;
    }

    function openAdd() {
        resetForm();
        Crud.openModal(modalEl);
    }

    function openEdit(id) {
        Crud.get('/admin/users/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.user) return;
                resetForm();
                var u = data.user;
                form.action = '/admin/users/' + id;
                titleEl.textContent = i18n.headingEdit;
                submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>' + i18n.updateUser;
                form.elements['password'].required = false;
                form.elements['password'].placeholder = i18n.leaveBlank;
                document.getElementById('pf-password-hint').style.display = 'inline';

                form.elements['first_name'].value = u.first_name || '';
                form.elements['last_name'].value = u.last_name || '';
                form.elements['email'].value = u.email || '';
                form.elements['phone'].value = u.phone || '';
                form.elements['status'].value = u.status || 'active';

                var roleSel = form.elements['role'];
                var existingOpt = roleSel.querySelector('option[value="' + u.role + '"]');
                if (!existingOpt) {
                    var opt = document.createElement('option');
                    opt.value = u.role;
                    opt.textContent = u.role.replace(/_/g, ' ');
                    roleSel.appendChild(opt);
                }
                roleSel.value = u.role;

                var isSelf = String(u.id) === String(currentUserId);
                roleSel.disabled = isSelf;
                form.elements['status'].disabled = isSelf;

                Crud.openModal(modalEl);
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    addBtn.addEventListener('click', openAdd);

    tableWrap.addEventListener('click', function (e) {
        var editBtn = e.target.closest('[data-edit-user]');
        if (editBtn) {
            e.preventDefault();
            openEdit(editBtn.getAttribute('data-id'));
            return;
        }

        var delBtn = e.target.closest('[data-delete-user]');
        if (delBtn) {
            e.preventDefault();
            var id = delBtn.getAttribute('data-id');
            var name = delBtn.getAttribute('data-name');
            Crud.confirm({
                title: i18n.deleteTitle,
                messageHtml: i18n.deleteConfirm.replace('{{name}}', '<strong class="text-white">' + Crud.esc(name || '') + '</strong>'),
                confirmText: i18n.delete
            }).then(function (ok) {
                if (!ok) return;
                Crud.post('/admin/users/' + id + '/delete')
                    .then(function (data) {
                        Crud.toast(data.message || i18n.userDeleted, 'success');
                        Crud.refreshTable({ wrap: tableWrap, url: '/admin/users' });
                    })
                    .catch(function (err) {
                        Crud.toast((err.data && err.data.message) || i18n.deleteFailed, 'error');
                    });
            });
            return;
        }
    });

    tableWrap.addEventListener('change', function (e) {
        var roleSel = e.target.closest('.role-select');
        if (roleSel) {
            var origRole = roleSel.getAttribute('data-original');
            var uid = roleSel.getAttribute('data-user-id');
            Crud.post('/admin/users/' + uid + '/role', { role: roleSel.value })
                .then(function (data) {
                    roleSel.setAttribute('data-original', roleSel.value);
                    Crud.toast(data.message || i18n.roleUpdated, 'success');
                })
                .catch(function (err) {
                    roleSel.value = origRole;
                    Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
                });
            return;
        }

        var statusSel = e.target.closest('.status-select');
        if (statusSel) {
            var origStatus = statusSel.getAttribute('data-original');
            var suid = statusSel.getAttribute('data-user-id');
            Crud.post('/admin/users/' + suid + '/status', { status: statusSel.value })
                .then(function (data) {
                    statusSel.setAttribute('data-original', statusSel.value);
                    Crud.toast(data.message || i18n.statusUpdated, 'success');
                })
                .catch(function (err) {
                    statusSel.value = origStatus;
                    Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
                });
            return;
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        Crud.submitForm(form, {
            onSuccess: function (data) {
                Crud.closeModal(modalEl);
                Crud.toast(data.message || i18n.userCreated, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/admin/users' });
            }
        });
    });

    Crud.initTable(tableWrap);
})();
</script>

<%- include('../partials/footer') %>
