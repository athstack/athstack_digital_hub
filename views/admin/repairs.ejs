<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.repairs') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-wrench me-2 text-primary"></i><%= t('admin:repairs.heading') %></h2>
                </div>

                <% if (repairs && repairs.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr><th><%= t('admin:words.reference') %></th><th><%= t('admin:words.customer') %></th><th><%= t('admin:words.service') %></th><th><%= t('admin:words.device') %></th><th><%= t('admin:repairs.assignedTo') %></th><th><%= t('common:words.date') %></th><th><%= t('common:words.status') %></th><th><%= t('admin:words.action') %></th></tr>
                            </thead>
                            <tbody>
                                <% repairs.forEach(repair => { %>
                                <tr>
                                    <td class="text-white fw-bold"><%= repair.reference_number || 'N/A' %></td>
                                    <td class="text-white-50"><%= repair.customer_name %></td>
                                    <td class="text-white-50"><%= repair.service_title || 'N/A' %></td>
                                    <td class="text-white-50"><%= repair.device_type || '' %> <%= repair.device_brand || '' %></td>
                                    <td class="text-white-50"><% if (repair.technician_first_name) { %><%= formatDisplayName(repair.technician_first_name, repair.technician_last_name) %><% } else { %><span class="text-warning"><%= t('admin:repairs.unassigned') %></span><% } %></td>
                                    <td class="text-white-50"><%= formatDate(repair.appointment_date) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(repair.status) %>"><%= t('admin:status.' + (repair.status||'').toLowerCase(), {defaultValue: repair.status}) %></span></td>
                                    <td>
                                        <% if (can('assign_repairs')) { %>
                                        <button type="button" class="btn btn-premium-outline btn-sm rounded-pill assign-trigger" data-bs-toggle="modal" data-bs-target="#assignTechnicianModal" data-repair-id="<%= repair.id %>" data-reference="<%= repair.reference_number %>">
                                            <i class="fa-solid fa-user-plus"></i><%= repair.technician_first_name ? ' ' + t('admin:repairs.reassign') : '' %>
                                        </button>
                                        <% } else { %>
                                        <span class="text-success small"><i class="fa-solid fa-check-circle me-1"></i><%= repair.technician_first_name ? t('admin:status.assigned') : t('admin:repairs.unassigned') %></span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-wrench fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('admin:repairs.noRepairs') %></h4>
                    <p class="text-white-50"><%= t('admin:repairs.noRepairsSubmitted') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="assignTechnicianModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
            <form method="POST" action="" id="assignForm">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header border-secondary pt-4">
                    <h5 class="text-white fw-bold"><%= t('admin:repairs.assignTechnicianTitle') %> - <span id="assignReference"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label"><%= t('admin:repairs.selectTechnician') %></label>
                    <select name="technician_id" class="form-select" required>
                        <option value=""><%= (technicians && technicians.length > 0) ? t('admin:repairs.chooseTechnician') : t('admin:repairs.noTechnicians') %></option>
                        <% if (technicians && technicians.length > 0) { technicians.forEach(tech => { %>
                        <option value="<%= tech.id %>"><%= formatDisplayName(tech.first_name, tech.last_name) %><%= tech.role !== 'technician' ? ' (' + t('admin:words.admin') + ')' : '' %></option>
                        <% }) } %>
                    </select>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('admin:repairs.assign') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.assign-trigger').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.dataset.repairId;
            var ref = this.dataset.reference;
            document.getElementById('assignReference').textContent = ref;
            document.getElementById('assignForm').action = '/admin/repairs/' + id + '/assign';
        });
    });
});
</script>

<%- include('../partials/footer') %>
