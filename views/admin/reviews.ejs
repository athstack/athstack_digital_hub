<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge">Reviews</span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-star me-2 text-warning"></i>Review Moderation</h2>
                    <div class="ms-auto d-flex gap-2 align-items-center">
                        <% if (pendingCount > 0) { %>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><%= pendingCount %> pending</span>
                        <% } %>
                        <% if (reportedCount > 0) { %>
                        <span class="badge bg-danger rounded-pill px-3 py-2"><%= reportedCount %> reported</span>
                        <% } %>
                        <button type="button" class="btn btn-premium-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#addReviewModal"><i class="fa-solid fa-plus me-1"></i>Add Review</button>
                    </div>
                </div>

                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                    <a href="/admin/reviews" class="btn btn-sm rounded-pill<%= !currentStatus && !isReportedFilter ? ' btn-primary' : ' btn-outline-secondary' %>">All</a>
                    <a href="/admin/reviews?status=pending" class="btn btn-sm rounded-pill<%= currentStatus === 'pending' ? ' btn-warning text-dark' : ' btn-outline-secondary' %>">Pending <% if (pendingCount > 0) { %>(<%= pendingCount %>)<% } %></a>
                    <a href="/admin/reviews?status=approved" class="btn btn-sm rounded-pill<%= currentStatus === 'approved' ? ' btn-success' : ' btn-outline-secondary' %>">Approved</a>
                    <a href="/admin/reviews?status=rejected" class="btn btn-sm rounded-pill<%= currentStatus === 'rejected' ? ' btn-danger' : ' btn-outline-secondary' %>">Rejected</a>
                    <a href="/admin/reviews?reported=1" class="btn btn-sm rounded-pill<%= isReportedFilter ? ' btn-danger' : ' btn-outline-secondary' %>">Reported <% if (reportedCount > 0) { %>(<%= reportedCount %>)<% } %></a>
                </div>

                <form method="GET" action="/admin/reviews" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Search by user, product, or review text..." value="<%= currentSearch || '' %>">
                        <button class="btn btn-premium-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                </form>

                <% if (reviews && reviews.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 premium-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Review</th>
                                    <th>Rating</th>
                                    <th>Verified</th>
                                    <th>Photos</th>
                                    <th>Helpful</th>
                                    <th>Reports</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reviews.forEach(review => { %>
                                <tr class="<%= review.is_hidden ? 'table-danger' : '' %>">
                                    <td>
                                        <div class="text-white"><%= formatDisplayName(review.first_name, review.last_name) %></div>
                                        <small class="text-white-50"><%= review.email %></small>
                                    </td>
                                    <td>
                                        <% if (review.product_name) { %>
                                        <div class="text-white mb-1"><%= review.product_name %></div>
                                        <% } %>
                                        <% if (review.title) { %>
                                        <div class="text-white-50 small fw-semibold"><%= review.title %></div>
                                        <% } %>
                                        <% if (review.comment) { %>
                                        <p class="text-white-50 mb-0 small" style="max-width:280px;"><%= review.comment %></p>
                                        <% } else { %>
                                        <span class="text-white-50 small fst-italic">No comment</span>
                                        <% } %>
                                        <% if (review.pending_reports > 0) { %>
                                        <span class="badge bg-danger mt-1"><i class="fa-regular fa-flag me-1"></i><%= review.pending_reports %> open report<%= review.pending_reports !== 1 ? 's' : '' %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="text-warning" style="white-space:nowrap;">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="fa-<%= i <= review.rating ? 'solid' : 'regular' %> fa-star small"></i>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (review.is_verified) { %>
                                        <span class="verified-badge"><i class="fa-solid fa-circle-check"></i></span>
                                        <% } else { %>
                                        <span class="text-white-50">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (review.images && review.images.length > 0) { %>
                                        <span class="badge bg-info text-dark rounded-pill"><i class="fa-solid fa-camera me-1"></i><%= review.images.length %></span>
                                        <% } else { %>
                                        <span class="text-white-50">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-white-50"><%= review.helpful_count || 0 %></td>
                                    <td>
                                        <% if (review.reported_count > 0) { %>
                                        <span class="badge bg-danger rounded-pill"><%= review.reported_count %></span>
                                        <% } else { %>
                                        <span class="text-white-50">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (review.status === 'pending') { %>
                                        <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                        <% } else if (review.status === 'approved') { %>
                                        <span class="badge bg-success rounded-pill">Approved</span>
                                        <% } else { %>
                                        <span class="badge bg-danger rounded-pill">Rejected</span>
                                        <% } %>
                                        <% if (review.is_hidden) { %>
                                        <span class="badge bg-secondary rounded-pill mt-1 d-block">Hidden</span>
                                        <% } %>
                                    </td>
                                    <td><small class="text-white-50"><%= review.created_at ? new Date(review.created_at).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : '' %></small></td>
                                    <td>
                                        <div class="review-actions">
                                            <button type="button" class="btn-action btn-action-edit" title="Reply to review" data-bs-toggle="modal" data-bs-target="#replyReviewModal" data-review-id="<%= review.id %>" data-review-name="<%= review.product_name || '' %>"><i class="fa-solid fa-reply"></i></button>
                                            <a href="/admin/reviews/<%= review.id %>/edit" class="btn-action btn-action-edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                            <form method="POST" action="/admin/reviews/<%= review.id %>/hide" class="d-inline">
                                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-action btn-action-hide" title="<%= review.is_hidden ? 'Unhide' : 'Hide' %>"><i class="fa-solid <%= review.is_hidden ? 'fa-eye' : 'fa-eye-slash' %>"></i></button>
                                            </form>
                                            <form method="POST" action="/admin/reviews/<%= review.id %>/delete" class="d-inline" data-confirm="Delete this review?">
                                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-action btn-action-delete" title="Delete"><i class="fa-solid fa-trash-can"></i></button>
                                            </form>
                                            <% if (review.status === 'pending') { %>
                                            <form method="POST" action="/admin/reviews/<%= review.id %>/approve" class="d-inline">
                                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-action btn-action-approve" title="Approve"><i class="fa-solid fa-check"></i></button>
                                            </form>
                                            <form method="POST" action="/admin/reviews/<%= review.id %>/reject" class="d-inline">
                                                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-action btn-action-reject" title="Reject"><i class="fa-solid fa-xmark"></i></button>
                                            </form>
                                            <% } else if (review.approver_first_name) { %>
                                            <span class="approver-label"><%= formatDisplayName(review.approver_first_name, review.approver_last_name) %></span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <% if (pagination.totalPages > 1) { %>
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item<%= pagination.hasPrev ? '' : ' disabled' %>">
                            <a class="page-link" href="?page=<%= pagination.page - 1 %><%= currentStatus ? '&status=' + currentStatus : '' %><%= isReportedFilter ? '&reported=1' : '' %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>">Prev</a>
                        </li>
                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <li class="page-item<%= i === pagination.page ? ' active' : '' %>">
                            <a class="page-link" href="?page=<%= i %><%= currentStatus ? '&status=' + currentStatus : '' %><%= isReportedFilter ? '&reported=1' : '' %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>"><%= i %></a>
                        </li>
                        <% } %>
                        <li class="page-item<%= pagination.hasNext ? '' : ' disabled' %>">
                            <a class="page-link" href="?page=<%= pagination.page + 1 %><%= currentStatus ? '&status=' + currentStatus : '' %><%= isReportedFilter ? '&reported=1' : '' %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>">Next</a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-star fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Reviews</h4>
                    <p class="text-white-50">No reviews found<%= currentStatus ? ' with status "' + currentStatus + '"' : '' %><%= isReportedFilter ? ' with open reports' : '' %>.</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Reply to Review Modal -->
<div class="modal fade" id="replyReviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-reply me-2 text-primary"></i>Reply to Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/admin/reviews/0/reply" id="replyReviewForm">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-body">
                    <p class="text-white-50 small" id="replyReviewProductName"></p>
                    <div class="mb-0">
                        <label class="form-label">Response</label>
                        <textarea name="reply" class="form-control" rows="4" maxlength="2000" placeholder="Write a helpful response to this reviewer..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-paper-plane me-2"></i>Post Reply</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Review Modal -->
<div class="modal fade" id="addReviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-star me-2 text-warning"></i>Add Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/admin/reviews/add">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">User ID</label>
                        <input type="number" name="user_id" class="form-control" placeholder="Enter user ID" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Product ID</label>
                        <input type="number" name="product_id" class="form-control" placeholder="Enter product ID" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <select name="rating" class="form-select" required>
                            <% for (let i = 1; i <= 5; i++) { %>
                            <option value="<%= i %>"><%= i %> Star<%= i > 1 ? 's' : '' %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select">
                            <option value="product">Product</option>
                            <option value="technician">Technician</option>
                            <option value="service">Service</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="pending">Pending</option>
                            <option value="approved" selected>Approved</option>
                            <option value="rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="title" class="form-control" maxlength="120" placeholder="Review title (optional)">
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Comment</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Review comment..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i>Create Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    var replyModal = document.getElementById('replyReviewModal');
    var replyForm = document.getElementById('replyReviewForm');
    var productName = document.getElementById('replyReviewProductName');
    if (replyModal && replyForm) {
        replyModal.addEventListener('show.bs.modal', function(e) {
            var btn = e.relatedTarget;
            var id = btn.getAttribute('data-review-id');
            var name = btn.getAttribute('data-review-name');
            replyForm.setAttribute('action', '/admin/reviews/' + id + '/reply');
            if (productName) productName.textContent = name ? ('Responding to review on: ' + name) : 'Responding to review';
        });
    }
})();
</script>

<%- include('../partials/footer') %>
