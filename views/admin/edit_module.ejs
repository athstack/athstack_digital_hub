<%- include('../partials/header') %>

<div class="container py-5">
    <div class="glass-card p-4">
        <h2 class="text-white mb-4">Edit Training Module</h2>
        <form action="/admin/editModule/<%= course.id %>" method="POST">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="id" value="<%= course.id %>">

        <div class="form-group mb-3">
            <label class="form-label">Course Title</label>
            <input type="text" name="title" class="form-control" value="<%= course.title %>" required>
        </div>
        
        <div class="form-group mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" required><%= course.description %></textarea>
        </div>
        
        <div class="form-group mb-3">
            <label class="form-label">Duration</label>
            <input type="text" name="duration" class="form-control" value="<%= course.duration %>" required>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-control">
                <option value="draft" <%= course.status === 'draft' ? 'selected' : '' %>>Draft</option>
                <option value="active" <%= course.status === 'active' ? 'selected' : '' %>>Active</option>
            </select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Difficulty Level</label>
            <select name="level" class="form-control">
                <option value="Beginner" <%= course.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                <option value="Intermediate" <%= course.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                <option value="Advanced" <%= course.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
            </select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Price (TZS)</label>
            <input type="number" name="price" class="form-control" step="0.01" value="<%= course.price %>">
        </div>

        <button type="submit" class="btn btn-primary">Update Training Module</button>
        <a href="/admin/training" class="btn btn-secondary">Cancel</a>
    </form>
    </div>
</div>

<%- include('../partials/footer') %>
