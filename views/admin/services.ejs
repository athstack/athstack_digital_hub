<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.services') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-screwdriver-wrench me-2 text-primary"></i><%= t('admin:services.heading') %></h2>
                    <div class="ms-auto">
                        <button class="btn btn-premium-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addServiceModal"><i class="fa-solid fa-plus me-2"></i><%= t('admin:services.addService') %></button>
                    </div>
                </div>

                <div data-crud-table data-crud-url="/admin/services">
                    <%- include('./partials/servicesTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add service modal -->
<div class="modal fade crud-modal" id="addServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" action="/admin/services/add" data-crud-form novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header"><h5 class="modal-title text-white fw-bold"><%= t('admin:services.addService') %></h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label"><%= t('admin:words.title') %></label><input type="text" name="title" class="form-control" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.category') %></label><select name="category" class="form-select"><option value="computer"><%= t('admin:words.computer') %></option><option value="phone"><%= t('admin:words.phone') %></option></select></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.description') %></label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.basePrice') %></label><input type="number" name="base_price" class="form-control" step="0.01" min="0" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.iconClass') %></label><input type="text" name="icon_class" class="form-control" value="fa-tools"></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.status') %></label><select name="status" class="form-select"><option value="active"><%= t('admin:status.active') %></option><option value="inactive"><%= t('admin:status.inactive') %></option></select></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-1"></i><%= t('admin:services.createService') %></button></div>
            </form>
        </div>
    </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        serviceCreated: '<%= t('admin:flash.serviceCreated') %>',
        serviceUpdated: '<%= t('admin:flash.serviceUpdated') %>',
        serviceDeleted: '<%= t('admin:flash.serviceDeleted') %>',
        deleteConfirm: '<%= t('admin:services.deleteConfirm') %>',
        delete: '<%= t('common:words.delete') %>',
        networkError: '<%= t('common:notifications.failedToLoad') %>'
    };

    tableWrap.addEventListener('click', function (e) {
        var delBtn = e.target.closest('[data-delete-service]');
        if (!delBtn) return;
        e.preventDefault();
        var id = delBtn.getAttribute('data-id');
        var name = delBtn.getAttribute('data-name');
        Crud.confirm({
            title: i18n.delete,
            message: i18n.deleteConfirm + (name ? ' <strong class="text-white">' + name + '</strong>' : ''),
            confirmText: i18n.delete
        }).then(function (ok) {
            if (!ok) return;
            Crud.post('/admin/services/delete/' + id)
                .then(function (data) {
                    Crud.toast(data.message || i18n.serviceDeleted, 'success');
                    Crud.refreshTable({ wrap: tableWrap, url: '/admin/services' });
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.networkError, 'error');
                });
        });
    });

    document.addEventListener('submit', function (e) {
        var form = e.target.closest('form[data-crud-form]');
        if (!form) return;
        e.preventDefault();
        var modal = form.closest('.modal');
        Crud.submitForm(form, {
            onSuccess: function (data) {
                if (modal) Crud.closeModal(modal);
                Crud.toast(data.message || i18n.serviceCreated, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/admin/services' });
            }
        });
    });

    Crud.initTable(tableWrap);
});
</script>

<%- include('../partials/footer') %>
