<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/adminSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><%= t('admin:words.services') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-screwdriver-wrench me-2 text-primary"></i><%= t('admin:services.heading') %></h2>
                    <div class="ms-auto">
                        <button class="btn btn-premium-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addServiceModal"><i class="fa-solid fa-plus me-2"></i><%= t('admin:services.addService') %></button>
                    </div>
                </div>

                <% if (services && services.length > 0) { %>
                <div class="glass-card p-4">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 premium-table">
                            <thead>
                                <tr><th><%= t('admin:words.title') %></th><th><%= t('common:words.category') %></th><th><%= t('common:words.price') %></th><th><%= t('common:words.status') %></th><th class="text-end"><%= t('common:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% services.forEach(service => { %>
                                <tr>
                                    <td class="text-white fw-bold"><i class="fa-solid <%= service.icon_class || 'fa-tools' %> me-2 text-primary"></i><%= service.title %></td>
                                    <td><span class="badge bg-secondary rounded-pill"><%= service.category === 'computer' ? t('admin:words.computer') : t('admin:words.phone') %></span></td>
                                    <td class="text-white"><%= formatCurrency(service.base_price) %></td>
                                    <td><span class="badge bg-<%= service.status === 'active' ? 'success' : 'secondary' %>"><%= t('admin:status.' + (service.status||'').toLowerCase(), {defaultValue: service.status}) %></span></td>
                                    <td class="text-end">
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abButton:true, abIcon:'fa-pen-to-square', abTitle:t('common:words.edit'), abAttrs:'data-bs-toggle="modal" data-bs-target="#editService' + service.id + '"' }) %>
                                            <%- include('../partials/actionButton', { abVariant:'delete', abIcon:'fa-trash-can', abFormAction:'/admin/services/delete/' + service.id, abFormCsrf:csrfToken, abConfirm:t('admin:services.deleteConfirm'), abTitle:t('common:words.delete') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state glass-card p-5">
                    <i class="fa-solid fa-screwdriver-wrench fa-3x mb-3"></i>
                    <h5 class="text-white fw-bold"><%= t('admin:services.noServices') %></h5>
                    <p class="text-white-50"><%= t('admin:services.noServicesHint') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<% if (typeof services !== 'undefined' && services && services.length > 0) { services.forEach(function(service) { %>
<div class="modal fade" id="editService<%= service.id %>" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
            <form method="POST" action="/admin/services/edit/<%= service.id %>">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header border-secondary"><h5 class="modal-title text-white fw-bold"><%= t('admin:services.editService') %></h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label"><%= t('admin:words.title') %></label><input type="text" name="title" class="form-control" value="<%= service.title %>" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.category') %></label><select name="category" class="form-select"><option value="computer" <%= service.category==='computer'?'selected':'' %>><%= t('admin:words.computer') %></option><option value="phone" <%= service.category==='phone'?'selected':'' %>><%= t('admin:words.phone') %></option></select></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.description') %></label><textarea name="description" class="form-control" rows="2"><%= service.description || '' %></textarea></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.basePrice') %></label><input type="number" name="base_price" class="form-control" step="0.01" value="<%= service.base_price %>" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.iconClass') %></label><input type="text" name="icon_class" class="form-control" value="<%= service.icon_class || 'fa-tools' %>"></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.status') %></label><select name="status" class="form-select"><option value="active" <%= service.status==='active'?'selected':'' %>><%= t('admin:status.active') %></option><option value="inactive" <%= service.status==='inactive'?'selected':'' %>><%= t('admin:status.inactive') %></option></select></div>
                </div>
                <div class="modal-footer border-secondary"><button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('common:words.saveChanges') %></button></div>
            </form>
        </div>
    </div>
</div>
<% }) } %>

<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
            <form method="POST" action="/admin/services/add">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header border-secondary"><h5 class="modal-title text-white fw-bold"><%= t('admin:services.addService') %></h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label"><%= t('admin:words.title') %></label><input type="text" name="title" class="form-control" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.category') %></label><select name="category" class="form-select"><option value="computer"><%= t('admin:words.computer') %></option><option value="phone"><%= t('admin:words.phone') %></option></select></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.description') %></label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.basePrice') %></label><input type="number" name="base_price" class="form-control" step="0.01" required></div>
                    <div class="mb-3"><label class="form-label"><%= t('admin:services.iconClass') %></label><input type="text" name="icon_class" class="form-control" value="fa-tools"></div>
                    <div class="mb-3"><label class="form-label"><%= t('common:words.status') %></label><select name="status" class="form-select"><option value="active"><%= t('admin:status.active') %></option><option value="inactive"><%= t('admin:status.inactive') %></option></select></div>
                </div>
                <div class="modal-footer border-secondary"><button type="submit" class="btn btn-premium-primary rounded-pill"><%= t('admin:services.createService') %></button></div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
