<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-envelope-open-text me-2 text-primary"></i><%= t('marketing:feedback.heading') %></h2>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:feedback.from') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:feedback.subject') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:feedback.message') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.date') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (messages.length > 0) { %>
                                <% messages.forEach(message => { %>
                                <tr>
                                    <td class="py-3 px-4">
                                        <div class="text-white small fw-semibold"><%= message.name %></div>
                                        <small class="text-muted"><%= message.email %></small>
                                    </td>
                                    <td class="py-3 px-4 text-white small"><%= message.subject || '—' %></td>
                                    <td class="py-3 px-4 text-muted small" style="max-width:320px;"><%= message.message %></td>
                                    <td class="py-3 px-4 text-muted small"><%= formatDate(message.created_at) %></td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-envelope-open-text fa-2x mb-2"></i><br>
                                        <%= t('marketing:feedback.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
