<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('marketing:reviews.rating') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-star-half-stroke me-2 text-primary"></i><%= t('marketing:reviews.heading') %></h2>
                </div>

                <div data-crud-table data-crud-url="/marketing/reviews">
                    <%- include('./partials/reviewsTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Review detail + reply modal -->
<div class="modal fade crud-modal" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="reviewReplyForm" method="POST" action="/marketing/reviews/0/reply" novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalTitle"><%= t('marketing:reviews.detailTitle') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('common:words.close') %>"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <small class="text-white-50 d-block"><%= t('marketing:reviews.product') %></small>
                            <span class="text-white" id="rr-product">—</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-white-50 d-block"><%= t('marketing:reviews.author') %></small>
                            <span class="text-white" id="rr-author">—</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-white-50 d-block"><%= t('marketing:reviews.rating') %></small>
                            <span class="text-warning" id="rr-rating">—</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-white-50 d-block"><%= t('common:words.date') %></small>
                            <span class="text-white" id="rr-date">—</span>
                        </div>
                        <div class="col-12">
                            <small class="text-white-50 d-block"><%= t('marketing:reviews.review') %></small>
                            <div class="text-white" id="rr-comment">—</div>
                        </div>
                        <div class="col-12 d-none" id="rr-reply-wrap">
                            <hr class="border-secondary opacity-25">
                            <small class="text-success d-block mb-1"><i class="fa-solid fa-reply me-1"></i><%= t('marketing:reviews.repliedAt') %> <span class="text-white-50" id="rr-reply-date"></span></small>
                            <div class="text-white-50" id="rr-reply"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="rr-reply-input"><%= t('marketing:reviews.reply') %></label>
                        <textarea class="form-control" id="rr-reply-input" name="reply" rows="3" placeholder="<%= t('marketing:reviews.replyPlaceholder') %>"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill" id="reviewReplySubmitBtn"><i class="fa-solid fa-paper-plane me-1"></i><%= t('marketing:reviews.sendReply') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var modalEl = document.getElementById('reviewModal');
    var form = document.getElementById('reviewReplyForm');
    var submitBtn = document.getElementById('reviewReplySubmitBtn');
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        detailTitle: '<%= t('marketing:reviews.detailTitle') %>',
        review: '<%= t('marketing:reviews.review') %>',
        reply: '<%= t('marketing:reviews.reply') %>',
        repliedAt: '<%= t('marketing:reviews.repliedAt') %>',
        untitled: '<%= t('marketing:reviews.untitled') %>',
        updateFailed: '<%= t('marketing:reviews.updateFailed') %>',
        networkError: '<%= t('marketing:reviews.networkError') %>'
    };

    function openDetail(id) {
        Crud.get('/marketing/reviews/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.review) return;
                var r = data.review;
                form.action = '/marketing/reviews/' + id + '/reply';
                document.getElementById('rr-product').textContent = r.product_name || '—';
                document.getElementById('rr-author').textContent = r.author || '—';
                document.getElementById('rr-rating').textContent = '★'.repeat(r.rating);
                document.getElementById('rr-date').textContent = r.created_at_formatted || '—';
                document.getElementById('rr-comment').textContent = (r.title ? r.title + ' — ' : '') + (r.comment || '—');
                document.getElementById('rr-reply-input').value = '';

                var wrap = document.getElementById('rr-reply-wrap');
                if (r.seller_reply) {
                    document.getElementById('rr-reply').textContent = r.seller_reply;
                    document.getElementById('rr-reply-date').textContent = r.seller_replied_at_formatted || '';
                    wrap.classList.remove('d-none');
                } else {
                    wrap.classList.add('d-none');
                }

                Crud.clearErrors(form);
                Crud.openModal(modalEl);
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    tableWrap.addEventListener('click', function (e) {
        var viewBtn = e.target.closest('[data-view-review]');
        if (viewBtn) {
            e.preventDefault();
            openDetail(viewBtn.getAttribute('data-id'));
            return;
        }

        var hideBtn = e.target.closest('[data-toggle-review-hide]');
        if (hideBtn) {
            e.preventDefault();
            hideBtn.disabled = true;
            Crud.post('/marketing/reviews/' + hideBtn.getAttribute('data-id') + '/hide')
                .then(function (data) {
                    Crud.toast(data.message, 'success');
                    Crud.refreshTable({ wrap: tableWrap, url: '/marketing/reviews' });
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
                })
                .then(function () { hideBtn.disabled = false; });
            return;
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.elements['reply'].value.trim()) {
            Crud.toast('<%= t('marketing:flash.replyRequired') %>', 'error');
            return;
        }
        Crud.submitForm(form, {
            onSuccess: function (data) {
                Crud.closeModal(modalEl);
                Crud.toast(data.message || i18n.reply, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/marketing/reviews' });
            }
        });
    });

    Crud.initTable(tableWrap);
});
</script>

<%- include('../partials/footer') %>
