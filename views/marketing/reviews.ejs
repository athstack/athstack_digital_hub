<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-star-half-stroke me-2 text-primary"></i><%= t('marketing:reviews.heading') %></h2>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reviews.review') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reviews.product') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reviews.rating') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reviews.reply') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;"><%= t('marketing:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (reviews.length > 0) { %>
                                <% reviews.forEach(review => { %>
                                <tr>
                                    <td class="py-3 px-4">
                                        <div class="text-white small fw-semibold"><%= review.title || t('marketing:reviews.untitled') %></div>
                                        <div class="text-muted small" style="max-width:280px;"><%= review.comment || '' %></div>
                                        <small class="text-muted"><%= review.first_name ? review.first_name + ' ' + review.last_name : '—' %> · <%= formatDate(review.created_at) %></small>
                                        <% if (review.is_hidden) { %><span class="badge bg-secondary ms-1"><%= t('marketing:reviews.hidden') %></span><% } %>
                                    </td>
                                    <td class="py-3 px-4 text-muted small"><%= review.product_name || '—' %></td>
                                    <td class="py-3 px-4 text-warning"><%= '★'.repeat(review.rating) %></td>
                                    <td class="py-3 px-4">
                                        <% if (review.seller_reply) { %>
                                        <div class="text-muted small" style="max-width:260px;">
                                            <span class="text-success"><i class="fa-solid fa-reply me-1"></i></span><%= review.seller_reply %>
                                        </div>
                                        <% } else { %>
                                        <form method="POST" action="/marketing/reviews/<%= review.id %>/reply" class="d-flex gap-1">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <input type="text" name="reply" class="form-control form-control-sm" placeholder="<%= t('marketing:reviews.replyPlaceholder') %>" required>
                                            <button type="submit" class="action-btn action-btn--publish flex-shrink-0" title="<%= t('marketing:reviews.reply') %>" aria-label="<%= t('marketing:reviews.reply') %>"><i class="fa-solid fa-paper-plane"></i></button>
                                        </form>
                                        <% } %>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'hide', abFormAction:'/marketing/reviews/' + review.id + '/hide', abFormCsrf:csrfToken, abOn: review.is_hidden, abIcon: review.is_hidden ? 'fa-eye-slash' : 'fa-eye', abTitle: review.is_hidden ? t('marketing:reviews.unhide') : t('marketing:reviews.hide') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-star-half-stroke fa-2x mb-2"></i><br>
                                        <%= t('marketing:reviews.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
