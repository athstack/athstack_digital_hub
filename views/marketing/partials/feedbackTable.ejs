<div class="crud-toolbar">
    <div class="crud-toolbar__grow">
        <div class="position-relative">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input type="search"
                   class="form-control ps-5"
                   placeholder="<%= t('marketing:feedback.searchPlaceholder') %>"
                   value="<%= searchQuery %>"
                   data-crud-search
                   data-crud-param="search"
                   aria-label="<%= t('marketing:feedback.searchPlaceholder') %>">
        </div>
    </div>
    <button type="button" class="btn btn-premium-outline rounded-pill" data-crud-refresh title="<%= t('marketing:feedback.refresh') %>">
        <i class="fa-solid fa-rotate"></i>
    </button>
</div>

<% if (messages && messages.length > 0) { %>
<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark align-middle mb-0 premium-table">
            <thead>
                <tr><th><%= t('marketing:feedback.from') %></th><th><%= t('marketing:feedback.subject') %></th><th><%= t('marketing:feedback.message') %></th><th><%= t('common:words.date') %></th><th class="col-actions"><%= t('marketing:words.actions') %></th></tr>
            </thead>
            <tbody>
                <% messages.forEach(message => { %>
                <tr>
                    <td>
                        <div class="text-white small fw-semibold"><%= message.name %></div>
                        <small class="text-white-50"><%= message.email %></small>
                    </td>
                    <td class="text-white small"><%= message.subject || '—' %></td>
                    <td class="text-white-50 small" style="max-width:320px;"><%= message.message %></td>
                    <td class="text-white-50 small"><%= formatDate(message.created_at) %></td>
                    <td class="col-actions">
                        <div class="action-cell">
                            <%- include('../../partials/actionButton', { abVariant:'view', abButton:true, abIcon:'fa-eye', abAttrs:'data-view-message data-id="' + message.id + '"', abTitle:t('marketing:feedback.view') }) %>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } else { %>
<div class="empty-state glass-card p-5">
    <i class="fa-solid fa-envelope-open-text fa-4x mb-3"></i>
    <% if (searchQuery) { %>
    <h4 class="text-white fw-bold"><%= t('marketing:feedback.noMessages') %></h4>
    <p class="text-white-50"><%= t('marketing:feedback.noMessagesMatch') %></p>
    <% } else { %>
    <h4 class="text-white fw-bold"><%= t('marketing:feedback.noMessages') %></h4>
    <p class="text-white-50"><%= t('marketing:feedback.empty') %></p>
    <% } %>
</div>
<% } %>
