<div class="crud-toolbar">
    <div class="crud-toolbar__grow"></div>
    <button type="button" class="btn btn-premium-outline rounded-pill" data-crud-refresh title="<%= t('marketing:coupons.refresh') %>">
        <i class="fa-solid fa-rotate"></i>
    </button>
</div>

<% if (coupons && coupons.length > 0) { %>
<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark align-middle mb-0 premium-table">
            <thead>
                <tr><th><%= t('marketing:coupons.code') %></th><th><%= t('marketing:coupons.value') %></th><th><%= t('marketing:coupons.used') %></th><th><%= t('common:words.status') %></th><th class="col-actions"><%= t('marketing:words.actions') %></th></tr>
            </thead>
            <tbody>
                <% coupons.forEach(coupon => { %>
                <tr>
                    <td>
                        <span class="badge bg-primary bg-opacity-25 text-primary" style="letter-spacing:0.05em;"><%= coupon.code %></span>
                        <% if (coupon.name) { %><div class="small text-white-50 mt-1"><%= coupon.name %></div><% } %>
                    </td>
                    <td class="text-white"><%= coupon.type === 'percentage' ? coupon.value + '%' : formatCurrency(coupon.value) %></td>
                    <td class="text-white-50"><%= coupon.used_count %><% if (coupon.max_uses) { %> / <%= coupon.max_uses %><% } %></td>
                    <td>
                        <span class="badge <%= coupon.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= t('marketing:status.' + coupon.status, { defaultValue: coupon.status }) %></span>
                    </td>
                    <td class="col-actions">
                        <div class="action-cell">
                            <%- include('../../partials/actionButton', { abVariant:'edit', abButton:true, abIcon:'fa-pen-to-square', abAttrs:'data-edit-coupon data-id="' + coupon.id + '"', abTitle:t('common:words.edit') }) %>
                            <%- include('../../partials/actionButton', { abVariant:'publish', abButton:true, abOn: coupon.status === 'active', abIcon: coupon.status === 'active' ? 'fa-pause' : 'fa-play', abAttrs:'data-toggle-coupon-status data-id="' + coupon.id + '" data-status="' + coupon.status + '"', abTitle: coupon.status === 'active' ? t('marketing:coupons.pause') : t('marketing:coupons.activate') }) %>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } else { %>
<div class="empty-state glass-card p-5">
    <i class="fa-solid fa-ticket fa-4x mb-3"></i>
    <h4 class="text-white fw-bold"><%= t('marketing:coupons.noCoupons') %></h4>
    <p class="text-white-50"><%= t('marketing:coupons.empty') %></p>
</div>
<% } %>
