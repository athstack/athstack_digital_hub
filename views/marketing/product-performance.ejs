<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><i class="fa-solid fa-ranking-star me-1"></i><%= t('marketing:productPerformance.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-ranking-star me-2 text-primary"></i><%= t('marketing:productPerformance.heading') %></h2>
                </div>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.product') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-center" style="font-size:0.65rem;"><%= t('marketing:productPerformance.unitsSold') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-center" style="font-size:0.65rem;"><%= t('marketing:productPerformance.lifetimeSales') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;"><%= t('marketing:productPerformance.revenue') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-center" style="font-size:0.65rem;"><%= t('marketing:productPerformance.promoted') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (products.length > 0) { %>
                                <% products.forEach(product => { %>
                                <tr>
                                    <td class="py-3 px-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <% if (product.main_image) { %>
                                            <img src="<%= imageUrl(product.main_image, 'products') %>" alt="" style="height:36px;width:48px;object-fit:cover;border-radius:6px;">
                                            <% } %>
                                            <div>
                                                <div class="text-white small fw-semibold"><%= product.name %></div>
                                                <small class="text-muted"><%= formatCurrency(product.price) %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 text-white text-center fw-medium"><%= product.sold_quantity %></td>
                                    <td class="py-3 px-4 text-white text-center fw-medium"><%= product.total_sales %></td>
                                    <td class="py-3 px-4 text-end"><span style="color:#10B981;font-weight:500;"><%= formatCurrency(product.sold_revenue) %></span></td>
                                    <td class="py-3 px-4 text-center">
                                        <% if (product.is_promoted) { %>
                                        <span class="badge bg-success"><i class="fa-solid fa-bullhorn me-1"></i><%= t('marketing:productPerformance.promoted') %></span>
                                        <% } else if (product.featured) { %>
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i><%= t('marketing:productPerformance.featured') %></span>
                                        <% } else { %>
                                        <span class="text-muted">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-ranking-star fa-2x mb-2"></i><br>
                                        <%= t('marketing:productPerformance.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
