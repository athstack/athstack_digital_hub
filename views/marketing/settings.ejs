<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-gear me-2 text-primary"></i><%= t('marketing:settings.heading') %></h2>

                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="glass-card no-lift p-4">
                    <form method="POST" action="/marketing/settings">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"><%= t('marketing:settings.companyName') %></label>
                                <input type="text" name="company_name" class="form-control" value="<%= settings.marketing_company_name || '' %>" placeholder="<%= t('marketing:settings.companyNamePlaceholder') %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('marketing:settings.defaultFromEmail') %></label>
                                <input type="email" name="default_from_email" class="form-control" value="<%= settings.marketing_default_from_email || '' %>" placeholder="<%= t('marketing:settings.defaultFromEmailPlaceholder') %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label"><%= t('marketing:settings.newsletterFooter') %></label>
                                <textarea name="newsletter_footer" class="form-control" rows="3" placeholder="<%= t('marketing:settings.newsletterFooterPlaceholder') %>"><%= settings.marketing_newsletter_footer || '' %></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('marketing:settings.socialFacebook') %></label>
                                <input type="url" name="social_facebook" class="form-control" value="<%= settings.marketing_social_facebook || '' %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('marketing:settings.socialTwitter') %></label>
                                <input type="url" name="social_twitter" class="form-control" value="<%= settings.marketing_social_twitter || '' %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('marketing:settings.socialInstagram') %></label>
                                <input type="url" name="social_instagram" class="form-control" value="<%= settings.marketing_social_instagram || '' %>">
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-save me-2"></i><%= t('marketing:settings.save') %></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
