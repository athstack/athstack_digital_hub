<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('marketing:coupons.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-ticket me-2 text-primary"></i><%= t('marketing:coupons.heading') %></h2>
                    <div class="ms-auto">
                        <button type="button" class="btn btn-premium-primary rounded-pill" id="addCouponBtn"><i class="fa-solid fa-plus me-2"></i><%= t('marketing:coupons.newCoupon') %></button>
                    </div>
                </div>

                <div data-crud-table data-crud-url="/marketing/coupons">
                    <%- include('./partials/couponsTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Coupon add / edit modal -->
<div class="modal fade crud-modal" id="couponModal" tabindex="-1" aria-labelledby="couponModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="couponForm" method="POST" action="/marketing/coupons" novalidate>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title" id="couponModalTitle"><%= t('marketing:couponForm.headingCreate') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="cpf-name"><%= t('marketing:couponForm.name') %></label>
                            <input type="text" class="form-control" id="cpf-name" name="name" maxlength="200" placeholder="<%= t('marketing:couponForm.namePlaceholder') %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-code"><%= t('marketing:couponForm.code') %></label>
                            <input type="text" class="form-control" id="cpf-code" name="code" maxlength="50" placeholder="WELCOME10" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-type"><%= t('marketing:couponForm.type') %></label>
                            <select class="form-select" id="cpf-type" name="type">
                                <option value="percentage"><%= t('marketing:couponForm.percentage') %></option>
                                <option value="fixed"><%= t('marketing:couponForm.fixed') %></option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-value"><%= t('marketing:couponForm.value') %></label>
                            <input type="number" class="form-control" id="cpf-value" name="value" min="0" step="0.01" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-min-order"><%= t('marketing:couponForm.minOrder') %></label>
                            <input type="number" class="form-control" id="cpf-min-order" name="min_order" min="0" step="0.01">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-max-uses"><%= t('marketing:couponForm.maxUses') %></label>
                            <input type="number" class="form-control" id="cpf-max-uses" name="max_uses" min="0" step="1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-status"><%= t('common:words.status') %></label>
                            <select class="form-select" id="cpf-status" name="status">
                                <option value="active"><%= t('marketing:status.active') %></option>
                                <option value="inactive"><%= t('marketing:status.inactive') %></option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-starts-at"><%= t('marketing:couponForm.startDate') %></label>
                            <input type="datetime-local" class="form-control" id="cpf-starts-at" name="starts_at">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cpf-expires-at"><%= t('marketing:couponForm.expiryDate') %></label>
                            <input type="datetime-local" class="form-control" id="cpf-expires-at" name="expires_at">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal"><%= t('common:words.cancel') %></button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill" id="couponSubmitBtn"><i class="fa-solid fa-plus me-1"></i><%= t('marketing:couponForm.createCoupon') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var modalEl = document.getElementById('couponModal');
    var form = document.getElementById('couponForm');
    var titleEl = document.getElementById('couponModalTitle');
    var submitBtn = document.getElementById('couponSubmitBtn');
    var addBtn = document.getElementById('addCouponBtn');
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        headingCreate: '<%= t('marketing:couponForm.headingCreate') %>',
        headingEdit: '<%= t('marketing:couponForm.headingEdit') %>',
        createCoupon: '<%= t('marketing:couponForm.createCoupon') %>',
        updateCoupon: '<%= t('marketing:couponForm.updateCoupon') %>',
        couponCreated: '<%= t('marketing:flash.couponCreated') %>',
        couponUpdated: '<%= t('marketing:flash.couponUpdated') %>',
        couponStatusUpdated: '<%= t('marketing:flash.couponStatusUpdated') %>',
        couponCodeExists: '<%= t('marketing:flash.couponCodeExists') %>',
        updateFailed: '<%= t('marketing:coupons.updateFailed') %>',
        networkError: '<%= t('marketing:coupons.networkError') %>'
    };

    function resetForm() {
        form.reset();
        Crud.clearErrors(form);
        form.action = '/marketing/coupons';
        titleEl.textContent = i18n.headingCreate;
        submitBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i>' + i18n.createCoupon;
    }

    function openAdd() {
        resetForm();
        Crud.openModal(modalEl);
    }

    function openEdit(id) {
        Crud.get('/marketing/coupons/' + id)
            .then(function (data) {
                if (!data || !data.success || !data.coupon) return;
                resetForm();
                var c = data.coupon;
                form.action = '/marketing/coupons/' + id;
                titleEl.textContent = i18n.headingEdit;
                submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>' + i18n.updateCoupon;

                form.elements['name'].value = c.name || '';
                form.elements['code'].value = c.code || '';
                form.elements['type'].value = c.type || 'percentage';
                form.elements['value'].value = c.value != null ? c.value : '';
                form.elements['min_order'].value = c.min_order != null ? c.min_order : '';
                form.elements['max_uses'].value = c.max_uses != null ? c.max_uses : '';
                form.elements['status'].value = c.status || 'active';
                form.elements['starts_at'].value = c.starts_at || '';
                form.elements['expires_at'].value = c.expires_at || '';

                Crud.openModal(modalEl);
            })
            .catch(function () {
                Crud.toast(i18n.networkError, 'error');
            });
    }

    addBtn.addEventListener('click', openAdd);

    tableWrap.addEventListener('click', function (e) {
        var editBtn = e.target.closest('[data-edit-coupon]');
        if (editBtn) {
            e.preventDefault();
            openEdit(editBtn.getAttribute('data-id'));
            return;
        }

        var toggle = e.target.closest('[data-toggle-coupon-status]');
        if (toggle) {
            e.preventDefault();
            var tid = toggle.getAttribute('data-id');
            toggle.disabled = true;
            Crud.post('/marketing/coupons/' + tid + '/status')
                .then(function (data) {
                    Crud.toast(data.message || i18n.couponStatusUpdated, 'success');
                    Crud.refreshTable({ wrap: tableWrap, url: '/marketing/coupons' });
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
                })
                .then(function () { toggle.disabled = false; });
            return;
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        Crud.submitForm(form, {
            onSuccess: function (data) {
                Crud.closeModal(modalEl);
                Crud.toast(data.message || i18n.couponCreated, 'success');
                Crud.refreshTable({ wrap: tableWrap, url: '/marketing/coupons' });
            }
        });
    });

    Crud.initTable(tableWrap);
});
</script>

<%- include('../partials/footer') %>
