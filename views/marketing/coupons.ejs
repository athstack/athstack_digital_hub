<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
                    <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-ticket me-2 text-primary"></i><%= t('marketing:coupons.heading') %></h2>
                    <a href="/marketing/coupons/new" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-plus me-2"></i><%= t('marketing:coupons.newCoupon') %></a>
                </div>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:coupons.code') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:coupons.value') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:coupons.used') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.status') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;"><%= t('marketing:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (coupons.length > 0) { %>
                                <% coupons.forEach(coupon => { %>
                                <tr>
                                    <td class="py-3 px-4">
                                        <span class="badge bg-primary bg-opacity-25 text-primary" style="letter-spacing:0.05em;"><%= coupon.code %></span>
                                        <% if (coupon.name) { %><div class="small text-muted mt-1"><%= coupon.name %></div><% } %>
                                    </td>
                                    <td class="py-3 px-4 text-white"><%= coupon.type === 'percentage' ? coupon.value + '%' : formatCurrency(coupon.value) %></td>
                                    <td class="py-3 px-4 text-muted"><%= coupon.used_count %><% if (coupon.max_uses) { %> / <%= coupon.max_uses %><% } %></td>
                                    <td class="py-3 px-4"><span class="badge <%= coupon.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= t('marketing:status.' + coupon.status) %></span></td>
                                    <td class="py-3 px-4 text-end">
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abHref:'/marketing/coupons/' + coupon.id + '/edit', abTitle:t('common:words.edit') }) %>
                                            <%- include('../partials/actionButton', { abVariant:'publish', abFormAction:'/marketing/coupons/' + coupon.id + '/status', abFormCsrf:csrfToken, abOn: coupon.status === 'active', abIcon: coupon.status === 'active' ? 'fa-pause' : 'fa-play', abTitle: coupon.status === 'active' ? t('marketing:campaigns.pause') : t('marketing:campaigns.activate') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-ticket fa-2x mb-2"></i><br>
                                        <%= t('marketing:coupons.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
