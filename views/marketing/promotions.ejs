<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
                    <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-tags me-2 text-primary"></i><%= t('marketing:promotions.heading') %></h2>
                    <a href="/marketing/promotions/new" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-plus me-2"></i><%= t('marketing:promotions.newPromotion') %></a>
                </div>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.title') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.subtitle') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.status') %></th><th class="py-3 px-4 text-white-50 text-uppercase text-end" style="font-size:0.65rem;"><%= t('marketing:words.actions') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (promotions.length > 0) { %>
                                <% promotions.forEach(promo => { %>
                                <tr>
                                    <td class="py-3 px-4 text-white fw-semibold"><%= promo.title %></td>
                                    <td class="py-3 px-4 text-muted"><%= promo.subtitle || '—' %></td>
                                    <td class="py-3 px-4"><span class="badge <%= promo.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= t('marketing:status.' + promo.status) %></span></td>
                                    <td class="py-3 px-4 text-end">
                                        <div class="action-cell">
                                            <%- include('../partials/actionButton', { abVariant:'edit', abHref:'/marketing/promotions/' + promo.id + '/edit', abTitle:t('common:words.edit') }) %>
                                            <%- include('../partials/actionButton', { abVariant:'publish', abFormAction:'/marketing/promotions/' + promo.id + '/status', abFormCsrf:csrfToken, abOn: promo.status === 'active', abIcon: promo.status === 'active' ? 'fa-pause' : 'fa-play', abTitle: promo.status === 'active' ? t('marketing:campaigns.pause') : t('marketing:campaigns.activate') }) %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-tags fa-2x mb-2"></i><br>
                                        <%= t('marketing:promotions.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
