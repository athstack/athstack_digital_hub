<%- include('../partials/header') %>

<section class="py-5" data-aos="fade-up">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <span class="section-badge"><%= t('marketing:newsletters.subscribed') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-envelope-circle-check me-2 text-primary"></i><%= t('marketing:newsletters.heading') %></h2>
                </div>

                <div data-crud-table data-crud-url="/marketing/newsletters">
                    <%- include('./partials/newslettersTable') %>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function() {
    'use strict';
    var tableWrap = document.querySelector('[data-crud-table]');

    var i18n = {
        updateFailed: '<%= t('marketing:newsletters.updateFailed') %>',
        deleteFailed: '<%= t('marketing:newsletters.deleteFailed') %>',
        networkError: '<%= t('marketing:newsletters.networkError') %>',
        subscriberStatusUpdated: '<%= t('marketing:flash.subscriberStatusUpdated') %>',
        subscriberAdded: '<%= t('marketing:flash.subscriberAdded') %>',
        subscriberDeleted: '<%= t('marketing:flash.subscriberDeleted') %>',
        newsletterSent: '<%= t('marketing:flash.newsletterSent') %>',
        deleteTitle: '<%= t('common:words.delete') %>',
        deleteConfirm: '<%= t('common:confirm.areYouSure') %>',
        delete: '<%= t('common:words.delete') %>'
    };

    function refresh() {
        return Crud.refreshTable({ wrap: tableWrap, url: '/marketing/newsletters' });
    }

    tableWrap.addEventListener('click', function (e) {
        var toggleBtn = e.target.closest('[data-toggle-subscriber]');
        if (toggleBtn) {
            e.preventDefault();
            toggleBtn.disabled = true;
            Crud.post('/marketing/newsletters/subscribers/' + toggleBtn.getAttribute('data-id') + '/status')
                .then(function (data) {
                    Crud.toast(data.message || i18n.subscriberStatusUpdated, 'success');
                    return refresh();
                })
                .catch(function (err) {
                    Crud.toast((err.data && err.data.message) || i18n.updateFailed, 'error');
                })
                .then(function () { toggleBtn.disabled = false; });
            return;
        }

        var delBtn = e.target.closest('[data-delete-subscriber]');
        if (delBtn) {
            e.preventDefault();
            var id = delBtn.getAttribute('data-id');
            var email = delBtn.getAttribute('data-email');
            Crud.confirm({
                title: i18n.deleteTitle,
                messageHtml: i18n.deleteConfirm + ' <strong class="text-white">' + Crud.esc(email || '') + '</strong>?',
                confirmText: i18n.delete,
                okIcon: 'fa-trash'
            }).then(function (ok) {
                if (!ok) return;
                Crud.post('/marketing/newsletters/subscribers/' + id + '/delete')
                    .then(function (data) {
                        Crud.toast(data.message || i18n.subscriberDeleted, 'success');
                        return refresh();
                    })
                    .catch(function (err) {
                        Crud.toast((err.data && err.data.message) || i18n.deleteFailed, 'error');
                    });
            });
        }
    });

    tableWrap.addEventListener('submit', function (e) {
        var addForm = e.target.closest('.newsletter-add-form');
        if (addForm) {
            e.preventDefault();
            Crud.submitForm(addForm, {
                onSuccess: function (data) {
                    addForm.reset();
                    Crud.toast(data.message || i18n.subscriberAdded, 'success');
                    refresh();
                }
            });
            return;
        }

        var sendForm = e.target.closest('.newsletter-send-form');
        if (sendForm) {
            e.preventDefault();
            Crud.submitForm(sendForm, {
                onSuccess: function (data) {
                    sendForm.reset();
                    Crud.toast(data.message || i18n.newsletterSent, 'success');
                    refresh();
                }
            });
        }
    });

    Crud.initTable(tableWrap);
})();
</script>

<%- include('../partials/footer') %>
