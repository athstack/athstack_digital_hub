<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="section-badge"><i class="fa-solid fa-bullseye me-1"></i><%= t('marketing:campaignAnalytics.badge') %></span>
                    <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-bullseye me-2 text-primary"></i><%= t('marketing:campaignAnalytics.heading') %></h2>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-bullhorn fa-xl text-primary mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= campaigns.length %></h4>
                            <p class="text-white-50 small mb-0"><%= t('marketing:campaignAnalytics.totalCampaigns') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-play fa-xl text-success mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= campaigns.filter(c => c.status === 'active').length %></h4>
                            <p class="text-white-50 small mb-0"><%= t('marketing:campaignAnalytics.activeCampaigns') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-box-archive fa-xl text-secondary mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= campaigns.filter(c => c.status === 'archived' || c.status === 'completed').length %></h4>
                            <p class="text-white-50 small mb-0"><%= t('marketing:campaignAnalytics.finishedCampaigns') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-3 text-center">
                            <i class="fa-solid fa-dollar-sign fa-xl text-warning mb-2"></i>
                            <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;"><%= formatCurrency(totalSales) %></h4>
                            <p class="text-white-50 small mb-0"><%= t('marketing:campaignAnalytics.totalSales') %></p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-0">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.title') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.goal') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:words.budget') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.status') %></th><th class="py-3 px-4 text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.date') %></th></tr>
                            </thead>
                            <tbody>
                                <% if (campaigns.length > 0) { %>
                                <% campaigns.forEach(campaign => { %>
                                <tr>
                                    <td class="py-3 px-4 text-white fw-semibold"><%= campaign.title %></td>
                                    <td class="py-3 px-4 text-muted"><%= campaign.goal || '—' %></td>
                                    <td class="py-3 px-4 text-white"><%= campaign.budget ? formatCurrency(campaign.budget) : '—' %></td>
                                    <td class="py-3 px-4"><span class="badge <%= campaign.status === 'active' ? 'bg-success' : (campaign.status === 'archived' || campaign.status === 'completed' ? 'bg-secondary' : (campaign.status === 'paused' ? 'bg-warning text-dark' : 'bg-info text-dark')) %>"><%= t('marketing:status.' + campaign.status) %></span></td>
                                    <td class="py-3 px-4 text-muted"><%= formatDate(campaign.starts_at || campaign.created_at) %></td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5" style="color:rgba(255,255,255,0.3);">
                                        <i class="fa-solid fa-bullseye fa-2x mb-2"></i><br>
                                        <%= t('marketing:campaignAnalytics.empty') %>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
