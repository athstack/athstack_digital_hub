<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/marketingSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-badge"><i class="fa-solid fa-file-lines me-1"></i><%= t('marketing:reports.badge') %></span>
                        <h2 class="text-white fw-bold mb-0 tracking-widest"><i class="fa-solid fa-file-lines me-2 text-primary"></i><%= t('marketing:reports.heading') %></h2>
                    </div>
                    <button class="btn btn-premium-outline btn-sm rounded-pill" onclick="window.print()"><i class="fa-solid fa-print me-1"></i><%= t('marketing:reports.print') %></button>
                </div>

                <div class="glass-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-chart-pie me-2 text-primary"></i><%= t('marketing:reports.summary') %></h5>
                        <small class="text-muted"><%= t('marketing:reports.generated') %>: <%= formatDate(report.generated_at) %></small>
                    </div>
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.campaigns %></div>
                                <small class="text-white-50"><%= t('marketing:reports.campaigns') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.active_promotions %></div>
                                <small class="text-white-50"><%= t('marketing:reports.activePromotions') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.coupons %></div>
                                <small class="text-white-50"><%= t('marketing:reports.coupons') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.blog_posts %></div>
                                <small class="text-white-50"><%= t('marketing:reports.blogPosts') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.subscribers %></div>
                                <small class="text-white-50"><%= t('marketing:reports.subscribers') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-white fw-bold fs-5"><%= report.reviews %></div>
                                <small class="text-white-50"><%= t('marketing:reports.reviews') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-success fw-bold fs-5"><%= formatCurrency(report.total_sales) %></div>
                                <small class="text-white-50"><%= t('marketing:reports.totalSales') %></small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:rgba(255,255,255,0.03);">
                                <div class="text-primary fw-bold fs-5"><%= report.total_visitors %></div>
                                <small class="text-white-50"><%= t('marketing:reports.totalVisitors') %></small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i><%= t('marketing:reports.recentOrders') %></h5>
                    <% if (recentOrders.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th class="text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reports.reference') %></th><th class="text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reports.customer') %></th><th class="text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('marketing:reports.amount') %></th><th class="text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.status') %></th><th class="text-white-50 text-uppercase" style="font-size:0.65rem;"><%= t('common:words.date') %></th></tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td class="text-white small"><%= order.order_reference %></td>
                                    <td class="text-muted small"><%= order.first_name + ' ' + order.last_name %></td>
                                    <td class="text-success small fw-semibold"><%= formatCurrency(order.total_amount) %></td>
                                    <td><span class="badge <%= order.order_status === 'delivered' || order.order_status === 'completed' ? 'bg-success' : (order.order_status === 'cancelled' ? 'bg-danger' : 'bg-primary') %>"><%= order.order_status %></span></td>
                                    <td class="text-muted small"><%= formatDate(order.created_at) %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <p class="text-muted small mb-0 text-center py-3"><%= t('marketing:reports.noOrders') %></p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
