<%- include('../partials/header') %>

<section class="auth-section">
    <div class="container position-relative z-1">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card">
                    <div class="auth-brand">
                        <a href="/" class="gap-1" style="display:inline-flex;align-items:center;line-height:1;text-decoration:none;">
                            <img src="/images/techbridge-logo.png" alt="TechBridge Digital Hub" style="height:52px;width:auto;">
                            <span class="text-white fw-bold" style="font-size:1.35rem;letter-spacing:-0.02em;line-height:1;">Tech<span class="text-primary">Bridge</span></span>
                        </a>
                    </div>
                    <div class="text-center mb-4">
                        <h3 class="auth-heading"><%= t('auth:login.heading') %></h3>
                        <p class="auth-subtext"><%= t('auth:login.subtext') %></p>
                    </div>

                    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                    <div class="alert alert-success"><i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %></div>
                    <% } %>
                    <% if (error) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-triangle me-2"></i><%= error %></div>
                    <% } %>

                    <div id="loginError" class="alert alert-danger d-none">
                        <i class="fa-solid fa-exclamation-triangle me-2"></i><span id="loginErrorText"></span>
                    </div>

                    <form id="loginForm" method="POST" action="/auth/login" novalidate>
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label"><%= t('auth:words.emailAddress') %></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" name="email" class="form-control" required placeholder="<%= t('auth:login.emailPlaceholder') %>" autocomplete="email">
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label"><%= t('common:words.password') %></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" name="password" class="form-control" required placeholder="<%= t('auth:login.passwordPlaceholder') %>" autocomplete="current-password">
                            </div>
                        </div>
                    <button type="submit" id="loginBtn" class="btn btn-premium-primary w-100 btn-lg mb-3">
                        <i class="fa-solid fa-right-to-bracket me-2"></i><span id="loginBtnText"><%= t('auth:login.submit') %></span>
                    </button>
                    </form>

                    <div class="auth-divider"></div>

                    <div class="text-center">
                        <a href="/auth/forgot" class="text-primary small text-link"><%= t('auth:login.forgotPassword') %></a>
                        <p class="text-muted small mt-2 mb-0"><%= t('auth:login.noAccount') %> <a href="/auth/register" class="text-primary text-link"><%= t('auth:login.createOne') %></a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function() {
    var form = document.getElementById('loginForm');
    var errorDiv = document.getElementById('loginError');
    var errorText = document.getElementById('loginErrorText');
    var btn = document.getElementById('loginBtn');
    var btnText = document.getElementById('loginBtnText');

    function showError(msg) {
        errorText.textContent = msg;
        errorDiv.classList.remove('d-none');
    }

    function hideError() {
        errorDiv.classList.add('d-none');
        errorText.textContent = '';
    }

    function setLoading(loading) {
        btn.disabled = loading;
        if (loading) {
            btnText.textContent = '<%= t('auth:login.signingIn') %>';
            btn.querySelector('i').className = 'fa-solid fa-spinner fa-spin me-2';
        } else {
            btnText.textContent = '<%= t('auth:login.submit') %>';
            btn.querySelector('i').className = 'fa-solid fa-right-to-bracket me-2';
        }
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        hideError();

        var formData = new FormData(form);
        var params = new URLSearchParams(formData);
        setLoading(true);

        fetch(form.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json'
            },
            body: params.toString()
        })
        .then(function(res) {
            var contentType = res.headers.get('content-type') || '';
            if (contentType.indexOf('application/json') !== -1) {
                return res.json().then(function(data) {
                    return { ok: res.ok, status: res.status, data: data };
                });
            }
            if (res.redirected) {
                return { ok: false, status: res.status, data: { success: false, message: '<%= t('auth:login.sessionExpired') %>' } };
            }
            return { ok: false, status: res.status, data: { success: false, message: '<%= t('auth:login.unexpectedResponse') %>' } };
        })
        .then(function(result) {
            if (result.ok && result.data.success) {
                window.location.href = result.data.redirect || '/dashboard';
            } else {
                showError(result.data.message || '<%= t('auth:login.loginFailed') %>');
                setLoading(false);
            }
        })
        .catch(function() {
            showError('<%= t('auth:login.networkError') %>');
            setLoading(false);
        });
    });
})();
</script>

<%- include('../partials/footer') %>
