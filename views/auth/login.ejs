<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="glass-card no-lift p-5">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;">
                            <i class="fa-solid fa-right-to-bracket fa-2x text-primary"></i>
                        </div>
                        <h3 class="text-white fw-bold">Access Authorization</h3>
                        <p class="text-muted small">Sign in to your Athstack account</p>
                    </div>

                    <% if (error) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-circle me-2"></i><%= error %></div>
                    <% } %>
                    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-circle me-2"></i><%= flashError %></div>
                    <% } %>
                    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                    <div class="alert alert-success"><i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %></div>
                    <% } %>

                    <form method="POST" action="/auth/login">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" name="email" class="form-control" required placeholder="your@email.com" autocomplete="email">
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" name="password" class="form-control" required placeholder="Your password" autocomplete="current-password">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100 rounded-pill btn-lg mb-3"><i class="fa-solid fa-right-to-bracket me-2"></i>Sign In</button>
                    </form>

                    <div class="text-center">
                        <a href="/auth/forgot" class="text-primary small">Forgot password?</a>
                        <p class="text-muted small mt-2 mb-0">Don't have an account? <a href="/auth/register" class="text-primary">Create one</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
