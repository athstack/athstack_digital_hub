<%- include('../partials/header') %>

<section class="auth-section">
    <div class="container position-relative z-1">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card">
                    <div class="auth-brand">
                        <a href="/" class="gap-1" style="display:inline-flex;align-items:center;line-height:1;text-decoration:none;">
                            <img src="/images/techbridge-logo.png" alt="TechBridge Digital Hub" style="height:52px;width:auto;">
                            <span class="text-white fw-bold" style="font-size:1.35rem;letter-spacing:-0.02em;line-height:1;">Tech<span class="text-primary">Bridge</span></span>
                        </a>
                    </div>
                    <div class="text-center mb-4">
                        <h3 class="auth-heading"><%= t('auth:forgot.heading') %></h3>
                        <p class="auth-subtext"><%= t('auth:forgot.subtext') %></p>
                    </div>

                    <% if (typeof flashInfo !== 'undefined' && flashInfo && flashInfo.length > 0) { %>
                    <div class="alert alert-info"><i class="fa-solid fa-info-circle me-2"></i><%= flashInfo %></div>
                    <% } %>
                    <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                    <div class="alert alert-success"><i class="fa-solid fa-check-circle me-2"></i><%= flashSuccess %></div>
                    <% } %>
                    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %></div>
                    <% } %>

                    <form method="POST" action="/auth/forgot">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="mb-4">
                            <label class="form-label"><%= t('auth:words.emailAddress') %></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" name="email" class="form-control" required placeholder="<%= t('auth:forgot.emailPlaceholder') %>">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100 btn-lg mb-3"><i class="fa-solid fa-paper-plane me-2"></i><%= t('auth:forgot.submit') %></button>
                    </form>

                    <div class="auth-divider"></div>

                    <div class="text-center">
                        <p class="text-muted small mb-0"><%= t('auth:forgot.rememberPassword') %> <a href="/auth/login" class="text-primary text-link"><%= t('auth:forgot.signIn') %></a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
