<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="glass-card no-lift p-5">
                    <div class="text-center mb-4">
                        <a href="/" class="gap-1" style="display:inline-flex;align-items:center;line-height:1;text-decoration:none;">
                            <img src="/images/techbridge-logo.png" alt="TechBridge Digital Hub" style="height:52px;width:auto;">
                            <span class="text-white fw-bold" style="font-size:1.35rem;letter-spacing:-0.02em;line-height:1;">Tech<span class="text-primary">Bridge</span></span>
                        </a>
                        <h3 class="text-white fw-bold">Create Account</h3>
                        <p class="text-muted small">Join TechBridge Digital Hub today</p>
                    </div>

                    <% if (typeof pendingMessage !== 'undefined' && pendingMessage) { %>
                    <div class="alert alert-info" style="background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.2);color:#7DD3FC;">
                        <i class="fa-solid fa-pen me-2"></i>You have a pending message. Create an account to send it.
                    </div>
                    <% } %>
                    <% if (error) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-triangle me-2"></i><%= error %></div>
                    <% } %>
                    <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                    <div class="alert alert-danger"><i class="fa-solid fa-exclamation-triangle me-2"></i><%= flashError %></div>
                    <% } %>

                    <form method="POST" action="/auth/register" autocomplete="off">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                    <input type="text" name="first_name" class="form-control" required placeholder="First name" pattern="[A-Za-z\s'-]{2,50}" title="2-50 characters, letters only">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                    <input type="text" name="last_name" class="form-control" required placeholder="Last name" pattern="[A-Za-z\s'-]{2,50}" title="2-50 characters, letters only">
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email Address *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                    <input type="email" name="email" class="form-control" required placeholder="your@email.com" value="<%= typeof pendingMessage !== 'undefined' && pendingMessage ? pendingMessage.email : '' %>">
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Country *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                                    <select name="country" id="countrySelect" class="form-select" placeholder="Select your country" required>
                                        <option value="">Select your country</option>
                                        <option value="NG" data-code="+234" data-placeholder="801 234 5678">Nigeria</option>
                                        <option value="TZ" data-code="+255" data-placeholder="7XX XXX XXX">Tanzania</option>
                                        <option value="KE" data-code="+254" data-placeholder="7XX XXX XXX">Kenya</option>
                                        <option value="UG" data-code="+256" data-placeholder="7XX XXX XXX">Uganda</option>
                                        <option value="ZA" data-code="+27" data-placeholder="8X XXX XXXX">South Africa</option>
                                        <option value="GH" data-code="+233" data-placeholder="2X XXX XXXX">Ghana</option>
                                        <option value="EG" data-code="+20" data-placeholder="1X XXX XXXX">Egypt</option>
                                        <option value="RW" data-code="+250" data-placeholder="7XX XXX XXX">Rwanda</option>
                                        <option value="ET" data-code="+251" data-placeholder="9XX XXX XXXX">Ethiopia</option>
                                        <option value="CD" data-code="+243" data-placeholder="8X XXX XXXX">DR Congo</option>
                                        <option value="CM" data-code="+237" data-placeholder="6XX XXX XXX">Cameroon</option>
                                        <option value="SN" data-code="+221" data-placeholder="7X XXX XX XX">Senegal</option>
                                        <option value="US" data-code="+1" data-placeholder="(XXX) XXX-XXXX">United States</option>
                                        <option value="GB" data-code="+44" data-placeholder="7XXX XXXXXX">United Kingdom</option>
                                        <option value="IN" data-code="+91" data-placeholder="XXXXX XXXXX">India</option>
                                        <option value="CN" data-code="+86" data-placeholder="1XX XXXX XXXX">China</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Phone Number</label>
                                <div class="input-group">
                                    <input type="text" id="phoneCode" class="form-control" value="+255" readonly style="max-width:90px;text-align:center;font-weight:600;border-right:none;border-radius:var(--radius-md) 0 0 var(--radius-md);background:var(--bg-elevated) !important;color:var(--text-main) !important;">
                                    <input type="tel" name="phone" id="phoneInput" class="form-control" placeholder="7XX XXX XXX" pattern="[0-9\s\-\+\(\)]*" title="Enter a valid phone number" style="border-left:none;border-radius:0 var(--radius-md) var(--radius-md) 0;">
                                </div>
                                <div class="form-text text-muted small">Enter your phone number without the country code</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                    <input type="password" name="password" id="regPassword" class="form-control" required placeholder="Min 8 characters" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="Minimum 8 characters with at least one uppercase, one lowercase, and one number" autocomplete="new-password">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Confirm Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                    <input type="password" name="confirm_password" id="regConfirmPwd" class="form-control" required placeholder="Re-enter password" autocomplete="new-password">
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-premium-primary w-100 rounded-pill btn-lg"><i class="fa-solid fa-user-plus me-2"></i>Create Account</button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <p class="text-muted small mb-0">Already have an account? <a href="/auth/login" class="text-primary">Sign in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/js/tom-select.complete.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const countrySelect = document.getElementById('countrySelect');
    const phoneCode = document.getElementById('phoneCode');
    const phoneInput = document.getElementById('phoneInput');

    const countryMap = {};
    countrySelect.querySelectorAll('option[value]').forEach(function(opt) {
        if (opt.value) {
            countryMap[opt.value] = {
                code: opt.getAttribute('data-code') || '+255',
                placeholder: opt.getAttribute('data-placeholder') || 'phone number'
            };
        }
    });

    const ts = new TomSelect(countrySelect, {
        maxItems: 1,
        searchField: ['text'],
        sortField: [{field: 'text', direction: 'asc'}],
        placeholder: 'Select your country',
        allowEmptyOption: false,
        onItemAdd: function(value) {
            const info = countryMap[value];
            if (info) {
                phoneCode.value = info.code;
                phoneInput.placeholder = info.placeholder;
            }
        },
        onItemRemove: function() {
            phoneCode.value = '+255';
            phoneInput.placeholder = '7XX XXX XXX';
        }
    });

    const pwd = document.getElementById('regPassword');
    const confirmPwd = document.getElementById('regConfirmPwd');
    const form = confirmPwd ? confirmPwd.closest('form') : null;
    if (form) {
        form.addEventListener('submit', function(e) {
            if (pwd && confirmPwd && pwd.value !== confirmPwd.value) {
                e.preventDefault();
                confirmPwd.setCustomValidity('Passwords do not match');
                confirmPwd.reportValidity();
            } else if (confirmPwd) {
                confirmPwd.setCustomValidity('');
            }
        });
        confirmPwd.addEventListener('input', function() {
            if (pwd && pwd.value === this.value) {
                this.setCustomValidity('');
            }
        });
    }
});
</script>

<%- include('../partials/footer') %>
