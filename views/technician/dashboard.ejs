<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>

            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-gauge-high me-2 text-primary"></i><%= t('technician:dashboard.heading') %></h2>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-box-open fa-2x text-primary mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.products %></h3>
                            <p class="text-muted small mb-0"><%= t('technician:dashboard.myProducts') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-wrench fa-2x text-warning mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.pendingRepairs %></h3>
                            <p class="text-muted small mb-0"><%= t('technician:dashboard.pendingRepairs') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-check-circle fa-2x text-success mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.totalRepairs %></h3>
                            <p class="text-muted small mb-0"><%= t('technician:dashboard.totalRepairs') %></p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-card p-4 text-center">
                            <i class="fa-solid fa-receipt fa-2x text-info mb-2"></i>
                            <h3 class="text-white fw-bold mb-0"><%= metrics.orders %></h3>
                            <p class="text-muted small mb-0"><%= t('technician:dashboard.productOrders') %></p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-wrench me-2 text-primary"></i><%= t('technician:dashboard.recentAssignedRepairs') %></h5>
                        <a href="/technician/repairs" class="btn btn-premium-outline btn-sm rounded-pill"><%= t('common:words.viewAll') %></a>
                    </div>
                    <% if (recentRepairs && recentRepairs.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th><%= t('technician:words.reference') %></th><th><%= t('technician:words.service') %></th><th><%= t('common:words.date') %></th><th><%= t('common:words.status') %></th></tr>
                            </thead>
                            <tbody>
                                <% recentRepairs.forEach(repair => { %>
                                <tr>
                                    <td class="text-white fw-bold"><%= repair.reference_number || 'N/A' %></td>
                                    <td class="text-muted"><%= repair.service_title || t('technician:words.general') %></td>
                                    <td class="text-muted"><%= repair.created_at ? new Date(repair.created_at).toLocaleDateString() : '' %></td>
                                    <td><span class="badge <%= repair.status === 'completed' ? 'bg-success' : (repair.status === 'pending' ? 'bg-warning text-dark' : 'bg-primary') %>"><%= t('technician:status.' + (repair.status||'').toLowerCase(), {defaultValue: repair.status}) %></span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-3">
                        <p class="text-muted mb-0"><i class="fa-solid fa-info-circle me-1"></i><%= t('technician:dashboard.noRepairsAssigned') %></p>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
