<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-wrench me-2 text-info"></i>Assigned Repairs</h2>

                <% if (repairs && repairs.length > 0) { %>
                <div class="glass-card no-lift p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th>Reference</th><th>Service</th><th>Customer</th><th>Device</th><th>Date</th><th>Status</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                <% repairs.forEach(repair => { %>
                                <tr>
                                    <td class="text-white fw-bold"><%= repair.reference_number || 'N/A' %></td>
                                    <td class="text-muted"><%= repair.service_title || 'General' %></td>
                                    <td class="text-muted"><%= repair.customer_name || 'Unknown' %></td>
                                    <td class="text-muted"><%= repair.device_type || '' %> <%= repair.device_brand || '' %></td>
                                    <td class="text-muted"><%= formatDate(repair.appointment_date) %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(repair.status) %>"><%= repair.status %></span></td>
                                    <td>
                                        <button type="button" class="btn btn-premium-outline btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#statusModal<%= repair.id %>">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <div class="modal fade" id="statusModal<%= repair.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-glass);">
                                                    <form method="POST" action="/technician/repairs/<%= repair.id %>/status">
                                                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                                        <div class="modal-header border-secondary">
                                                            <h5 class="text-white fw-bold">Update Status - <%= repair.reference_number %></h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Status</label>
                                                                <select name="status" class="form-select" required>
                                                                    <option value="pending" <%= repair.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                                    <option value="assigned" <%= repair.status === 'assigned' ? 'selected' : '' %>>Assigned</option>
                                                                    <option value="diagnosing" <%= repair.status === 'diagnosing' ? 'selected' : '' %>>Diagnosing</option>
                                                                    <option value="in_repair" <%= repair.status === 'in_repair' ? 'selected' : '' %>>In Repair</option>
                                                                    <option value="awaiting_parts" <%= repair.status === 'awaiting_parts' ? 'selected' : '' %>>Awaiting Parts</option>
                                                                    <option value="completed" <%= repair.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                                                    <option value="cancelled" <%= repair.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Technician Notes</label>
                                                                <textarea name="notes" class="form-control" rows="3" placeholder="Add notes about this repair..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-premium-outline rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-premium-primary rounded-pill">Update</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-wrench fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Assigned Repairs</h4>
                    <p class="text-muted">You have no repair requests assigned to you at this time.</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
