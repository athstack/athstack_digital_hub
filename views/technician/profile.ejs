<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-user me-2 text-info"></i><%= t('technician:profile.heading') %></h2>

                <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>
                <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                <% } %>

                <div class="glass-card no-lift p-4">
                    <form method="POST" action="/technician/profile" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="rounded-circle bg-info d-flex align-items-center justify-content-center" style="width:72px;height:72px;overflow:hidden;flex-shrink:0;">
                                        <% if (profile.avatar) { %>
                                        <img src="<%= imageUrl(profile.avatar, 'profiles') %>" alt="" style="width:100%;height:100%;object-fit:cover;">
                                        <% } else { %>
                                        <i class="fa-solid fa-microchip text-white fa-2x"></i>
                                        <% } %>
                                    </div>
                                    <div>
                                        <label class="form-label mb-1"><%= t('technician:profile.avatar') %></label>
                                        <input type="file" name="avatar" class="form-control form-control-sm" accept="image/*">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('technician:profile.firstName') %> *</label>
                                <input type="text" name="first_name" class="form-control" required value="<%= profile.first_name %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('technician:profile.lastName') %> *</label>
                                <input type="text" name="last_name" class="form-control" required value="<%= profile.last_name %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('technician:profile.email') %></label>
                                <input type="email" class="form-control" value="<%= profile.email %>" disabled>
                                <small class="text-muted"><%= t('technician:profile.emailHint') %></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('technician:profile.phone') %></label>
                                <input type="text" name="phone" class="form-control" value="<%= profile.phone || '' %>" placeholder="+255 7XX XXX XXX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('technician:profile.specialization') %></label>
                                <input type="text" name="specialization" class="form-control" value="<%= profile.specialization || '' %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label"><%= t('technician:profile.bio') %></label>
                                <textarea name="bio" class="form-control" rows="3" placeholder="<%= t('technician:profile.bioPlaceholder') %>"><%= profile.bio || '' %></textarea>
                            </div>
                        </div>

                        <hr class="border-secondary opacity-25 my-4">

                        <h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-lock me-2 text-info"></i><%= t('technician:profile.changePassword') %></h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:profile.currentPassword') %></label>
                                <input type="password" name="current_password" class="form-control" autocomplete="current-password">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:profile.newPassword') %></label>
                                <input type="password" name="new_password" class="form-control" autocomplete="new-password" minlength="8">
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <small class="text-muted"><%= t('technician:profile.passwordHint') %></small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-premium-primary rounded-pill px-4"><i class="fa-solid fa-save me-2"></i><%= t('technician:profile.save') %></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
