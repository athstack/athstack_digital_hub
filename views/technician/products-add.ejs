<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-plus-circle me-2 text-primary"></i><%= t('technician:productForm.headingAdd') %></h2>

                <div class="glass-card no-lift p-5">
                    <form method="POST" action="/technician/products/add" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label"><%= t('technician:productForm.name') %> *</label>
                                <input type="text" name="name" id="productName" class="form-control" required placeholder="<%= t('technician:productForm.namePlaceholder') %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.sku') %></label>
                                <div class="input-group">
                                    <input type="text" name="sku" id="productSku" class="form-control" placeholder="<%= t('technician:productForm.skuPlaceholder') %>">
                                    <button type="button" id="skuGenerateBtn" class="btn btn-premium-outline" title="<%= t('technician:productForm.generateSku') %>" aria-label="<%= t('technician:productForm.generateSku') %>"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label"><%= t('common:words.description') %></label>
                                <textarea name="description" class="form-control" rows="4" placeholder="<%= t('technician:productForm.descriptionPlaceholder') %>"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.price') %> *</label>
                                <input type="number" name="price" class="form-control" required min="0" step="0.01" placeholder="0.00">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.discountPrice') %></label>
                                <input type="number" name="discount_price" class="form-control" min="0" step="0.01" placeholder="0.00">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.stockQuantity') %></label>
                                <input type="number" name="stock_quantity" class="form-control" min="0" value="0">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('common:words.category') %> *</label>
                                <select name="category_id" id="productCategory" class="form-select" required>
                                    <option value=""><%= t('technician:productForm.selectCategory') %></option>
                                    <% if (typeof categories !== 'undefined' && categories) { categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>"><%= cat.name %></option>
                                    <% }) } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <%- include('../partials/fileUpload', {
                                    name: 'product_image',
                                    label: t('technician:productForm.productImage'),
                                    hint: t('admin:fileUpload.hint'),
                                    accept: 'image/*'
                                }) %>
                            </div>
                            <div class="col-12">
                                <%- include('../partials/fileUpload', {
                                    name: 'gallery_images',
                                    label: t('technician:productForm.galleryImages'),
                                    hint: t('admin:fileUpload.galleryHint'),
                                    accept: 'image/*',
                                    multiple: true
                                }) %>
                            </div>
                            <div class="col-12 text-center mt-3">
                                <button type="submit" class="btn btn-premium-primary rounded-pill px-5"><i class="fa-solid fa-save me-2"></i><%= t('technician:productForm.createProduct') %></button>
                                <a href="/technician/products" class="btn btn-premium-outline rounded-pill px-4 ms-2"><%= t('common:words.cancel') %></a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function() {
    var nameInput = document.getElementById('productName');
    var catSelect = document.getElementById('productCategory');
    var skuInput = document.getElementById('productSku');
    var genBtn = document.getElementById('skuGenerateBtn');
    if (!nameInput || !skuInput) return;

    var manual = skuInput.value.trim().length > 0;

    function catCode() {
        var text = catSelect && catSelect.selectedIndex >= 0 ? catSelect.options[catSelect.selectedIndex].text : '';
        var clean = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        return clean.slice(0, 3) || 'GEN';
    }

    function initials() {
        var words = nameInput.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().split(/[^A-Z0-9]+/).filter(Boolean);
        return words.map(function(w) { return w[0]; }).join('').slice(0, 4) || 'PRD';
    }

    function generate() {
        var suffix = String(Math.floor(1000 + Math.random() * 9000));
        return ['TB', catCode(), initials(), suffix].join('-');
    }

    function autoFill() {
        if (manual) return;
        skuInput.value = nameInput.value.trim() ? generate() : '';
    }

    nameInput.addEventListener('input', autoFill);
    if (catSelect) catSelect.addEventListener('change', autoFill);

    skuInput.addEventListener('input', function() {
        manual = skuInput.value.trim().length > 0;
    });

    if (genBtn) {
        genBtn.addEventListener('click', function(e) {
            e.preventDefault();
            manual = false;
            skuInput.value = generate();
        });
    }
})();
</script>

<%- include('../partials/footer') %>
