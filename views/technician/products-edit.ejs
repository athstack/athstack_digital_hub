<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <h2 class="text-white fw-bold mb-4"><i class="fa-solid fa-pen me-2 text-primary"></i><%= t('technician:productForm.headingEdit') %></h2>

                <% if (product) { %>
                <div class="glass-card no-lift p-5">
                    <form method="POST" action="/technician/products/edit/<%= product.id %>" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                        <input type="hidden" name="existing_image" value="<%= product.main_image || '' %>">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label"><%= t('technician:productForm.name') %> *</label>
                                <input type="text" name="name" class="form-control" required value="<%= product.name %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.sku') %></label>
                                <input type="text" name="sku" class="form-control" value="<%= product.sku || '' %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label"><%= t('common:words.description') %></label>
                                <textarea name="description" class="form-control" rows="4"><%= product.description || '' %></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.price') %> *</label>
                                <input type="number" name="price" class="form-control" required min="0" step="0.01" value="<%= product.price %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.discountPrice') %></label>
                                <input type="number" name="discount_price" class="form-control" min="0" step="0.01" value="<%= product.discount_price || '' %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><%= t('technician:productForm.stockQuantity') %></label>
                                <input type="number" name="stock_quantity" class="form-control" min="0" value="<%= product.stock_quantity || 0 %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><%= t('common:words.category') %> *</label>
                                <select name="category_id" class="form-select" required>
                                    <option value=""><%= t('technician:productForm.selectCategory') %></option>
                                    <% if (typeof categories !== 'undefined' && categories) { categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= product.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <%- include('../partials/fileUpload', {
                                    name: 'product_image',
                                    label: t('technician:productForm.newImageOptional'),
                                    hint: t('admin:fileUpload.hint'),
                                    accept: 'image/*',
                                    currentImage: product.main_image || null,
                                    currentFolder: 'products'
                                }) %>
                            </div>
                            <div class="col-12">
                                <%- include('../partials/fileUpload', {
                                    name: 'gallery_images',
                                    label: t('technician:productForm.galleryImages'),
                                    hint: t('admin:fileUpload.galleryHint'),
                                    accept: 'image/*',
                                    multiple: true
                                }) %>
                                <% if (typeof gallery !== 'undefined' && gallery && gallery.length > 0) { %>
                                <div class="file-upload-gallery">
                                    <% gallery.forEach(img => { %>
                                    <div class="file-upload-gallery-item">
                                        <img src="<%= imageUrl(img.image_path, 'products') %>" alt="<%= t('technician:productForm.galleryAlt') %>">
                                    </div>
                                    <% }) %>
                                </div>
                                <small class="text-muted"><%= t('technician:productForm.galleryReplaceHint') %></small>
                                <% } %>
                            </div>
                            <div class="col-12 text-center mt-3">
                                <button type="submit" class="btn btn-premium-primary rounded-pill px-5"><i class="fa-solid fa-save me-2"></i><%= t('technician:productForm.updateProduct') %></button>
                                <a href="/technician/products" class="btn btn-premium-outline rounded-pill px-4 ms-2"><%= t('common:words.cancel') %></a>
                            </div>
                        </div>
                    </form>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-exclamation-triangle fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold"><%= t('technician:productForm.productNotFound') %></h4>
                    <a href="/technician/products" class="btn btn-premium-primary rounded-pill"><%= t('technician:productForm.backToProducts') %></a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
