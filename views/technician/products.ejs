<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-box-open me-2 text-primary"></i>My Products</h2>
                    <a href="/technician/products/add" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i>Add Product</a>
                </div>

                <% if (products && products.length > 0) { %>
                <div class="glass-card no-lift p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr>
                            </thead>
                            <tbody>
                                <% products.forEach(product => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded bg-dark me-2 d-flex align-items-center justify-content-center" style="width:42px;height:42px;overflow:hidden;flex-shrink:0;">
                                                 <%- include('../partials/productImage', { src: product.main_image ? '/uploads/products/' + product.main_image : '', alt: product.name, style: 'max-height:38px;object-fit:contain;' }) %>
                                            </div>
                                            <span class="text-white fw-bold"><%= product.name %></span>
                                        </div>
                                    </td>
                                    <td class="text-muted"><%= product.category_name || 'N/A' %></td>
                                    <td class="text-primary fw-bold"><%= formatCurrency(product.price) %></td>
                                    <td class="text-muted"><%= product.stock_quantity %></td>
                                    <td><span class="badge <%= product.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= product.status %></span></td>
                                    <td>
                                        <a href="/technician/products/edit/<%= product.id %>" class="btn btn-premium-outline btn-sm rounded-pill me-1" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                        <form method="POST" action="/technician/products/delete/<%= product.id %>" class="d-inline" onsubmit="return confirm('Are you sure?')">
                                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Products Yet</h4>
                    <p class="text-muted">Start adding products to sell on the Athstack marketplace.</p>
                    <a href="/technician/products/add" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i>Add First Product</a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
