<%- include('../partials/header') %>

<section class="py-5">
    <div class="container">
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"><%= flashSuccess %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof flashError !== 'undefined' && flashError && flashError.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= flashError %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-3">
                <%- include('../partials/techSidebar') %>
            </div>
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-box-open me-2 text-primary"></i>My Products</h2>
                    <a href="/technician/products/add" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i>Add Product</a>
                </div>

                <% if (products && products.length > 0) { %>
                <div class="glass-card no-lift p-4">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0 products-table">
                            <thead>
                                <tr><th class="col-product">Product</th><th class="col-category">Category</th><th class="col-price">Price</th><th class="col-stock">Stock</th><th>Status</th><th class="col-actions">Actions</th></tr>
                            </thead>
                            <tbody>
                                <% products.forEach(product => { %>
                                <tr data-product-id="<%= product.id %>">
                                    <td class="col-product">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="col-thumb">
                                                 <%- include('../partials/productImage', { src: product.main_image ? imageUrl(product.main_image, 'products') : '', alt: product.name, style: 'max-height:44px;max-width:44px;object-fit:contain;' }) %>
                                            </div>
                                            <span class="text-white fw-bold col-product-name"><%= product.name %></span>
                                        </div>
                                    </td>
                                    <td class="col-category text-muted"><%= product.category_name || 'N/A' %></td>
                                    <td class="col-price text-primary"><%= formatCurrency(product.price) %></td>
                                    <td class="col-stock text-muted"><%= product.stock_quantity %></td>
                                    <td class="col-status">
                                        <button type="button"
                                            class="btn btn-sm rounded-pill status-toggle <%= product.status === 'active' ? 'btn-outline-success' : 'btn-outline-secondary' %>"
                                            data-id="<%= product.id %>"
                                            data-status="<%= product.status %>"
                                            title="<%= product.status === 'active' ? 'Click to deactivate' : 'Click to activate' %>">
                                            <i class="fa-solid fa-<%= product.status === 'active' ? 'toggle-on' : 'toggle-off' %>"></i>
                                            <span class="status-label"><%= product.status %></span>
                                        </button>
                                    </td>
                                    <td class="col-actions">
                                        <div class="d-flex gap-2 align-items-center">
                                            <a href="/technician/products/edit/<%= product.id %>" class="btn-product-action btn-product-action-edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                            <button type="button"
                                                class="btn-product-action btn-product-action-delete btn-delete-product"
                                                data-id="<%= product.id %>"
                                                data-name="<%= product.name %>"
                                                title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open fa-4x mb-3"></i>
                    <h4 class="text-white fw-bold">No Products Yet</h4>
                    <p class="text-muted">Start adding products to sell on the TechBridge marketplace.</p>
                    <a href="/technician/products/add" class="btn btn-premium-primary rounded-pill"><i class="fa-solid fa-plus me-2"></i>Add First Product</a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Delete Product</h5>
                <button type="button" class="modal-close" id="deleteModalClose">&times;</button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong class="text-white" id="deleteProductName"></strong>?</p>
                <p class="text-muted small mt-2 mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-premium-outline" id="deleteModalCancel">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteModalConfirm"><i class="fa-solid fa-trash me-1"></i>Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var modal = document.getElementById('deleteModal');
    var productNameEl = document.getElementById('deleteProductName');
    var confirmBtn = document.getElementById('deleteModalConfirm');
    var cancelBtn = document.getElementById('deleteModalCancel');
    var closeBtn = document.getElementById('deleteModalClose');
    var currentId = null;

    function showModal(name, id) {
        productNameEl.textContent = name;
        currentId = id;
        modal.style.display = 'flex';
    }

    function hideModal() {
        modal.style.display = 'none';
        currentId = null;
    }

    cancelBtn.addEventListener('click', hideModal);
    closeBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
        if (e.target === modal) hideModal();
    });

    document.querySelectorAll('.btn-delete-product').forEach(function(btn) {
        btn.addEventListener('click', function() {
            showModal(this.dataset.name, this.dataset.id);
        });
    });

    confirmBtn.addEventListener('click', function() {
        if (!currentId) return;
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Deleting...';

        fetch('/technician/products/delete/' + currentId, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var row = document.querySelector('tr[data-product-id="' + currentId + '"]');
                if (row) {
                    row.style.transition = 'opacity 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(function() { row.remove(); }, 300);
                }
                hideModal();
            } else {
                alert(data.message || 'Failed to delete product.');
            }
        })
        .catch(function() { alert('Network error. Please try again.'); })
        .finally(function() {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="fa-solid fa-trash me-1"></i>Delete';
        });
    });

    document.querySelectorAll('.status-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.dataset.id;
            var el = this;
            el.disabled = true;

            fetch('/technician/products/' + id + '/status', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    el.dataset.status = data.status;
                    el.title = data.status === 'active' ? 'Click to deactivate' : 'Click to activate';
                    el.className = 'btn btn-sm rounded-pill status-toggle ' + (data.status === 'active' ? 'btn-outline-success' : 'btn-outline-secondary');
                    el.querySelector('i').className = 'fa-solid fa-' + (data.status === 'active' ? 'toggle-on' : 'toggle-off');
                    el.querySelector('.status-label').textContent = data.status;
                } else {
                    alert(data.message || 'Failed to update status.');
                }
            })
            .catch(function() { alert('Network error. Please try again.'); })
            .finally(function() { el.disabled = false; });
        });
    });
})();
</script>

<%- include('../partials/footer') %>
