RewriteEngine On
RewriteBase /athstack_digital_hub/

# Prevent loops on existing assets/folders
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Pass the cleaned string explicitly to index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Enforce secure directory listings masking
Options -Indexes